index 0000000..b21bf55
--- /dev/null
+++ b/vehiclegpt/ingest/base.py
@@ -0,0 +1,138 @@
+"""Ingest contracts.
+
+Three types matter here:
+
+``RawRecord``    what an adapter emits, still in its native vocabulary
+``Sample``       a canonical value the rest of the system understands
+``VehicleDataSource``  the one interface every protocol adapter implements
+
+The protocol is deliberately **read-only and one-way**: ``stream()`` yields
+records and nothing else. There is no ``send``, no ``write``, no ``apply``. That
+is how design principle P5 ("read-only by construction", docs/04 §1) is enforced
+at the type level rather than by discipline — an adapter physically cannot
+command the vehicle, because the interface has no method that would let it.
+"""
+
+from __future__ import annotations
+
+import re
+from collections.abc import Iterator
+from dataclasses import dataclass, field
+from enum import StrEnum
+from typing import Protocol, runtime_checkable
+
+
+class Quality(StrEnum):
+    """Why a value might not be trustworthy."""
+
+    OK = "ok"
+    OUT_OF_BOUNDS = "out_of_bounds"   # outside the registry's physical limits
+    UNKNOWN_SIGNAL = "unknown_signal"  # decoded, but no canonical mapping
+
+
+@dataclass(frozen=True, slots=True)
+class RawRecord:
+    """One decoded-but-not-yet-canonical record.
+
+    ``payload`` maps the adapter's native signal name to a physical value. For
+    CAN this is a DBC message decode; for SOME/IP it would be a service event;
+    for replay it is a row from the source file.
+    """
+
+    ts_ns: int
+    source: str                 # adapter name, e.g. "can:tesla_can.dbc"
+    message: str                # native message name, e.g. "ESP_B"
+    payload: dict[str, float] = field(default_factory=dict)
+
+
+@dataclass(frozen=True, slots=True)
+class Sample:
+    """A canonical signal value, ready to store."""
+
+    ts_ns: int
+    path: str                   # canonical registry path, e.g. "vehicle.speed"
+    value: float
+    unit: str
+    quality: Quality = Quality.OK
+
+    @property
+    def is_ok(self) -> bool:
+        return self.quality is Quality.OK
+
+
+@runtime_checkable
+class VehicleDataSource(Protocol):
+    """Every protocol adapter implements this and nothing more."""
+
+    name: str
+
+    def open(self) -> None: ...
+
+    def stream(self) -> Iterator[RawRecord]: ...
+
+    def close(self) -> None: ...
+
+
+# ---------------------------------------------------------------------------
+# Normalisation
+# ---------------------------------------------------------------------------
+
+_SAFE_PATH = re.compile(r"^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)+$")
+
+
+class Normaliser:
+    """Maps ``RawRecord`` payloads onto canonical ``Sample`` objects.
+
+    Uses the registry's declared sources to build a
+    ``(message, native_signal) -> canonical_path`` table once, then applies
+    physical-bounds checking on every value.
+
+    Out-of-range values are **kept but flagged**, not silently dropped. A sensor
+    reporting 400 kph is evidence of a fault, and throwing that evidence away is
+    exactly the wrong thing to do in a diagnostic system.
+    """
+
+    def __init__(self, reg=None) -> None:
+        from vehiclegpt.schema.registry import registry as default_registry
+
+        self.registry = reg or default_registry()
+        self._map: dict[tuple[str, str], str] = {}
+        for spec in self.registry.signals.values():
+            if not _SAFE_PATH.match(spec.path):
+                raise ValueError(f"invalid canonical path {spec.path!r}")
+            for src in spec.sources:
+                key = (src.message, src.signal)
+                if key in self._map and self._map[key] != spec.path:
+                    raise ValueError(
+                        f"{key} maps to both {self._map[key]!r} and {spec.path!r}"
+                    )
+                self._map[key] = spec.path
+
+    @property
+    def mapping_size(self) -> int:
+        return len(self._map)
+
+    def messages(self) -> set[str]:
+        return {msg for msg, _ in self._map}
+
+    def normalise(self, record: RawRecord) -> list[Sample]:
+        out: list[Sample] = []
+        for native_signal, value in record.payload.items():
+            path = self._map.get((record.message, native_signal))
+            if path is None:
+                # Decoded but unmapped: normal for DBC fields we do not yet
+                # care about. Not an error, and deliberately not logged per
+                # frame - that would flood a vehicle's log.
+                continue
+            spec = self.registry[path]
+            quality = Quality.OK if spec.in_bounds(value) else Quality.OUT_OF_BOUNDS
+            out.append(
+                Sample(
+                    ts_ns=record.ts_ns,
+                    path=path,
+                    value=float(value),
+                    unit=spec.unit,
+                    quality=quality,
+                )
+            )
+        return out
diff --git a/vehiclegpt/ingest/can_source.py b/vehiclegpt/ingest/can_source.py
new file mode 100644
index 0000000..8f12583
--- /dev/null
+++ b/vehiclegpt/ingest/can_source.py
@@ -0,0 +1,186 @@
+"""CAN / CAN-FD ingest adapter.
+
+Decodes real CAN frames against real DBT files using ``cantools``, on top of
+``python-can``. The *same code path* runs against:
+
+* ``interface="socketcan", channel="vcan0"``  - virtual bus on Linux (demo)
+* ``interface="socketcan", channel="can0"``   - a real USB-CAN adapter
+* ``interface="virtual",   channel="...``     - in-process bus (CI, no kernel
+  support needed)
+
+Only the transport differs. Frame layout, bit packing, byte order, scaling and
+DBC lookup are identical in all three, which is what makes the demo credible:
+the bus is real, the DBC is real, the frames are real.
+
+See ``vehiclegpt/dbc/README.md`` for what is genuine and what is synthetic.
+"""
+
+from __future__ import annotations
+
+import time
+from collections.abc import Iterable, Iterator
+from pathlib import Path
+
+import can
+import cantools
+from cantools.database.can.database import Database
+
+from vehiclegpt.ingest.base import RawRecord
+from vehiclegpt.schema.registry import DBC_DIR, Registry
+from vehiclegpt.schema.registry import registry as default_registry
+
+
+class CanSourceError(RuntimeError):
+    pass
+
+
+class CanSource:
+    """Reads CAN frames and yields decoded ``RawRecord`` objects.
+
+    Never transmits. The bus is opened in receive-only mode, which on SocketCAN
+    also blocks accidental TX at the kernel level.
+    """
+
+    def __init__(
+        self,
+        interface: str = "virtual",
+        channel: str = "vehiclegpt",
+        dbc_files: Iterable[str] | None = None,
+        bus: can.BusABC | None = None,
+        receive_own_messages: bool = False,
+        reg: Registry | None = None,
+    ) -> None:
+        self.name = f"can:{interface}:{channel}"
+        self._reg = reg or default_registry()
+        self._interface = interface
+        self._channel = channel
+        self._receive_own = receive_own_messages
+        self._bus = bus
+        self._own_bus = bus is None
+
+        files = list(dbc_files) if dbc_files else sorted(self._reg.dbc_files())
+        self._databases: list[Database] = [
+            cantools.database.load_file(DBC_DIR / f) for f in files
+        ]
+
+        # arbitration_id -> (message, db). Collisions across DBCs are a real
+        # hazard: two databases can legitimately define the same frame ID, and
+        # silently picking one would produce confidently wrong data.
+        self._by_id: dict[int, tuple[object, str]] = {}
+        for db, fname in zip(self._databases, files, strict=True):
+            for msg in db.messages:
+                if msg.frame_id in self._by_id:
+                    other = self._by_id[msg.frame_id][1]
+                    raise CanSourceError(
+                        f"frame id 0x{msg.frame_id:03X} defined in both "
+                        f"{other} and {fname} - refusing to guess"
+                    )
+                self._by_id[msg.frame_id] = (msg, fname)
+
+        self._dbcs = dict(zip(files, self._databases, strict=True))
+        self._unknown_ids: set[int] = set()
+        self._decoded = 0
+        self._undecodable = 0
+
+    # -- lifecycle ----------------------------------------------------------
+
+    def open(self) -> None:
+        if self._bus is not None:
+            return
+        try:
+            self._bus = can.Bus(
+                interface=self._interface,
+                channel=self._channel,
+                receive_own_messages=self._receive_own,
+            )
+        except Exception as exc:  # noqa: BLE001 - re-raise with context
+            raise CanSourceError(
+                f"could not open CAN bus {self._interface}:{self._channel}: {exc}. "
+                "On Linux with no hardware, create a virtual bus first:\n"
+                "  sudo modprobe vcan && sudo ip link add dev vcan0 type vcan "
+                "&& sudo ip link set up vcan0\n"
+                "For CI with no kernel support, use interface='virtual'."
+            ) from exc
+
+    def close(self) -> None:
+        if self._bus is not None and self._own_bus:
+            self._bus.shutdown()
+        if self._own_bus:
+            self._bus = None
+
+    def __enter__(self) -> CanSource:
+        self.open()
+        return self
+
+    def __exit__(self, *exc: object) -> None:
+        self.close()
+
+    # -- streaming ----------------------------------------------------------
+
+    def stream(self, timeout: float | None = None, limit: int | None = None
+               ) -> Iterator[RawRecord]:
+        """Yield decoded records until ``timeout`` elapses or ``limit`` is hit.
+
+        A ``None`` timeout blocks forever, which is what a vehicle does.
+        """
+        if self._bus is None:
+            raise CanSourceError("open() must be called before stream()")
+
+        deadline = None if timeout is None else time.monotonic() + timeout
+        emitted = 0
+
+        while True:
+            remaining = None if deadline is None else max(0.0, deadline - time.monotonic())
+            if remaining is not None and remaining <= 0:
+                return
+            frame = self._bus.recv(timeout=remaining if remaining is not None else 0.1)
+            if frame is None:
+                if deadline is None:
+                    continue
+                return
+
+            record = self._decode(frame)
+            if record is not None:
+                yield record
+                emitted += 1
+                if limit is not None and emitted >= limit:
+                    return
+
+    def _decode(self, frame: can.Message) -> RawRecord | None:
+        entry = self._by_id.get(frame.arbitration_id)
+        if entry is None:
+            self._unknown_ids.add(frame.arbitration_id)
+            return None
+        message, dbc_name = entry
+
+        try:
+            decoded = message.decode(frame.data, decode_choices=False)
+        except Exception:  # noqa: BLE001 - a bad frame must not kill the stream
+            self._undecodable += 1
+            return None
+
+        self._decoded += 1
+        return RawRecord(
+            ts_ns=int(frame.timestamp * 1e9) if frame.timestamp else time.time_ns(),
+            source=f"can:{dbc_name}",
+            message=message.name,
+            payload={k: float(v) for k, v in decoded.items() if v is not None},
+        )
+
+    # -- diagnostics --------------------------------------------------------
+
+    @property
+    def stats(self) -> dict[str, object]:
+        return {
+            "decoded": self._decoded,
+            "undecodable": self._undecodable,
+            "unknown_ids": sorted(f"0x{i:03X}" for i in self._unknown_ids),
+            "messages_known": len(self._by_id),
+        }
+
+    def message_names(self) -> set[str]:
+        return {m.name for m, _ in self._by_id.values()}
+
+
+def dbc_path(name: str) -> Path:
+    return DBC_DIR / name
