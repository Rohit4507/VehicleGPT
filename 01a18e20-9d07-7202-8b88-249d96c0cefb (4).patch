+import pytest
+
+pytest.importorskip("yaml", reason="PyYAML not installed")
+
+import sys  # noqa: E402
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "tools" / "phase0"))
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "tools"))
