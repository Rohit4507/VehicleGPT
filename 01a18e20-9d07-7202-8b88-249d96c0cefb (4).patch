+"""Registry validation.
+
+The registry is the contract every downstream layer trusts. A typo must fail at
+load time with a message that names the offending entry, never at 3 a.m. in a
+vehicle - so these tests pin the error behaviour, not just the happy path.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+pytest.importorskip("yaml", reason="PyYAML not installed")
+
+import yaml  # noqa: E402
+
+from vehiclegpt.schema.registry import (
+    RegistryError,
+    Tier,
+    load_registry,
+    registry,
+)
+
+MINIMAL = {
+    "version": 1,
+    "vehicle": {"model": "test"},
+    "signals": [{
+        "path": "vehicle.speed", "unit": "kph", "min": 0, "max": 250,
+        "rate_hz": 10, "tier": "hot", "deadband": 0.1,
+        "description": "d",
+        "sources": [{"dbc": "tesla_can.dbc", "message": "ESP_B",
+                     "signal": "ESP_vehicleSpeed"}],
+    }],
+}
+
+
+def _write(tmp_path, data):
+    p = tmp_path / "signals.yaml"
+    p.write_text(yaml.safe_dump(data), encoding="utf-8")
+    return p
+
+
+def test_loads_minimal(tmp_path):
+    reg = load_registry(_write(tmp_path, MINIMAL))
+    assert len(reg) == 1
+    assert reg["vehicle.speed"].tier is Tier.HOT
+    assert "vehicle.speed" in reg
+
+
+def test_duplicate_path_is_rejected(tmp_path):
+    data = {**MINIMAL, "signals": MINIMAL["signals"] * 2}
+    with pytest.raises(RegistryError, match="duplicate signal path"):
+        load_registry(_write(tmp_path, data))
+
+
+def test_bad_tier_is_rejected(tmp_path):
+    bad = {**MINIMAL, "signals": [{**MINIMAL["signals"][0], "tier": "lukewarm"}]}
+    with pytest.raises(RegistryError, match="invalid tier"):
+        load_registry(_write(tmp_path, bad))
+
+
+def test_inverted_bounds_are_rejected(tmp_path):
+    bad = {**MINIMAL, "signals": [{**MINIMAL["signals"][0], "min": 10, "max": 5}]}
+    with pytest.raises(RegistryError, match="min .* must be < max"):
+        load_registry(_write(tmp_path, bad))
+
+
+def test_missing_dbc_is_rejected(tmp_path):
+    bad = {**MINIMAL, "signals": [{
+        **MINIMAL["signals"][0],
+        "sources": [{"dbc": "nope.dbc", "message": "M", "signal": "S"}],
+    }]}
+    with pytest.raises(RegistryError, match="references missing DBC"):
+        load_registry(_write(tmp_path, bad))
+
+
+def test_missing_key_is_named(tmp_path):
+    broken = {**MINIMAL, "signals": [{"path": "vehicle.speed"}]}
+    with pytest.raises(RegistryError, match="missing field 'tier'"):
+        load_registry(_write(tmp_path, broken))
+
+
+def test_unknown_path_error_is_helpful():
+    with pytest.raises(RegistryError, match="known paths:"):
+        registry()["vehicle.flux_capacitance"]
+
+
+def test_real_registry_shape():
+    reg = registry()
+    assert len(reg) >= 20, "expected a substantial signal set"
+    assert reg.dbc_files() == {"tesla_can.dbc", "vehiclegpt_vendor_ext.dbc"}
+    # tiers actually used
+    assert reg.by_tier(Tier.HOT), "no hot signals - retention model is unused"
+    assert reg.by_tier(Tier.SLOW), "no slow signals - retention model is unused"
+
+
+def test_every_source_message_is_unique_across_dbcs():
+    """Two DBCs defining the same message name would make normalisation ambiguous."""
+    import cantools
+
+    from vehiclegpt.schema.registry import DBC_DIR
+
+    owners: dict[str, str] = {}
+    for name in registry().dbc_files():
+        for msg in cantools.database.load_file(DBC_DIR / name).messages:
+            assert msg.name not in owners, (
+                f"message {msg.name} appears in {owners[msg.name]} and {name}")
+            owners[msg.name] = name
diff --git a/tests/test_retrieval.py b/tests/test_retrieval.py
new file mode 100644
index 0000000..98cf957
--- /dev/null
+++ b/tests/test_retrieval.py
@@ -0,0 +1,184 @@
+"""Retrieval tests: FTS query safety, ranking, and rank fusion.
+
+**No recall@8 number is asserted here, and none is claimed in the docs.** With
+three cards on the shipped store, recall@8 is 1.0 for any query that matches
+anything, which measures the corpus, not the retriever. What is tested is that
+the mechanism ranks correctly on a synthetic corpus and that free text cannot
+become FTS5 syntax.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from vehiclegpt.analytics import retrieval
+from vehiclegpt.store import db
+
+CARDS = [
+    ("incident", "2026-03-11", "critical",
+     "Overheating incident", "The coolant pump stopped and pack temperature climbed."),
+    ("incident", "2026-03-15", "info",
+     "ADAS disengagement sequence", "Adaptive cruise disengaged three times in seven minutes."),
+    ("trend", "2026-03-12", "warning",
+     "Consumption rose", "Energy per kilometre rose after the cold front arrived."),
+    ("incident", "2026-03-09", "warning",
+     "Tyre pressure warning", "Rear left tyre pressure fell below the threshold."),
+    ("incident", "2026-03-04", "info",
+     "Charging session interrupted", "The charge port latch released early."),
+]
+
+
+@pytest.fixture
+def store(tmp_path):
+    conn = db.connect(tmp_path / "r.db")
+    conn.executemany(
+        "INSERT INTO card (kind, start_ns, end_ns, day, severity, title, body, signals, "
+        "evidence) VALUES (?,?,?,?,?,?,?,?,?)",
+        [(kind, 1, 2, day, sev, title, body, "", "[]")
+         for kind, day, sev, title, body in CARDS])
+    conn.execute("INSERT INTO card_fts(card_fts) VALUES('rebuild')")
+    conn.commit()
+    yield conn
+    conn.close()
+
+
+class TestFtsQuery:
+    def test_tokens_are_quoted(self):
+        assert retrieval.fts_query("pump stopped") == '"pump" OR "stopped"'
+
+    def test_stopwords_are_dropped(self):
+        assert retrieval.fts_query("when did the pump stop") == '"pump" OR "stop"'
+
+    def test_a_query_of_only_stopwords_expands_to_nothing(self):
+        assert retrieval.fts_query("what was it that they did") == ""
+
+    @pytest.mark.parametrize("hostile", [
+        'NEAR(pump temp, 5)',
+        'pump*',
+        '"unbalanced quote',
+        'a OR b AND c',
+        'title:secret',
+        'pump NOT engine',
+        '^start',
+        '{}[]()',
+    ])
+    def test_fts_operators_cannot_survive_as_operators(self, hostile):
+        """Free text must not be able to express FTS5 syntax."""
+        expanded = retrieval.fts_query(hostile)
+        if not expanded:
+            return
+        # Every token is inside double quotes, so none can act as an operator.
+        stripped = expanded.replace(" OR ", "")
+        assert stripped.startswith('"') and stripped.endswith('"')
+        assert stripped.count('"') % 2 == 0
+
+    def test_a_quote_in_the_input_never_reaches_the_expression(self):
+        """The tokeniser cannot emit a quote, so quoting cannot be broken out of."""
+        for hostile in ['pu"mp', 'pu""mp', '"', 'a"b"c']:
+            expanded = retrieval.fts_query(hostile)
+            if not expanded:
+                continue
+            for piece in expanded.split(" OR "):
+                assert piece.startswith('"') and piece.endswith('"')
+                assert piece.count('"') == 2, f"unbalanced quoting in {piece!r}"
+
+    def test_an_apostrophe_inside_a_word_is_preserved_safely(self):
+        expanded = retrieval.fts_query("pump's stall")
+        assert expanded == '"pump\'s" OR "stall"'
+
+    def test_empty_and_punctuation_only(self):
+        assert retrieval.fts_query("") == ""
+        assert retrieval.fts_query("?!,.") == ""
+
+    def test_a_hostile_query_is_executable_rather_than_fatal(self, store):
+        for hostile in ('NEAR(pump temp, 5)', 'pump*', '"unbalanced', 'a OR b AND c'):
+            retrieval.search(store, hostile)      # must not raise
+
+
+class TestSearch:
+    def test_the_right_card_ranks_first(self, store):
+        hits = retrieval.search(store, "coolant pump temperature")
+        assert hits and hits[0]["title"] == "Overheating incident"
+
+    def test_paraphrase_matches_through_stemming(self, store):
+        """'disengaged' should find 'disengagement' via the porter stemmer."""
+        hits = retrieval.search(store, "why did it disengage")
+        assert hits and "ADAS" in hits[0]["title"]
+
+    def test_no_match_returns_empty_rather_than_a_near_miss(self, store):
+        assert retrieval.search(store, "windscreen washer fluid") == []
+
+    def test_kind_filter(self, store):
+        hits = retrieval.search(store, "consumption", kind="trend")
+        assert [h["kind"] for h in hits] == ["trend"]
+
+    def test_limit_is_respected(self, store):
+        assert len(retrieval.search(store, "pressure temperature charge", limit=2)) <= 2
+
+    def test_evidence_is_decoded_for_the_caller(self, store):
+        hits = retrieval.search(store, "coolant")
+        assert isinstance(hits[0]["evidence"], list)
+
+    def test_rank_is_returned_negative_better(self, store):
+        hits = retrieval.search(store, "coolant pump")
+        assert hits[0]["rank"] <= hits[-1]["rank"]
+
+
+class TestRankFusion:
+    def test_combines_two_rankings(self):
+        fused = retrieval.reciprocal_rank_fusion([1, 2, 3], [3, 1, 9])
+        assert set(fused) == {1, 2, 3, 9}
+
+    def test_a_document_high_in_both_wins(self):
+        fused = retrieval.reciprocal_rank_fusion([1, 2, 3], [1, 9, 8])
+        assert fused[0] == 1
+
+    def test_duplicate_within_one_ranking_is_counted_once(self):
+        fused = retrieval.reciprocal_rank_fusion([1, 1, 1], [])
+        assert fused == [1]
+
+    def test_limit_applies(self):
+        assert len(retrieval.reciprocal_rank_fusion(list(range(50)), list(range(50)), limit=3)) == 3
+
+    def test_empty_input(self):
+        assert retrieval.reciprocal_rank_fusion() == []
+
+    def test_k_damps_the_head(self):
+        """A smaller k makes the top rank dominate more."""
+        small = retrieval.reciprocal_rank_fusion([1, 2, 3], [3, 2, 1], k=1)
+        assert small[0] == 1
+
+
+class TestBuildCards:
+    """build_cards distils from `event`; it does not preserve hand-inserted rows."""
+
+    @pytest.fixture
+    def events(self, tmp_path):
+        conn = db.connect(tmp_path / "e.db")
+        conn.executemany(
+            "INSERT INTO event (ts_ns, kind, severity, message) VALUES (?,?,?,?)",
+            [(1_772_400_000 * 10**9, "adas.disengagement", "info", "ADAS disengaged"),
+             (1_772_400_400 * 10**9, "adas.disengagement", "info", "ADAS disengaged"),
+             (1_772_500_000 * 10**9, "fault.adas_disengagement", "info", "injected")])
+        conn.commit()
+        yield conn
+        conn.close()
+
+    def test_rebuild_is_deterministic_and_does_not_duplicate(self, events):
+        first = retrieval.build_cards(events)
+        snapshot = [dict(r) for r in events.execute("SELECT id, title, body FROM card ORDER BY id")]
+        second = retrieval.build_cards(events)
+        assert first == second
+        assert snapshot == [dict(r) for r in
+                            events.execute("SELECT id, title, body FROM card ORDER BY id")]
+
+    def test_harness_faults_never_become_cards(self, events):
+        retrieval.build_cards(events)
+        bodies = [r["body"] for r in events.execute("SELECT body FROM card")]
+        assert bodies, "the real events should produce a card"
+        assert all("injected" not in b for b in bodies)
+
+    def test_cards_are_searchable_after_a_rebuild(self, events):
+        retrieval.build_cards(events)
+        assert any("adas" in h["title"].lower()
+                   for h in retrieval.search(events, "disengagement"))
diff --git a/tests/test_scenario.py b/tests/test_scenario.py
new file mode 100644
index 0000000..ccea5c3
--- /dev/null
+++ b/tests/test_scenario.py
@@ -0,0 +1,175 @@
+"""Scenario semantics.
+
+The simulator is only useful if it produces the phenomena the demo later claims
+to explain. These tests assert the *causal stories*, not just that numbers
+exist - most importantly that the coolant pump fails **before** the overheat
+warning fires, because "what happened before the warning?" is a question we must
+be able to answer correctly before we can ask a model to answer it.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+pytest.importorskip("numpy", reason="numpy not installed")
+pytest.importorskip("yaml", reason="PyYAML not installed")
+
+from pathlib import Path
+
+import numpy as np  # noqa: E402
+
+from sim.generator import OVERHEAT_WARN_C, RATE_HZ, generate
+from sim.scenario import FaultKind, Mode, load_scenario, scenario_from_dict
+
+SCENARIO_DIR = Path(__file__).resolve().parents[1] / "sim" / "scenarios"
+SCENARIOS = ["city_highway_week", "battery_overheat", "range_degradation",
+             "adas_disengagement"]
+
+
+def scenario(name: str):
+    """Load by name, independent of the working directory."""
+    return load_scenario(SCENARIO_DIR / f"{name}.yaml")
+
+
+@pytest.fixture(scope="module")
+def sims():
+    return {name: generate(scenario(name)) for name in SCENARIOS}
+
+
+def test_all_scenarios_generate(sims):
+    for name, sim in sims.items():
+        assert sim.n == int(round(sim.scenario.duration_s * RATE_HZ))
+        assert sim.t_s.shape == (sim.n,)
+        assert sim.truth, f"{name}: no signals produced"
+        for path, arr in sim.truth.items():
+            assert arr.shape == (sim.n,), f"{name}/{path}: wrong length {arr.shape}"
+            assert np.isfinite(arr).all(), f"{name}/{path}: non-finite values"
+
+
+def test_generation_is_deterministic():
+    """Same scenario, same seed, same bytes - or the demo is not repeatable."""
+    sc = scenario("battery_overheat")
+    a, b = generate(sc), generate(sc)
+    for path in a.truth:
+        np.testing.assert_array_equal(a.truth[path], b.truth[path],
+                                      err_msg=f"{path} is not reproducible")
+    assert [e.ts_s for e in a.events] == [e.ts_s for e in b.events]
+
+
+def test_seed_changes_output():
+    sc = scenario("battery_overheat")
+    other = scenario_from_dict({**{
+        "name": sc.name, "ambient_c": sc.ambient_c,
+        "initial_soc": sc.initial_soc, "segments": [
+            {"mode": s.mode.value, "duration_s": s.duration_s} for s in sc.segments],
+        "faults": [],
+    }, "seed": sc.seed + 1})
+    a, b = generate(sc), generate(other)
+    assert not np.array_equal(a.truth["vehicle.speed"], b.truth["vehicle.speed"])
+
+
+def test_modes_follow_the_script(sims):
+    sim = sims["city_highway_week"]
+    modes = sim.modes
+    for start, end, mode in sim.scenario.segment_bounds():
+        lo, hi = int(start * RATE_HZ), min(int(end * RATE_HZ), sim.n)
+        assert set(modes[lo:hi]) == {mode.value}, (
+            f"segment {start}-{end}s should be {mode.value}")
+
+
+def test_highway_is_faster_than_city(sims):
+    sim = sims["city_highway_week"]
+    speed = sim.truth["vehicle.speed"]
+    city = speed[sim.modes == Mode.CITY.value]
+    highway = speed[sim.modes == Mode.HIGHWAY.value]
+    assert highway.mean() > city.mean(), (
+        f"highway mean {highway.mean():.1f} should exceed city {city.mean():.1f}")
+    assert highway.mean() > 60.0
+
+
+def test_pump_fails_before_the_overheat_warning(sims):
+    """The causal claim behind Q4: a pump failure precedes the warning.
+
+    If this ever stops holding, the demo is answering a question with a story
+    that did not happen.
+    """
+    sim = sims["battery_overheat"]
+    pump = sim.truth["thermal.coolant_pump"]
+    temp = sim.truth["battery.cell_temp_max"]
+    t = sim.t_s
+
+    assert temp.max() >= OVERHEAT_WARN_C, (
+        f"scenario never crosses the warning threshold (max {temp.max():.1f} C)")
+
+    pump_dead = np.flatnonzero(pump == 0.0)
+    # ignore the first seconds while the vehicle is stationary at t=0
+    pump_dead = pump_dead[t[pump_dead] > 30.0]
+    assert pump_dead.size, "pump never actually stops"
+
+    warn = np.flatnonzero(temp >= OVERHEAT_WARN_C)[0]
+    assert pump_dead[0] < warn, (
+        f"pump stopped at tick {pump_dead[0]} but the warning fired at {warn}; "
+        "the precursor must come first")
+    lead = (warn - pump_dead[0]) / RATE_HZ
+    assert lead > 60.0, f"only {lead:.1f} s between pump failure and warning"
+
+
+def test_overheat_warning_is_a_registered_event(sims):
+    sim = sims["battery_overheat"]
+    kinds = {e.kind for e in sim.events}
+    assert "battery.overheat_warning" in kinds
+    assert "battery.overheat_critical" in kinds
+    warn = next(e for e in sim.events if e.kind == "battery.overheat_warning")
+    flag = sim.truth["battery.overheat_warning"]
+    first_on = sim.t_s[np.flatnonzero(flag > 0)[0]]
+    assert warn.ts_s == pytest.approx(first_on, abs=0.2)
+
+
+def test_baseline_never_overheats(sims):
+    sim = sims["city_highway_week"]
+    assert sim.truth["battery.cell_temp_max"].max() < OVERHEAT_WARN_C
+    assert not sim.truth["battery.overheat_warning"].any()
+
+
+def test_adas_disengagements_are_detectable(sims):
+    """Q3 needs falling edges in the signal, not just an event log."""
+    sim = sims["adas_disengagement"]
+    adas = sim.truth["adas.state"]
+    edges = np.flatnonzero((adas[:-1] > 0) & (adas[1:] == 0))
+    injected = sim.scenario.faults_of(FaultKind.ADAS_DISENGAGEMENT)
+    assert len(edges) == len(injected) == 4
+    logged = [e for e in sim.events if e.kind == "adas.disengagement"]
+    assert len(logged) == 4
+    for ev, tick in zip(logged, edges, strict=True):
+        assert ev.ts_s == pytest.approx(sim.t_s[tick], abs=0.2)
+
+
+def test_cold_weather_increases_consumption(sims):
+    """Q1/Q2 need a real, measurable efficiency difference to explain."""
+    cold = sims["range_degradation"].truth["energy.per_km"]
+    mild = sims["city_highway_week"].truth["energy.per_km"]
+    moving_cold = cold[cold > 0]
+    moving_mild = mild[mild > 0]
+    assert moving_cold.mean() > moving_mild.mean() * 1.05, (
+        f"cold-weather consumption {moving_cold.mean():.1f} Wh/km is not "
+        f"meaningfully above mild {moving_mild.mean():.1f} Wh/km")
+
+
+def test_soc_decreases_and_stays_valid(sims):
+    for name, sim in sims.items():
+        soc = sim.truth["battery.soc"]
+        assert soc.min() >= 0.0 and soc.max() <= 100.0, f"{name}: SOC out of range"
+        net_drop = soc[0] - soc[-1]
+        assert net_drop > 0, f"{name}: SOC did not decrease over the drive"
+
+
+def test_scenario_validation_rejects_nonsense():
+    from sim.scenario import Scenario, Segment
+
+    with pytest.raises(ValueError):
+        Scenario(name="x", seed=1, ambient_c=20, initial_soc=50, segments=())
+    with pytest.raises(ValueError):
+        Scenario(name="x", seed=1, ambient_c=20, initial_soc=150,
+                 segments=(Segment(Mode.CITY, 10),))
+    with pytest.raises(ValueError):
+        Segment(Mode.CITY, 0)
diff --git a/tests/test_store.py b/tests/test_store.py
new file mode 100644
index 0000000..fe0a56e
--- /dev/null
+++ b/tests/test_store.py
@@ -0,0 +1,186 @@
+"""Store and segmentation tests.
+
+The segmentation bug these guard against was not subtle: the first version
+integrated distance across the 23-hour gap between drives, producing a 415 km
+"commute" and negative consumption. Both are physically impossible and neither
+raised an error, so only an assertion catches it.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+pytest.importorskip("numpy", reason="numpy not installed")
+pytest.importorskip("yaml", reason="PyYAML not installed")
+
+import sqlite3  # noqa: E402
+from pathlib import Path  # noqa: E402
+
+from vehiclegpt.store import db  # noqa: E402
+
+DAY_NS = 86_400 * 10**9
+HOUR_NS = 3_600 * 10**9
+BASE = 1_772_000_000 * 10**9   # arbitrary fixed epoch
+
+
+def make_store(tmp_path: Path) -> sqlite3.Connection:
+    return db.connect(tmp_path / "t.db")
+
+
+def add(conn, path, values, start_ns, step_ns=10**9, unit="x", tier="hot"):
+    ids = db.ensure_signals(conn, [(path, unit, tier)])
+    rows = [db.SampleRow(ts_ns=start_ns + i * step_ns, path=path, value=float(v))
+            for i, v in enumerate(values)]
+    db.write_samples(conn, rows, ids)
+
+
+def synth_drive(conn, start_ns: int, kph: float, seconds: int,
+                current_a: float = 40.0, voltage_v: float = 390.0):
+    add(conn, "vehicle.speed", [kph] * seconds, start_ns)
+    add(conn, "battery.pack_current", [current_a] * seconds, start_ns)
+    add(conn, "battery.pack_voltage", [voltage_v] * seconds, start_ns)
+
+
+class TestSchema:
+    def test_tables_created(self, tmp_path):
+        conn = make_store(tmp_path)
+        names = {r["name"] for r in conn.execute(
+            "SELECT name FROM sqlite_master WHERE type='table'")}
+        assert {"signal", "sample", "event", "drive", "segment", "daily", "meta"} <= names
+
+    def test_reconnect_keeps_data(self, tmp_path):
+        path = tmp_path / "t.db"
+        conn = db.connect(path)
+        add(conn, "vehicle.speed", [10, 20], BASE)
+        conn.commit()
+        conn.close()
+        again = db.connect(path)
+        assert again.execute("SELECT COUNT(*) AS n FROM sample").fetchone()["n"] == 2
+
+
+class TestWriting:
+    def test_unknown_signal_is_skipped_not_invented(self, tmp_path):
+        conn = make_store(tmp_path)
+        db.ensure_signals(conn, [("vehicle.speed", "kph", "hot")])
+        ids = {r["path"]: r["id"] for r in conn.execute("SELECT id, path FROM signal")}
+        n = db.write_samples(conn, [
+            db.SampleRow(ts_ns=BASE, path="vehicle.speed", value=5.0),
+            db.SampleRow(ts_ns=BASE, path="vehicle.sparkle", value=1.0),
+        ], ids)
+        assert n == 1
+        assert conn.execute("SELECT COUNT(*) AS n FROM sample").fetchone()["n"] == 1
+
+    def test_events_round_trip(self, tmp_path):
+        conn = make_store(tmp_path)
+        db.write_events(conn, [db.EventRow(BASE, "adas.disengagement", "info", "x")])
+        assert conn.execute("SELECT COUNT(*) AS n FROM event").fetchone()["n"] == 1
+
+
+class TestRegimeClassification:
+    @pytest.mark.parametrize("kph,expected", [
+        (0.0, "idle"), (4.9, "idle"), (5.0, "city"), (30.0, "city"),
+        (79.9, "city"), (80.0, "highway"), (130.0, "highway"),
+    ])
+    def test_thresholds(self, kph, expected):
+        assert db.classify_regime(kph) == expected
+
+
+class TestSegmentation:
+    def test_does_not_integrate_across_a_gap(self, tmp_path):
+        """The regression: two drives a day apart must stay two drives."""
+        conn = make_store(tmp_path)
+        synth_drive(conn, BASE, kph=100.0, seconds=600)          # 10 min
+        synth_drive(conn, BASE + DAY_NS, kph=100.0, seconds=600)  # next day
+        db.rebuild(conn)
+
+        drives = conn.execute("SELECT COUNT(*) AS n FROM drive").fetchone()["n"]
+        assert drives == 2, "a day-long silence should split the drives"
+
+        for row in conn.execute("SELECT distance_km FROM segment"):
+            # 100 kph for 10 minutes is 16.7 km. Anything vastly larger means
+            # distance was integrated across the parked gap.
+            assert 15.0 < row["distance_km"] < 18.0, row["distance_km"]
+
+    def test_energy_is_positive_and_physical(self, tmp_path):
+        conn = make_store(tmp_path)
+        synth_drive(conn, BASE, kph=100.0, seconds=600)
+        db.rebuild(conn)
+        row = conn.execute("SELECT distance_km, energy_wh FROM segment").fetchone()
+        # 390 V * 40 A = 15.6 kW for 10 min = 2.6 kWh.
+        assert row["energy_wh"] == pytest.approx(2600, rel=0.02)
+        assert row["energy_wh"] / row["distance_km"] == pytest.approx(156, rel=0.05)
+
+    def test_gap_within_a_drive_is_not_integrated(self, tmp_path):
+        """A dropped sample inside a drive must not add phantom distance."""
+        conn = make_store(tmp_path)
+        add(conn, "vehicle.speed", [100.0] * 300, BASE)
+        add(conn, "battery.pack_current", [40.0] * 300, BASE)
+        add(conn, "battery.pack_voltage", [390.0] * 300, BASE)
+        # A 5-minute hole, then more driving.
+        later = BASE + 300 * 10**9 + 300 * 10**9
+        add(conn, "vehicle.speed", [100.0] * 300, later)
+        add(conn, "battery.pack_current", [40.0] * 300, later)
+        add(conn, "battery.pack_voltage", [390.0] * 300, later)
+        db.rebuild(conn)
+        total = conn.execute("SELECT SUM(distance_km) AS d FROM segment").fetchone()["d"]
+        # 600 s at 100 kph = 16.7 km; the 5-minute hole must not count.
+        assert total == pytest.approx(16.67, rel=0.05)
+
+    def test_minority_regime_blip_is_merged(self, tmp_path):
+        conn = make_store(tmp_path)
+        speeds = [30.0] * 120 + [90.0] * 2 + [30.0] * 120   # 2 s of 'highway'
+        add(conn, "vehicle.speed", speeds, BASE)
+        db.rebuild(conn)
+        regimes = [r["regime"] for r in conn.execute("SELECT regime FROM segment")]
+        assert "highway" not in regimes, f"blip became a segment: {regimes}"
+
+    def test_idle_at_start_is_its_own_regime(self, tmp_path):
+        conn = make_store(tmp_path)
+        speeds = [0.0] * 60 + [50.0] * 120
+        add(conn, "vehicle.speed", speeds, BASE)
+        db.rebuild(conn)
+        regimes = [r["regime"] for r in conn.execute(
+            "SELECT regime FROM segment ORDER BY start_ns")]
+        assert regimes[0] == "idle" and "city" in regimes
+
+
+class TestDaily:
+    def test_groups_by_utc_day(self, tmp_path):
+        conn = make_store(tmp_path)
+        synth_drive(conn, BASE, kph=100.0, seconds=600)
+        synth_drive(conn, BASE + DAY_NS, kph=100.0, seconds=600)
+        db.rebuild(conn)
+        days = [r["day"] for r in conn.execute("SELECT day FROM daily ORDER BY day")]
+        assert len(days) == 2
+
+    def test_consumption_is_ratio_of_sums(self, tmp_path):
+        conn = make_store(tmp_path)
+        synth_drive(conn, BASE, kph=100.0, seconds=600)
+        db.rebuild(conn)
+        row = conn.execute("SELECT wh_per_km, distance_km, energy_wh FROM daily").fetchone()
+        # wh_per_km is stored rounded to 2 dp, so compare at that resolution.
+        assert row["wh_per_km"] == pytest.approx(
+            row["energy_wh"] / row["distance_km"], abs=0.01)
+
+    def test_soc_reported_as_start_and_end(self, tmp_path):
+        conn = make_store(tmp_path)
+        add(conn, "battery.soc", [80.0, 79.0, 78.0], BASE)
+        add(conn, "vehicle.speed", [50.0] * 3, BASE)
+        db.rebuild(conn)
+        row = conn.execute("SELECT soc_start, soc_end FROM daily").fetchone()
+        assert (row["soc_start"], row["soc_end"]) == (80.0, 78.0)
+
+
+class TestRebuild:
+    def test_rebuild_is_idempotent(self, tmp_path):
+        conn = make_store(tmp_path)
+        synth_drive(conn, BASE, kph=100.0, seconds=600)
+        first = db.rebuild(conn)
+        second = db.rebuild(conn)
+        assert first == second
+        assert conn.execute("SELECT COUNT(*) AS n FROM segment").fetchone()["n"] == \
+            first["segments"]
+
+    def test_empty_store_rebuilds_without_error(self, tmp_path):
+        conn = make_store(tmp_path)
+        assert db.rebuild(conn) == {"segments": 0, "days": 0, "cards": 0}
