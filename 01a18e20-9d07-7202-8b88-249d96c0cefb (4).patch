+#
+# Adding a protocol must never require touching this file's consumers.
+#
+# tier:
+#   hot   - sampled continuously at rate_hz, retained for the full horizon
+#   slow  - retained on-change, with deadband compression
+#   burst - retained only in event context windows (high-rate channels)
+#
+# bounds are PHYSICAL limits. The normaliser rejects out-of-range values as a
+# sensor fault rather than storing them - see vehiclegpt/ingest/base.py.
+
+version: 1
