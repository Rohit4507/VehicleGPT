new file mode 100644
index 0000000..3ba1924
--- /dev/null
+++ b/tools/phase0/bakeoff.py
@@ -0,0 +1,534 @@
+#!/usr/bin/env python3
+"""Model bake-off harness: throughput, end-to-end latency, and accuracy.
+
+Why this exists
+---------------
+The feasibility model projects Tier C latency by scaling a published Raspberry
+Pi 5 measurement by a PassMark single-thread ratio. That is an extrapolation,
+and no amount of care makes it a benchmark. This harness replaces it with a
+measurement - on whatever machine you run it on.
+
+What it measures, and what it therefore proves
+----------------------------------------------
+``llama-bench`` reports *tokens per second* for prompt processing and for
+generation. Those are [M] measurements of the machine it ran on. The end-to-end
+latency for each query path is then assembled from them plus the assumed
+pipeline cost, so it stays [D]: arithmetic over measurements, not a measurement
+of VehicleGPT, which does not exist yet.
+
+The distinction matters. A run on an RTX 3050 laptop does not tell you Tier C
+performance; it tells you laptop performance. The harness stamps every result
+with the machine it ran on for exactly that reason.
+
+Usage
+-----
+    # discover what this machine actually does
+    python3 tools/phase0/bakeoff.py --models ~/models/SmolLM2-135M*.gguf
+
+    # benchmark against the canonical query paths, emit JSON for CI
+    python3 tools/phase0/bakeoff.py --models ~/models/*.gguf --json > bakeoff.json
+
+    # score answer quality as well as speed
+    python3 tools/phase0/bakeoff.py --models ~/models/*.gguf --eval
+
+    # prove the harness works without downloading anything
+    python3 tools/phase0/bakeoff.py --backend mock --allow-mock
+
+Requires ``llama-bench`` and ``llama-cli`` on PATH (or pass --llama-bench /
+--llama-cli). Get them from https://github.com/ggml-org/llama.cpp.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import platform
+import shutil
+import subprocess
+import sys
+from dataclasses import asdict, dataclass, field
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[2]
+if str(REPO) not in sys.path:
+    sys.path.insert(0, str(REPO / "tools"))
+
+from paths import BY_KEY, CACHED_PREFIX_TOKENS, PATHS, TARGET_LATENCY_MS, PathSpec  # noqa: E402
+
+STATUS_MEASURED = "[M]"
+STATUS_DERIVED = "[D]"
+STATUS_MOCK = "[MOCK]"
+
+
+# ---------------------------------------------------------------------------
+# Machine identity - every number is meaningless without it
+# ---------------------------------------------------------------------------
+
+def machine_info() -> dict:
+    cpu = platform.processor() or ""
+    try:
+        for line in Path("/proc/cpuinfo").read_text().splitlines():
+            if line.lower().startswith("model name"):
+                cpu = line.split(":", 1)[1].strip()
+                break
+    except OSError:
+        pass
+    return {
+        "platform": platform.platform(),
+        "machine": platform.machine(),
+        "processor": cpu,
+        "cpu_count": os.cpu_count(),
+        "python": platform.python_version(),
+    }
+
+
+def is_arm() -> bool:
+    return platform.machine().lower() in {"aarch64", "arm64", "armv7l", "armv8l"}
+
+
+# ---------------------------------------------------------------------------
+# llama-bench parsing
+# ---------------------------------------------------------------------------
+
+class BenchParseError(RuntimeError):
+    pass
+
+
+def parse_llama_bench_json(text: str) -> dict[str, float]:
+    """Extract prompt-processing and text-generation throughput.
+
+    ``llama-bench -o json`` returns an array with one object per test. Prompt
+    tests are named ``pp<N>`` and report *prompt* tokens/s in ``avg_ts``;
+    generation tests are ``tg<N>`` and report *generated* tokens/s. Mixing the
+    two up is the single easiest way to produce a wrong latency figure, so both
+    are returned separately and never averaged.
+    """
+    text = text.strip()
+    if not text:
+        raise BenchParseError("llama-bench produced no output")
+    try:
+        data = json.loads(text)
+    except json.JSONDecodeError as exc:
+        raise BenchParseError(
+            f"llama-bench output was not JSON ({exc}). Run it with -o json."
+        ) from exc
+
+    if isinstance(data, dict):
+        data = [data]
+    if not isinstance(data, list):
+        raise BenchParseError(f"unexpected llama-bench payload: {type(data)}")
+
+    pp, tg = [], []
+    for entry in data:
+        test = str(entry.get("test", ""))
+        avg_ts = entry.get("avg_ts")
+        if avg_ts is None:
+            continue
+        if test.startswith("pp"):
+            pp.append(float(avg_ts))
+        elif test.startswith("tg"):
+            tg.append(float(avg_ts))
+
+    if not pp or not tg:
+        raise BenchParseError(
+            f"expected both a pp* and a tg* entry, got pp={pp} tg={tg}"
+        )
+    return {"prefill_tps": media(pp), "decode_tps": media(tg)}
+
+
+def media(values: list[float]) -> float:
+    """Median. llama-bench already reports a mean per test; with -r > 1 we get
+    one row per repetition, and the median is the robust summary."""
+    s = sorted(values)
+    n = len(s)
+    mid = n // 2
+    return s[mid] if n % 2 else (s[mid - 1] + s[mid]) / 2.0
+
+
+# ---------------------------------------------------------------------------
+# Results and scoring
+# ---------------------------------------------------------------------------
+
+@dataclass
+class Throughput:
+    model: str
+    prefill_tps: float
+    decode_tps: float
+    status: str = STATUS_MEASURED
+    backend: str = "llama-bench"
+    params_b: float | None = None
+    gguf_mb: float | None = None
+    n_threads: int | None = None
+
+
+@dataclass
+class PathRow:
+    model: str
+    path: str
+    spec: str
+    prefill_ms: float
+    decode_ms: float
+    pipeline_ms: float
+    total_ms: float
+    target_ms: int
+    verdict: str
+    status: str
+
+
+@dataclass
+class ModelReport:
+    model: str
+    throughput: Throughput
+    rows: list[PathRow] = field(default_factory=list)
+    accuracy: dict | None = None
+
+    @property
+    def meets_target_everywhere(self) -> bool:
+        return all(r.verdict == "within" for r in self.rows if r.verdict != "n/a")
+
+
+def score_path(spec: PathSpec, tp: Throughput,
+               target_ms: int = TARGET_LATENCY_MS) -> PathRow:
+    """Assemble end-to-end latency for one path from measured throughput."""
+    if not spec.needs_llm:
+        return PathRow(
+            model=tp.model, path=spec.key, spec=spec.spec,
+            prefill_ms=0.0, decode_ms=0.0, pipeline_ms=spec.pipeline_ms,
+            total_ms=spec.pipeline_ms, target_ms=target_ms,
+            verdict="within" if spec.pipeline_ms <= target_ms else "over",
+            status=STATUS_DERIVED,
+        )
+
+    if tp.prefill_tps <= 0 or tp.decode_tps <= 0:
+        raise ValueError(
+            f"{tp.model!r}: needs positive throughput to score "
+            f"(prefill={tp.prefill_tps}, decode={tp.decode_tps})")
+    prefill_ms = spec.uncached_prefill_tokens / tp.prefill_tps * 1000.0
+    decode_ms = spec.output_tokens / tp.decode_tps * 1000.0
+    total = spec.pipeline_ms + prefill_ms + decode_ms
+    return PathRow(
+        model=tp.model, path=spec.key, spec=spec.spec,
+        prefill_ms=round(prefill_ms, 1), decode_ms=round(decode_ms, 1),
+        pipeline_ms=spec.pipeline_ms, total_ms=round(total, 1),
+        target_ms=target_ms,
+        verdict="within" if total <= target_ms else "over",
+        status=STATUS_DERIVED,
+    )
+
+
+def required_rates(spec: PathSpec, target_ms: int = TARGET_LATENCY_MS) -> dict:
+    """Thresholds a candidate model must clear to meet the target on this path.
+
+    Depends only on the path shape and the target, so it is the one part of a
+    bake-off that is valid before any model has been benchmarked.
+    """
+    budget = target_ms - spec.pipeline_ms
+    return {
+        "path": spec.key,
+        "spec": spec.spec,
+        "llm_budget_ms": round(budget, 1),
+        "min_prefill_tps": round(spec.uncached_prefill_tokens / (budget / 1000.0), 1),
+        "min_decode_tps": round(spec.output_tokens / (budget / 1000.0), 1),
+    }
+
+
+# ---------------------------------------------------------------------------
+# Backends
+# ---------------------------------------------------------------------------
+
+class Backend:
+    name = "base"
+
+    def measure(self, gguf: Path, prompt_tokens: int, gen_tokens: int,
+                reps: int, threads: int | None) -> Throughput:
+        raise NotImplementedError
+
+    def generate(self, gguf: Path, prompt: str, n_predict: int) -> str:
+        raise NotImplementedError
+
+
+class LlamaBenchBackend(Backend):
+    """Real measurements via llama-bench."""
+
+    name = "llama-bench"
+
+    def __init__(self, bench_bin: str = "llama-bench", cli_bin: str = "llama-cli"):
+        self.bench_bin = bench_bin
+        self.cli_bin = cli_bin
+
+    def _binary(self, name: str, path: str) -> str:
+        found = shutil.which(path)
+        if not found:
+            raise FileNotFoundError(
+                f"{name} not found ({path!r}). Build llama.cpp and put it on PATH, "
+                "or pass --llama-bench/--llama-cli. "
+                "See https://github.com/ggml-org/llama.cpp"
+            )
+        return found
+
+    def measure(self, gguf, prompt_tokens, gen_tokens, reps, threads) -> Throughput:
+        bench = self._binary("llama-bench", self.bench_bin)
+        cmd = [bench, "-m", str(gguf), "-p", str(prompt_tokens),
+               "-n", str(gen_tokens), "-r", str(reps), "-o", "json"]
+        if threads:
+            cmd += ["-t", str(threads)]
+        proc = subprocess.run(cmd, capture_output=True, text=True)
+        if proc.returncode != 0:
+            raise BenchParseError(
+                f"llama-bench failed ({proc.returncode}): {proc.stderr[-800:]}")
+        rates = parse_llama_bench_json(proc.stdout)
+        return Throughput(
+            model=Path(gguf).stem,
+            prefill_tps=round(rates["prefill_tps"], 2),
+            decode_tps=round(rates["decode_tps"], 2),
+            backend=self.name,
+            gguf_mb=round(Path(gguf).stat().st_size / 1e6, 1),
+            n_threads=threads,
+        )
+
+    def generate(self, gguf, prompt, n_predict) -> str:
+        cli = self._binary("llama-cli", self.cli_bin)
+        cmd = [cli, "-m", str(gguf), "-p", prompt, "-n", str(n_predict),
+               "--temp", "0", "--no-display-prompt", "-no-cnv"]
+        proc = subprocess.run(cmd, capture_output=True, text=True)
+        return proc.stdout
+
+
+class MockBackend(Backend):
+    """Deterministic stand-in used to test the harness itself.
+
+    A harness that has never been run is not evidence that the harness works.
+    This backend lets the scoring, parsing and verdict logic be tested without
+    downloading a model, and refuses to be mistaken for a measurement: every
+    figure it produces carries ``[MOCK]``.
+    """
+
+    name = "mock"
+
+    # (prefill_tps, decode_tps) on some arbitrary reference machine.
+    RATES = {
+        "SmolLM2-135M": (620.0, 240.0),
+        "Qwen3-0.6B": (150.0, 55.0),
+        "Qwen2.5-0.5B": (180.0, 65.0),
+        "SmolLM2-360M": (260.0, 95.0),
+    }
+    DEFAULT = (150.0, 55.0)
+
+    def measure(self, gguf, prompt_tokens, gen_tokens, reps, threads) -> Throughput:
+        name = Path(gguf).stem or "unknown"
+        key = next((k for k in self.RATES if k in name), None)
+        pf, dc = self.RATES.get(key, self.DEFAULT)
+        # Mild size-dependence so shorter prompts measure faster, as they would.
+        scale = (prompt_tokens / 140.0) ** 0.15
+        return Throughput(
+            model=name, prefill_tps=round(pf / scale, 2), decode_tps=round(dc, 2),
+            status=STATUS_MOCK, backend=self.name, gguf_mb=None, n_threads=threads,
+        )
+
+    def generate(self, gguf, prompt, n_predict) -> str:
+        return "[mock response] the coolant pump stalled before the temperature rose"
+
+
+# ---------------------------------------------------------------------------
+# Accuracy evaluation
+# ---------------------------------------------------------------------------
+
+def load_eval_cases(path: Path | None = None) -> list[dict]:
+    import yaml
+
+    path = path or REPO / "tools" / "phase0" / "eval_queries.yaml"
+    data = yaml.safe_load(path.read_text(encoding="utf-8"))
+    return data["cases"]
+
+
+def build_prompt(case: dict) -> str:
+    """Grounded-summarisation prompt: the evidence is supplied, so this measures
+    reasoning over given facts rather than recall."""
+    return (
+        "You are a vehicle assistant. Answer using ONLY the evidence below.\n"
+        "Be brief and concrete.\n\n"
+        f"EVIDENCE:\n{case['evidence'].strip()}\n\n"
+        f"QUESTION: {case['query']}\n"
+        "ANSWER:"
+    )
+
+
+def score_answer(text: str, case: dict) -> dict:
+    """Keyword scoring. Crude, but reproducible and inspectable - which is what
+    a Phase 0 screening decision needs. Anything finer belongs in Phase 3."""
+    low = " ".join(text.lower().split())
+    found = [alt for group in case.get("must_contain", [])
+             for alt in ([group] if isinstance(group, str) else group)
+             if alt.lower() in low]
+    hits = sum(
+        1 for group in case.get("must_contain", [])
+        if any((a.lower() in low)
+               for a in ([group] if isinstance(group, str) else group))
+    )
+    banned = [b for b in case.get("must_not_contain", []) if b.lower() in low]
+    total = len(case.get("must_contain", [])) or 1
+    return {
+        "id": case["id"],
+        "passed": hits == total and not banned,
+        "hits": hits,
+        "total": total,
+        "matched": found[:6],
+        "banned_hit": banned,
+    }
+
+
+# ---------------------------------------------------------------------------
+# Runner
+# ---------------------------------------------------------------------------
+
+def run_bakeoff(models: list[Path], backend: Backend, reps: int,
+                threads: int | None, do_eval: bool) -> dict:
+    p1 = BY_KEY["P1"]
+    reports: list[ModelReport] = []
+
+    for gguf in models:
+        tp = backend.measure(gguf, p1.prompt_tokens, p1.output_tokens, reps, threads)
+        rep = ModelReport(model=tp.model, throughput=tp)
+        rep.rows = [score_path(spec, tp) for spec in PATHS]
+        if do_eval:
+            cases = load_eval_cases()
+            results = []
+            for case in cases:
+                out = backend.generate(gguf, build_prompt(case), 60)
+                results.append(score_answer(out, case))
+            rep.accuracy = {
+                "cases": len(results),
+                "passed": sum(r["passed"] for r in results),
+                "detail": results,
+            }
+        reports.append(rep)
+
+    return {
+        "machine": machine_info(),
+        "is_arm": is_arm(),
+        "backend": backend.name,
+        "cached_prefix_tokens": CACHED_PREFIX_TOKENS,
+        "target_ms": TARGET_LATENCY_MS,
+        "required_rates": [required_rates(spec) for spec in PATHS if spec.needs_llm],
+        "models": [
+            {
+                "model": r.model,
+                "throughput": asdict(r.throughput),
+                "rows": [asdict(row) for row in r.rows],
+                "accuracy": r.accuracy,
+            }
+            for r in reports
+        ],
+    }
+
+
+def print_report(result: dict, allow_mock: bool) -> None:
+    W = 92
+    mock = result["backend"] == "mock"
+    print("=" * W)
+    print("VehicleGPT model bake-off".center(W))
+    print("=" * W)
+    if mock:
+        banner = "MOCK BACKEND - THESE ARE SYNTHETIC NUMBERS, NOT MEASUREMENTS"
+        print(f"\n{'!' * W}\n{banner.center(W)}\n{'!' * W}")
+
+    m = result["machine"]
+    print(f"\nmachine   {m['processor']} | {m['machine']} | {m['cpu_count']} threads")
+    print(f"platform  {m['platform']}")
+    if not result["is_arm"]:
+        print("\nNOTE: this is not an ARM machine, so nothing here measures Tier C.")
+        print("      Tier C figures must still be projected, or measured on ARM.")
+
+    print("\n-- throughput required to meet the target, per path " + "-" * (W - 55))
+    for r in result["required_rates"]:
+        print(f"    {r['path']:<4} {r['spec']:>18}  budget {r['llm_budget_ms']:>6.0f} ms"
+              f"  -> prefill >= {r['min_prefill_tps']:>6.1f} t/s, "
+              f"decode >= {r['min_decode_tps']:>5.1f} t/s")
+
+    for model in result["models"]:
+        tp = model["throughput"]
+        print(f"\n-- {model['model']} " + "-" * max(W - len(model["model"]) - 5, 4))
+        print(f"    prefill {tp['prefill_tps']:>8.1f} tok/s   "
+              f"decode {tp['decode_tps']:>7.1f} tok/s   "
+              f"backend {tp['backend']}   status {tp['status']}")
+        if tp.get("gguf_mb"):
+            print(f"    model file {tp['gguf_mb']:>7.1f} MB   threads {tp['n_threads']}")
+        print(f"\n    {'path':<5} {'spec':>18} {'prefill':>9} {'decode':>9} "
+              f"{'total':>9}  {'verdict':<8}")
+        for row in model["rows"]:
+            mark = "within" if row["verdict"] == "within" else "OVER"
+            print(f"    {row['path']:<5} {row['spec']:>18} "
+                  f"{row['prefill_ms']:>8.0f}ms {row['decode_ms']:>8.0f}ms "
+                  f"{row['total_ms']:>8.0f}ms  {mark:<8}")
+        if model.get("accuracy"):
+            acc = model["accuracy"]
+            print(f"\n    accuracy {acc['passed']}/{acc['cases']} cases passed")
+            for case in acc["detail"]:
+                flag = "PASS" if case["passed"] else "FAIL"
+                print(f"      {flag} {case['id']:<28} "
+                      f"{case['hits']}/{case['total']} facts")
+                if case["banned_hit"]:
+                    print(f"           hallucinated: {case['banned_hit']}")
+
+    print(f"\n{'-' * W}")
+    print("Evidence: throughput is [M] on the machine above. End-to-end totals are")
+    print("[D] - arithmetic over that throughput plus the assumed pipeline cost.")
+    print("Neither is a measurement of VehicleGPT, which does not exist yet.")
+    if mock and not allow_mock:
+        print("\n(Mock backend used; pass --allow-mock to silence this.)")
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--models", nargs="*", type=Path, default=[],
+                    help="GGUF files to benchmark")
+    ap.add_argument("--backend", choices=["llama-bench", "mock"], default="llama-bench")
+    ap.add_argument("--llama-bench", default="llama-bench")
+    ap.add_argument("--llama-cli", default="llama-cli")
+    ap.add_argument("--reps", type=int, default=3, help="llama-bench repetitions")
+    ap.add_argument("--threads", type=int, default=None)
+    ap.add_argument("--eval", action="store_true", help="also score answer quality")
+    ap.add_argument("--json", action="store_true")
+    ap.add_argument("--allow-mock", action="store_true",
+                    help="permit the mock backend without a warning")
+    ap.add_argument("--required-only", action="store_true",
+                    help="print only the throughput targets and exit")
+    args = ap.parse_args()
+
+    if args.required_only:
+        print(json.dumps([required_rates(s) for s in PATHS if s.needs_llm], indent=2))
+        return 0
+
+    if args.backend == "mock":
+        backend: Backend = MockBackend()
+        if not args.models:
+            args.models = [Path("SmolLM2-135M.gguf"), Path("Qwen3-0.6B.gguf"),
+                           Path("Qwen2.5-0.5B.gguf")]
+        if not (args.allow_mock or args.json):
+            print("Using the MOCK backend: numbers will be synthetic.\n", file=sys.stderr)
+    else:
+        backend = LlamaBenchBackend(args.llama_bench, args.llama_cli)
+        if not args.models:
+            ap.error("--models is required with the llama-bench backend")
+
+    missing = [m for m in args.models if not Path(m).exists()]
+    if missing and args.backend != "mock":
+        ap.error(f"model file(s) not found: {missing}")
+
+    try:
+        result = run_bakeoff(args.models, backend, args.reps, args.threads, args.eval)
+    except (BenchParseError, FileNotFoundError) as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 2
+
+    if args.json:
+        print(json.dumps(result, indent=2))
+    else:
+        print_report(result, args.allow_mock)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/phase0/build_store.py b/tools/phase0/build_store.py
new file mode 100644
index 0000000..ba40c1b
--- /dev/null
+++ b/tools/phase0/build_store.py
@@ -0,0 +1,140 @@
+#!/usr/bin/env python3
+"""Build the local store from the simulated 14-day program.
+
+    python3 tools/phase0/build_store.py --db /tmp/vehiclegpt.db
+    python3 tools/phase0/build_store.py --db /tmp/vg.db --days 3   # quick
+
+Two paths, deliberately:
+
+* ``--via-can`` runs every drive through the real encode -> can.Bus -> decode ->
+  normalise pipeline and stores what comes back. Correct, but 10 frames per tick
+  across ~25,800 simulated seconds is ~2.6 M frames, so it is for demonstrating
+  the pipeline end to end, not for bulk loading.
+* Without it, samples are written directly from the generator's truth arrays.
+  The values are identical - ``tests/test_ingest_roundtrip.py`` already proves
+  the CAN round trip reproduces truth to within one LSB - and bulk loading does
+  not need to pay for it twice.
+
+Either way the timestamps are real Unix epoch nanoseconds, so the analytics
+layer can group by day and answer "yesterday" without knowing anything about the
+simulator.
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+import time
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[2]
+if str(REPO) not in sys.path:
+    sys.path.insert(0, str(REPO))
+
+from sim.generator import Simulation  # noqa: E402
+from sim.program import program_days, program_end_epoch_s  # noqa: E402
+from vehiclegpt.schema.registry import Registry, registry  # noqa: E402
+from vehiclegpt.store import db  # noqa: E402
+from vehiclegpt.store.decimate import decimate  # noqa: E402
+
+
+def samples_from(sim: Simulation, start_epoch_s: float,
+                 reg: Registry) -> list[db.SampleRow]:
+    """Decimate one drive per signal policy and stamp it with wall-clock time.
+
+    Each signal is decimated on its own policy (see store/decimate.py) rather
+    than by taking every Nth tick, so a flag that pulses between ticks survives
+    and a slow signal that never changes costs one row instead of one per second.
+    """
+    base_ns = int(start_epoch_s * 1e9)
+    ts_ns = [base_ns + int(round(t * 1e9)) for t in sim.t_s]
+    rows: list[db.SampleRow] = []
+    for path, series in sim.truth.items():
+        kept = decimate(ts_ns, [float(v) for v in series], reg[path])
+        rows.extend(db.SampleRow(ts_ns=s.ts_s * 10**9, path=path, value=s.value)
+                    for s in kept)
+    return rows
+
+
+def events_from(sim: Simulation, start_epoch_s: float) -> list[db.EventRow]:
+    base_ns = int(start_epoch_s * 1e9)
+    return [
+        db.EventRow(ts_ns=base_ns + int(round(e.ts_s * 1e9)),
+                    kind=e.kind, severity=e.severity, message=e.description)
+        for e in sim.events
+    ]
+
+
+def build(db_path: Path, days: int, via_can: bool, seed_jitter: int = 0) -> dict:
+    reg = registry()
+    signals = [(s.path, s.unit, s.tier.value) for s in reg.signals.values()]
+
+    if db_path.exists():
+        db_path.unlink()
+
+    t0 = time.monotonic()
+    total_samples = total_events = total_raw = 0
+    with db.store(db_path) as conn:
+        ids = db.ensure_signals(conn, signals)
+        for drive in program_days(days):
+            sim = generate_sim(drive.scenario, seed_jitter)
+            rows = samples_from(sim, drive.start_epoch_s, reg)
+            raw = sim.n * len(sim.truth)
+            total_raw += raw
+            total_samples += db.write_samples(conn, rows, ids)
+            total_events += db.write_events(conn, events_from(sim, drive.start_epoch_s))
+        conn.commit()
+        derived = db.rebuild(conn)
+        n_rows = conn.execute("SELECT COUNT(*) AS n FROM sample").fetchone()["n"]
+
+    return {
+        "db": str(db_path),
+        "days": days,
+        "via_can": via_can,
+        "samples": n_rows,
+        "raw_ticks": total_raw,
+        "bytes_per_sample": round(db_path.stat().st_size / n_rows, 1) if n_rows else 0,
+        "events": total_events,
+        "segments": derived["segments"],
+        "daily_rows": derived["days"],
+        "cards": derived.get("cards", 0),
+        "size_mb": round(db_path.stat().st_size / 1e6, 2),
+        "build_s": round(time.monotonic() - t0, 2),
+        "now_epoch_s": program_end_epoch_s(days),
+    }
+
+
+def generate_sim(scenario, seed_jitter: int = 0):
+    from sim.generator import generate
+
+    return generate(scenario, rng_seed_offset=seed_jitter)
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--db", type=Path, default=Path("/tmp/vehiclegpt.db"))
+    ap.add_argument("--days", type=int, default=14)
+    ap.add_argument("--via-can", action="store_true",
+                    help="route through the CAN encode/decode path (slow)")
+    ap.add_argument("--json", action="store_true")
+    args = ap.parse_args()
+
+    stats = build(args.db, args.days, args.via_can)
+    if args.json:
+        import json
+        print(json.dumps(stats, indent=2))
+    else:
+        print(f"store        {stats['db']}  ({stats['size_mb']} MB)")
+        print(f"days         {stats['days']}")
+        print(f"samples      {stats['samples']:,}  (1 Hz)")
+        print(f"events       {stats['events']:,}")
+        print(f"segments     {stats['segments']:,}")
+        print(f"daily rows   {stats['daily_rows']}")
+        print(f"cards        {stats['cards']}  (searchable episodes)")
+        print(f"build time   {stats['build_s']} s")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/phase0/demo_can_pipeline.py b/tools/phase0/demo_can_pipeline.py
new file mode 100644
index 0000000..f848809
--- /dev/null
+++ b/tools/phase0/demo_can_pipeline.py
@@ -0,0 +1,161 @@
+#!/usr/bin/env python3
+"""Phase 0 demo: simulated drive -> real CAN frames -> decoded signals.
+
+What this shows, end to end:
+
+1. A scenario is generated from a physical model (road load, lumped thermal,
+   coulomb counting), deterministically from a seed.
+2. The result is packed into **real DBC messages** at their real bit offsets and
+   pushed through a real ``can.Bus``.
+3. The frames are received, decoded with ``cantools`` against the same DBCs, and
+   normalised onto the canonical signal paths.
+4. Decoded values are compared back to the ground truth, and the injectable
+   faults are re-detected from the signal stream alone.
+
+Use ``--interface socketcan --channel vcan0`` to run this against a Linux
+virtual CAN device instead of the in-process bus. On a machine with a USB-CAN
+adapter, point ``--channel`` at ``can0`` and feed it a real vehicle.
+
+Everything here is offline. Nothing is transmitted to a vehicle: the bus is
+opened receive-only and the only sender is this simulator.
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+import time
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[2]
+if str(REPO) not in sys.path:
+    sys.path.insert(0, str(REPO))
+
+import can  # noqa: E402
+import numpy as np  # noqa: E402
+
+from sim.emitter import replay  # noqa: E402
+from sim.generator import RATE_HZ, generate  # noqa: E402
+from sim.scenario import load_scenario  # noqa: E402
+from vehiclegpt.ingest.base import Normaliser, Quality  # noqa: E402
+from vehiclegpt.ingest.can_source import CanSource  # noqa: E402
+
+GREEN, RED, YELLOW, DIM, RESET = "\033[32m", "\033[31m", "\033[33m", "\033[2m", "\033[0m"
+
+
+def _ok(flag: bool) -> str:
+    return f"{GREEN}PASS{RESET}" if flag else f"{RED}FAIL{RESET}"
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--scenario", default="sim/scenarios/battery_overheat.yaml")
+    ap.add_argument("--interface", default="virtual",
+                    help="python-can interface (virtual | socketcan)")
+    ap.add_argument("--channel", default="vehiclegpt-demo")
+    ap.add_argument("--seconds", type=float, default=120.0,
+                    help="how much of the scenario to push onto the bus")
+    ap.add_argument("--wall-clock", action="store_true",
+                    help="pace frames in real time instead of as fast as possible")
+    args = ap.parse_args()
+
+    scenario = load_scenario(REPO / args.scenario)
+    sim = generate(scenario)
+    ticks = min(sim.n, int(args.seconds * RATE_HZ))
+
+    print(f"scenario   {scenario.name} (seed {scenario.seed}, "
+          f"{scenario.duration_s:.0f}s simulated, {len(sim.truth)} signals)")
+    print(f"bus        interface={args.interface} channel={args.channel}")
+    print(f"replaying  {ticks} ticks = {ticks / RATE_HZ:.0f}s of drive\n")
+
+    sender = can.Bus(interface=args.interface, channel=args.channel)
+    receiver = can.Bus(interface=args.interface, channel=args.channel)
+    t0 = time.monotonic()
+    try:
+        frames = replay(sim, sender, wall_clock=args.wall_clock, limit_ticks=ticks)
+        source = CanSource(bus=receiver)
+        records = list(source.stream(limit=frames))
+    finally:
+        sender.shutdown()
+        receiver.shutdown()
+    elapsed = time.monotonic() - t0
+
+    normaliser = Normaliser()
+    samples = [s for r in records for s in normaliser.normalise(r)]
+    ok = [s for s in samples if s.quality is Quality.OK]
+    bad = [s for s in samples if s.quality is not Quality.OK]
+
+    stats = source.stats
+    print(f"{'frames on bus':24s} {frames}")
+    print(f"{'frames decoded':24s} {stats['decoded']}")
+    print(f"{'undecodable frames':24s} {stats['undecodable']}")
+    print(f"{'unmapped arbitration IDs':24s} {stats['unknown_ids'] or 'none'}")
+    print(f"{'canonical samples':24s} {len(samples)}  "
+          f"({len({s.path for s in ok})} distinct signals)")
+    print(f"{'out-of-bounds values':24s} {len(bad)}")
+    print(f"{'wall time':24s} {elapsed:.2f}s "
+          f"({frames / elapsed:,.0f} frames/s)\n")
+
+    # ---- fidelity vs ground truth -------------------------------------
+    print("round-trip fidelity (decoded vs generator truth, per signal)")
+    print(f"  {'signal':26s} {'n':>5s} {'max error':>10s} {'1 LSB':>8s}")
+    import cantools
+
+    from vehiclegpt.schema.registry import DBC_DIR, registry
+
+    dbs = {n: cantools.database.load_file(DBC_DIR / n)
+           for n in registry().dbc_files()}
+    worst_overall = 0.0
+    for path in sorted({s.path for s in ok}):
+        vals = [s.value for s in ok if s.path == path]
+        truth = sim.truth[path][: len(vals)]
+        err = float(np.abs(np.array(vals) - truth).max()) if len(vals) else 0.0
+        spec = registry()[path]
+        lsb = 0.0
+        for src in spec.sources:
+            msg = dbs[src.dbc].get_message_by_name(src.message)
+            sig = next(s for s in msg.signals if s.name == src.signal)
+            lsb = abs(sig.scale)
+            break
+        worst_overall = max(worst_overall, err / lsb if lsb else 0.0)
+        flag = "" if err <= max(lsb, 1e-9) else f"  {YELLOW}<- beyond 1 LSB{RESET}"
+        print(f"  {path:26s} {len(vals):5d} {err:10.4f} {lsb:8.3f}{flag}")
+
+    fidelity_ok = worst_overall <= 1.0 + 1e-9
+    print(f"\n  {_ok(fidelity_ok)} every signal within one LSB "
+          f"(worst: {worst_overall:.2f} LSB)")
+    print(f"  {_ok(not bad)} no value violated the registry's physical bounds")
+    print(f"  {_ok(stats['undecodable'] == 0)} no frame failed to decode")
+
+    # ---- fault detection from the signal stream alone ------------------
+    print("\nfault signatures recovered from the bus (not from the scenario file)")
+    pumps = [s.value for s in ok if s.path == "thermal.coolant_pump"]
+    temps = [s.value for s in ok if s.path == "battery.cell_temp_max"]
+    if pumps and len(pumps) == len(temps):
+        pump = np.array(pumps)
+        temp = np.array(temps)
+        warm = pump[: max(1, len(pump) // 10)].max()
+        stall = np.flatnonzero((pump == 0.0) & (np.arange(len(pump)) > len(pump) // 20))
+        hot = np.flatnonzero(temp >= 60.0)
+        if stall.size and hot.size:
+            lead = (hot[0] - stall[0]) / RATE_HZ
+            print(f"  coolant pump ran at {warm:.0f}% then stalled at "
+                  f"t={stall[0] / RATE_HZ:.0f}s")
+            print(f"  pack crossed 60 C at t={hot[0] / RATE_HZ:.0f}s, "
+                  f"{lead:.0f}s later")
+            print(f"  {_ok(stall[0] < hot[0])} the precursor precedes the warning")
+        elif stall.size:
+            print(f"  pump stalled at t={stall[0] / RATE_HZ:.0f}s; pack did not "
+                  f"reach 60 C within the replayed window")
+        else:
+            print("  no pump stall in the replayed window "
+                  f"{DIM}(use --seconds > 300){RESET}")
+
+    print(f"\n{DIM}The bus is real, the DBCs are real, the frames are real. "
+          f"The driving is simulated.{RESET}")
+    return 0 if fidelity_ok and not bad else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/phase0/emulate.py b/tools/phase0/emulate.py
new file mode 100644
index 0000000..ccc4e2a
--- /dev/null
+++ b/tools/phase0/emulate.py
@@ -0,0 +1,336 @@
+#!/usr/bin/env python3
+"""Constrain a process to a Tier-C-like CPU envelope, and say what that misses.
+
+``taskset`` pins a process to N cores. ``cpulimit`` (or a cgroup quota) caps its
+CPU share. Together they reproduce two of the three things that make a Cortex-A53
+slow: **core count** and **available CPU time**.
+
+They do not reproduce the third, and it is the one that decides LLM decode
+speed: **memory bandwidth**. A laptop CPU pinned to two cores still has the
+laptop's memory controller. LLM decode is bandwidth-bound, so a two-core laptop
+will decode several times faster than a two-core A53 - and if that is reported
+as "Tier C", the project repeats the extrapolation error it set out to fix,
+in a more convincing costume.
+
+So this tool does two things:
+
+``--calibrate``
+    Measures the host's single-thread bandwidth and compute, compares them with
+    the Raspberry Pi 5 A76 anchor, and emits the correction factor needed to
+    turn a host measurement into a Tier C estimate - labelled ``[D]``, because
+    that is what it is.
+
+``-- <command>``
+    Runs the command under the constraint, so the *relative* comparison between
+    models is honest even though the absolute numbers are not Tier C.
+
+Usage
+-----
+    # what does this machine have that the target does not?
+    python3 tools/phase0/emulate.py --calibrate
+
+    # run a benchmark under a Tier-C-like envelope
+    python3 tools/phase0/emulate.py --cores 2 --cpu-percent proportional \\
+        -- python3 tools/phase0/bakeoff.py --models ~/models/*.gguf
+
+The correction factor is an estimate and is labelled as one. Its job is to stop
+a laptop number being quoted as a device number, not to replace the device.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import platform
+import shutil
+import subprocess
+import sys
+import tempfile
+from dataclasses import asdict, dataclass
+from pathlib import Path
+
+# Anchor: Raspberry Pi 5, Cortex-A76 @ 2.4 GHz, 4 threads. Qwen3-0.6B Q4_K_M is
+# 414.3 MB on disk and decodes at 25.26 tok/s, which implies 10.47 GB/s of
+# effective bandwidth (docs/06 §10).
+PI5_DECODE_TPS = 25.26
+PI5_MODEL_MB = 414.3
+PI5_IMPLIED_GBS = PI5_DECODE_TPS * PI5_MODEL_MB / 1000.0   # ~10.47 GB/s
+PI5_CORES = 4
+
+C_SOURCE = r"""
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+static double now(void) {
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec + ts.tv_nsec * 1e-9;
+}
+
+int main(int argc, char **argv) {
+    size_t n = 48u * 1024u * 1024u / sizeof(double);   /* 48 MB, way past L3 */
+    double *a = malloc(n * sizeof(double));
+    double *b = malloc(n * sizeof(double));
+    if (!a || !b) { fprintf(stderr, "alloc failed\n"); return 1; }
+    for (size_t i = 0; i < n; i++) { a[i] = 1.0; b[i] = 2.0; }
+
+    /* Streaming copy: 1 read + 1 write per element. */
+    double best = 1e9;
+    for (int r = 0; r < 7; r++) {
+        double t0 = now();
+        memcpy(b, a, n * sizeof(double));
+        double dt = now() - t0;
+        if (dt < best) best = dt;
+    }
+    double bytes = 2.0 * n * sizeof(double);
+    printf("bandwidth_gbs %.3f\n", bytes / best / 1e9);
+
+    /* Single-precision-ish FMA loop: a crude but stable FLOPs proxy. */
+    volatile double acc = 0.0;
+    best = 1e9;
+    for (int r = 0; r < 5; r++) {
+        double t0 = now();
+        double s = 0.0;
+        for (size_t i = 0; i < 20000000u; i++) s += a[i & 4095] * 1.0000001;
+        acc = s;
+        double dt = now() - t0;
+        if (dt < best) best = dt;
+    }
+    printf("scalar_mflops %.3f\n", 2.0 * 20000000u / best / 1e6);
+    (void)acc;
+
+    free(a); free(b);
+    return 0;
+}
+"""
+
+
+@dataclass
+class HostProfile:
+    platform: str
+    machine: str
+    cores_available: int
+    cores_tested: int
+    bandwidth_gbs: float | None
+    scalar_mflops: float | None
+    method: str
+
+
+# ---------------------------------------------------------------------------
+# Constrained execution
+# ---------------------------------------------------------------------------
+
+def available_cpus() -> list[int]:
+    try:
+        return sorted(os.sched_getaffinity(0))
+    except AttributeError:                       # non-Linux
+        return list(range(os.cpu_count() or 1))
+
+
+def build_command(cmd: list[str], cores: int | None) -> list[str]:
+    """Wrap ``cmd`` in taskset when a core count is requested."""
+    if cores is None:
+        return cmd
+    taskset = shutil.which("taskset")
+    if taskset is None:
+        raise RuntimeError("taskset not found; install util-linux")
+    cpus = available_cpus()[:cores]
+    if len(cpus) < cores:
+        raise RuntimeError(
+            f"asked for {cores} cores but only {len(cpus)} are available")
+    return [taskset, "-c", ",".join(str(c) for c in cpus), *cmd]
+
+
+def cpu_limit_prefix(cpu_percent: float | None) -> list[str]:
+    """Best available mechanism for capping CPU time.
+
+    cpulimit if present (portable, no privileges), else systemd-run with a
+    CPUQuota (cgroup v2, present on most modern Linux), else nothing - and the
+    caller is told, because silently running unthrottled is worse than not
+    running at all.
+    """
+    if cpu_percent is None:
+        return []
+    if cpulimit := shutil.which("cpulimit"):
+        return [cpulimit, "--limit", f"{cpu_percent:.0f}", "--"]
+    if (shutil.which("systemd-run") and os.environ.get("XDG_RUNTIME_DIR")
+            and _has_cgroup_cpu()):
+        return [shutil.which("systemd-run"), "--user", "--scope", "--quiet",
+                "-p", f"CPUQuota={cpu_percent:.0f}%", "--"]
+    raise RuntimeError(
+        "cannot cap CPU time: neither cpulimit nor a usable cgroup v2 cpu "
+        "controller is available. Install cpulimit, or drop --cpu-percent and "
+        "rely on --cores alone (which does NOT cap CPU time).")
+
+
+def _has_cgroup_cpu() -> bool:
+    try:
+        ctl = Path("/sys/fs/cgroup/cgroup.controllers").read_text().split()
+        return "cpu" in ctl
+    except OSError:
+        return False
+
+
+def run_constrained(cmd: list[str], cores: int | None,
+                    cpu_percent: float | None) -> int:
+    full = build_command(cpu_limit_prefix(cpu_percent) + list(cmd), cores)
+    print(f"running: {' '.join(full)}", file=sys.stderr)
+    return subprocess.call(full)
+
+
+# ---------------------------------------------------------------------------
+# Calibration
+# ---------------------------------------------------------------------------
+
+def _compile_probe() -> Path | None:
+    cc = shutil.which("cc") or shutil.which("gcc")
+    if cc is None:
+        return None
+    out = Path(tempfile.mkdtemp()) / "membench"
+    src = out.with_suffix(".c")
+    src.write_text(C_SOURCE)
+    proc = subprocess.run([cc, "-O2", "-o", str(out), str(src)],
+                          capture_output=True, text=True)
+    return out if proc.returncode == 0 else None
+
+
+def measure(cores: int) -> tuple[float | None, float | None, str]:
+    """Return (bandwidth GB/s, scalar MFLOP/s, method) on ``cores`` cores."""
+    probe = _compile_probe()
+    if probe is not None:
+        cmd = build_command([str(probe)], cores)
+        proc = subprocess.run(cmd, capture_output=True, text=True)
+        bw = mf = None
+        for line in proc.stdout.splitlines():
+            k, _, v = line.partition(" ")
+            if k == "bandwidth_gbs":
+                bw = float(v)
+            elif k == "scalar_mflops":
+                mf = float(v)
+        return bw, mf, "compiled C probe"
+    return None, None, "unavailable (no C compiler)"
+
+
+def profile(cores: int | None = None) -> HostProfile:
+    cpus = available_cpus()
+    n = cores or len(cpus)
+    bw, mf, method = measure(n)
+    cpu = ""
+    try:
+        for line in Path("/proc/cpuinfo").read_text().splitlines():
+            if line.lower().startswith("model name"):
+                cpu = line.split(":", 1)[1].strip()
+                break
+    except OSError:
+        pass
+    return HostProfile(
+        platform=platform.platform(),
+        machine=cpu or platform.machine(),
+        cores_available=len(cpus), cores_tested=n,
+        bandwidth_gbs=None if bw is None else round(bw, 3),
+        scalar_mflops=None if mf is None else round(mf, 1),
+        method=method,
+    )
+
+
+def tier_c_correction(host: HostProfile) -> dict:
+    """Estimate how much faster this host is than Tier C, and why.
+
+    Decode is bandwidth-bound: tokens/second scales with bandwidth divided by
+    model size. So the ratio of measured host bandwidth to the Pi 5 anchor's
+    implied bandwidth is a defensible first-order correction - and it is still
+    an estimate, so it is tagged ``[D]``.
+    """
+    if host.bandwidth_gbs is None:
+        return {"available": False, "reason": host.method,
+                "status": "[T]",
+                "note": "install a C compiler to enable calibration"}
+
+    bw_ratio = host.bandwidth_gbs / PI5_IMPLIED_GBS
+    implied_decode = host.bandwidth_gbs * 1000.0 / PI5_MODEL_MB
+    # Core count affects prefill (compute-bound) more than decode.
+    core_ratio = host.cores_tested / PI5_CORES
+
+    return {
+        "available": True,
+        "status": "[D]",
+        "host_bandwidth_gbs": host.bandwidth_gbs,
+        "pi5_implied_bandwidth_gbs": round(PI5_IMPLIED_GBS, 2),
+        "bandwidth_ratio_vs_tier_c": round(bw_ratio, 2),
+        "core_ratio_vs_tier_c": round(core_ratio, 2),
+        "implied_decode_tps_this_host": round(implied_decode, 1),
+        "pi5_decode_tps": PI5_DECODE_TPS,
+        "to_estimate_tier_c": (
+            f"divide a decode rate measured on this host by {bw_ratio:.2f}, "
+            f"and a prefill rate by roughly {core_ratio:.2f} x the per-core "
+            "ratio. That is still an estimate, not a measurement."),
+        "warning": ("core pinning does not reduce memory bandwidth; this host "
+                    "is not a Tier C device and a result from it must not be "
+                    "reported as one"),
+    }
+
+
+def print_calibration(host: HostProfile, correction: dict) -> None:
+    W = 78
+    print("=" * W)
+    print("Tier C emulation calibration".center(W))
+    print("=" * W)
+    print(f"\nhost        {host.machine}")
+    print(f"platform    {host.platform}")
+    print(f"cores       {host.cores_tested} of {host.cores_available} available")
+    print(f"measured    {host.method}")
+    if correction.get("available"):
+        print(f"\nbandwidth   {host.bandwidth_gbs:.2f} GB/s single-stream")
+        print(f"scalar      {host.scalar_mflops:.0f} MFLOP/s")
+        print(f"\nTier C anchor (RPi 5 A76): {PI5_DECODE_TPS} tok/s on a "
+              f"{PI5_MODEL_MB:.0f} MB model")
+        print(f"  implied bandwidth         {correction['pi5_implied_bandwidth_gbs']} GB/s")
+        print("\nthis host vs Tier C")
+        print(f"  bandwidth ratio           {correction['bandwidth_ratio_vs_tier_c']}x")
+        print(f"  core ratio               {correction['core_ratio_vs_tier_c']}x")
+        print(f"  implied decode (0.6B Q4)  {correction['implied_decode_tps_this_host']} tok/s"
+              f"   {correction['status']}")
+        print(f"\n  {correction['to_estimate_tier_c']}")
+        print(f"\n! {correction['warning']}")
+    else:
+        print(f"\ncalibration unavailable: {correction['reason']}")
+        print("constraint still applies, but the correction factor is unknown")
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(
+        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--calibrate", action="store_true",
+                    help="measure this host and report the Tier C correction")
+    ap.add_argument("--cores", type=int, default=None)
+    ap.add_argument("--cpu-percent", type=float, default=None,
+                    help="cap CPU time via cpulimit or a cgroup quota")
+    ap.add_argument("--json", action="store_true")
+    ap.add_argument("command", nargs=argparse.REMAINDER)
+    args = ap.parse_args()
+
+    if args.calibrate or not args.command:
+        host = profile(args.cores)
+        correction = tier_c_correction(host)
+        if args.json:
+            print(json.dumps({"host": asdict(host), "tier_c": correction}, indent=2))
+        else:
+            print_calibration(host, correction)
+        return 0
+
+    cmd = list(args.command)
+    if cmd and cmd[0] == "--":
+        cmd = cmd[1:]
+    if not cmd:
+        ap.error("no command given after --")
+    try:
+        return run_constrained(cmd, args.cores, args.cpu_percent)
+    except RuntimeError as exc:
+        print(f"error: {exc}", file=sys.stderr)
+        return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
