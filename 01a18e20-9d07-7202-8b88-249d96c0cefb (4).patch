new file mode 100644
index 0000000..17df2e2
--- /dev/null
+++ b/vehiclegpt/analytics/leadlag.py
@@ -0,0 +1,398 @@
+"""Lead-lag search: which signal moved first?
+
+"What happened before the battery overheated?" is answered today by a hardcoded
+check on the coolant pump. That works for one question and generalises to none.
+This module asks the general version: given a target signal and a time, which
+other signals moved *before* it, and by how much?
+
+The statistic is lagged Pearson correlation, computed over the overlapping
+region at each lag so that a lag costs sample size rather than bias. The sign
+convention is fixed and tested, because it is the single easiest thing to get
+backwards:
+
+    corr(L) = corr(x[t], y[t + L])
+
+A peak at ``L = +k`` means x's pattern shows up in y k samples later, so **x
+leads y**. :func:`best_lag` returns that ``L``.
+
+Two traps this module takes seriously:
+
+* **Correlation is not causation, and lead-lag makes that worse, not better.**
+  Two signals driven by the same third variable - HVAC draw and battery
+  temperature are both driven by ambient temperature - will show a stable lead
+  that means nothing. There is no statistical fix for that inside a pair; the
+  fix is to look at the mechanism, which is why every result carries the pairs it
+  compared and not just the winner.
+* **Autocorrelated series make ordinary significance testing meaningless.** With
+  1 Hz samples of a slowly varying temperature, neighbouring points are almost
+  duplicates, so a naive p-value will call any lag significant. The null here is
+  built by *circularly shifting* one series: that preserves the autocorrelation
+  and the marginal distribution while destroying the alignment, which is the
+  right question - "is this alignment better than an arbitrary one?"
+"""
+
+from __future__ import annotations
+
+import sqlite3
+
+import numpy as np
+
+from vehiclegpt.analytics import changepoint
+
+#: Fewest overlapping samples for a lagged correlation to be reported at all.
+MIN_OVERLAP = 10
+
+#: Below this many *effective* samples a correlation is reported but marked
+#: unreliable. See :func:`effective_n`.
+MIN_EFFECTIVE_N = 10
+
+
+def _as_1d(values) -> np.ndarray:
+    x = np.asarray(values, dtype=float)
+    if x.ndim != 1:
+        raise ValueError(f"expected a 1-D series, got shape {x.shape}")
+    return x
+
+
+def lag1_autocorrelation(values) -> float:
+    """Correlation between consecutive samples. High for smooth signals."""
+    x = _as_1d(values)
+    if x.size < 3:
+        return 0.0
+    a, b = x[:-1], x[1:]
+    value = _pearson(a, b)
+    return 0.0 if np.isnan(value) else max(min(value, 0.999), -0.999)
+
+
+def effective_n(values) -> float:
+    """How many *independent* samples a smooth series really contains.
+
+    For an AR(1) process this is ``n (1 - phi) / (1 + phi)``. It matters because
+    the trap this module exists to avoid is quantitative, not qualitative: two
+    independent AR(1) series with phi=0.98 and 600 samples show a mean |corr| of
+    0.33 and can reach 0.57, because they contain roughly six independent
+    samples between them. Reporting 0.57 next to "600 samples" would be true and
+    completely misleading, so the count travels with the correlation.
+    """
+    x = _as_1d(values)
+    phi = lag1_autocorrelation(x)
+    return float(x.size) * (1.0 - phi) / (1.0 + phi)
+
+
+def standardize(values) -> np.ndarray:
+    """Centre and scale robustly. A constant series becomes all zeros."""
+    x = _as_1d(values)
+    if x.size == 0:
+        return x
+    centre = float(np.median(x))
+    scale = float(np.median(np.abs(x - centre))) * 1.4826
+    if scale <= 0:
+        spread = float(np.mean(np.abs(x - centre)))
+        scale = spread * 1.2533 if spread > 0 else 0.0
+    if scale <= 0:
+        return np.zeros_like(x)
+    return (x - centre) / scale
+
+
+def _pearson(a: np.ndarray, b: np.ndarray) -> float:
+    if a.size < MIN_OVERLAP:
+        return float("nan")
+    a = a - a.mean()
+    b = b - b.mean()
+    denom = float(np.sqrt((a * a).sum() * (b * b).sum()))
+    if denom == 0.0:
+        return float("nan")
+    return float((a * b).sum() / denom)
+
+
+def cross_correlation(x, y, max_lag: int) -> np.ndarray:
+    """``corr(x[t], y[t+L])`` for L from ``-max_lag`` to ``+max_lag``.
+
+    Index ``i`` of the result corresponds to ``L = i - max_lag``. Entries whose
+    overlap is smaller than :data:`MIN_OVERLAP`, or where either piece is
+    constant, are ``nan`` rather than 0 - "no correlation" and "not enough data
+    to say" are different answers.
+    """
+    x = _as_1d(x)
+    y = _as_1d(y)
+    if x.size != y.size:
+        raise ValueError(f"series lengths differ: {x.size} vs {y.size}")
+    max_lag = int(max_lag)
+    if max_lag < 0:
+        raise ValueError(f"max_lag must be non-negative, got {max_lag}")
+    n = x.size
+    out = np.full(2 * max_lag + 1, np.nan)
+
+    # The cross-product sum for every lag comes from np.correlate, which runs in
+    # C. The per-lag means and variances come from prefix sums, so each lag costs
+    # O(1) on top. Doing this per lag in Python made a surrogate-tested search
+    # take 44 s; it is the difference between a table and a hang.
+    #
+    # Mapping, verified in test_cross_correlation_matches_a_direct_computation:
+    #   np.correlate(y, x, "full")[(n - 1) + L] == sum_i x[i] * y[i + L]
+    raw = np.correlate(y, x, mode="full")
+    px = np.concatenate(([0.0], np.cumsum(x)))
+    py = np.concatenate(([0.0], np.cumsum(y)))
+    pxx = np.concatenate(([0.0], np.cumsum(x * x)))
+    pyy = np.concatenate(([0.0], np.cumsum(y * y)))
+
+    for lag in range(-max_lag, max_lag + 1):
+        if lag >= 0:
+            i0, i1 = 0, n - lag          # x[i0:i1] against y[i0+lag:i1+lag]
+        else:
+            i0, i1 = -lag, n
+        count = i1 - i0
+        if count < MIN_OVERLAP:
+            continue
+        j0, j1 = i0 + lag, i1 + lag
+        sx = px[i1] - px[i0]
+        sy = py[j1] - py[j0]
+        vx = (pxx[i1] - pxx[i0]) - sx * sx / count
+        vy = (pyy[j1] - pyy[j0]) - sy * sy / count
+        if vx <= 0 or vy <= 0:
+            continue
+        sxy = raw[(n - 1) + lag]
+        out[lag + max_lag] = (sxy - sx * sy / count) / float(np.sqrt(vx * vy))
+    return out
+
+
+def best_lag(x, y, max_lag: int) -> tuple[int, float]:
+    """The lag with the strongest correlation, and its coefficient.
+
+    Positive lag means **x leads y**. Returns ``(0, nan)`` when nothing can be
+    computed, so callers can test with ``np.isnan`` rather than for ``None``.
+    """
+    corr = cross_correlation(x, y, max_lag)
+    if not np.any(~np.isnan(corr)):
+        return 0, float("nan")
+    index = int(np.nanargmax(np.abs(corr)))
+    return index - int(max_lag), float(corr[index])
+
+
+def surrogate_p_value(x, y, max_lag: int, observed: float | None = None,
+                      shifts: int = 64, seed: int = 0) -> float:
+    """How often a circularly shifted alignment beats the real one.
+
+    Shifting ``y`` by a large offset keeps its autocorrelation and its
+    distribution intact and breaks only the alignment, which is exactly the null
+    a naive p-value fails to construct. The returned value is the fraction of
+    shifts whose best ``|corr|`` is at least the observed one, with the usual
+    ``(1 + k) / (1 + n)`` smoothing so it is never exactly zero.
+
+    Deterministic for a given seed.
+    """
+    x = standardize(x)
+    y = standardize(y)
+    n = x.size
+    if n < MIN_OVERLAP:
+        return 1.0
+    if observed is None:
+        observed = abs(best_lag(x, y, max_lag)[1])
+    if np.isnan(observed):
+        return 1.0
+
+    rng = np.random.default_rng(seed)
+    lo = max(max_lag + 1, MIN_OVERLAP)
+    if n - lo <= lo:
+        return 1.0
+    hits = 0
+    for _ in range(shifts):
+        offset = int(rng.integers(lo, n - lo))
+        shifted = np.roll(y, offset)
+        value = abs(best_lag(x, shifted, max_lag)[1])
+        hits += bool(value >= observed)
+    return (1 + hits) / (1 + shifts)
+
+
+def lead_lag_table(series: dict[str, list[float]], target: str, max_lag: int,
+                   sample_s: float = 1.0) -> list[dict]:
+    """Every candidate against one target, with lead time and a null test.
+
+    ``series`` maps a path to an equally spaced, equally lengthed series. The
+    caller is responsible for alignment - :func:`align` does it from the store.
+    """
+    if target not in series:
+        raise KeyError(f"target {target!r} is not among the series")
+    y = standardize(series[target])
+    out: list[dict] = []
+    for path, values in series.items():
+        if path == target:
+            continue
+        x = standardize(values)
+        lag, corr = best_lag(x, y, max_lag)
+        if np.isnan(corr):
+            continue
+        n_eff = min(effective_n(values), effective_n(series[target]))
+        out.append({
+            "signal": path,
+            "lag_samples": lag,
+            "lead_s": lag * sample_s,
+            "correlation": round(corr, 4),
+            "p_value": round(surrogate_p_value(x, y, max_lag, abs(corr)), 4),
+            "n_eff": round(n_eff, 1),
+            "reliable": n_eff >= MIN_EFFECTIVE_N,
+        })
+    # Strongest first, then longest lead: a weak short lead is not a precursor.
+    out.sort(key=lambda r: (-abs(r["correlation"]), -r["lead_s"]))
+    return out
+
+
+def align(series: dict[str, list[tuple[int, float]]], start_s: int, end_s: int
+          ) -> tuple[dict[str, list[float]], float]:
+    """Put irregular, on-change signals on one 1 Hz grid by forward-filling.
+
+    Forward fill is the correct semantics for a sensor: between two reported
+    values the last one is still what the sensor said. Interpolating would invent
+    readings, and dropping to the common timestamps would silently compare
+    different windows for different signals.
+
+    Returns the aligned series and the sample period in seconds.
+    """
+    grid = np.arange(start_s, end_s + 1, 1, dtype=np.int64)
+    aligned: dict[str, list[float]] = {}
+    for path, points in series.items():
+        if not points:
+            continue
+        times = np.array([p[0] for p in points], dtype=np.int64)
+        values = np.array([p[1] for p in points], dtype=float)
+        order = np.argsort(times)
+        times, values = times[order], values[order]
+        idx = np.searchsorted(times, grid, side="right") - 1
+        idx = np.clip(idx, 0, len(times) - 1)
+        aligned[path] = values[idx].tolist()
+    return aligned, 1.0
+
+
+def onset(values, sample_s: float = 1.0, min_delta: float = 0.0,
+          skip_s: float = 60.0, settled_s: float = 300.0) -> int | None:
+    """Index of the first meaningful level change, or ``None`` if the series is flat.
+
+    Correlation and onset answer different questions and disagree on smooth
+    data. A temperature that ramps for twenty minutes has an onset — the moment
+    it started climbing — but its *level* correlates with everything else that
+    drifts, and its effective sample size is a handful. Onset survives both
+    problems because it only asks where the series changed, not how similar two
+    drifting lines look.
+    """
+    x = _as_1d(values)
+    if x.size < 8:
+        return None
+    segments = changepoint.segments(x, min_delta=min_delta)
+    # A change in the opening seconds is the window starting, not the vehicle
+    # doing something: every signal begins somewhere. Without this the drive
+    # start wins for all eighteen signals and the "precursor" list is simply a
+    # list of everything the car has.
+    first_index = int(max(skip_s / sample_s, 0))
+    settled = int(max(settled_s / sample_s, 1))
+    for previous, segment in zip(segments, segments[1:], strict=False):
+        start = int(segment["start"])
+        if start < first_index:
+            continue
+        # A precursor is a departure from a *settled* state. Requiring the
+        # preceding segment to have lasted a few minutes is what separates
+        # "this signal changed" from "this signal has been changing all along",
+        # and it is why a duty-cycled fault (the coolant pump toggling before it
+        # fails) does not register here at all: nothing was ever settled.
+        if int(previous["length"]) >= settled:
+            return start
+    return None
+
+
+def _fetch(conn: sqlite3.Connection, path: str, lo_s: int,
+           hi_s: int) -> list[tuple[int, float]]:
+    row = conn.execute("SELECT id FROM signal WHERE path = ?", (path,)).fetchone()
+    if row is None:
+        return []
+    return [(int(r["ts_s"]), float(r["value"])) for r in conn.execute(
+        "SELECT ts_s, value FROM sample WHERE signal_id = ? AND ts_s BETWEEN ? AND ? "
+        "ORDER BY ts_s", (row["id"], lo_s, hi_s))]
+
+
+def precursors(conn: sqlite3.Connection, target: str, at_ns: int,
+               window_s: int = 1800, max_lag_s: int = 600,
+               candidates: list[str] | None = None,
+               min_abs_corr: float = 0.3,
+               min_delta: float = 0.0,
+               settled_s: float = 300.0,
+               crowd_s: float = 10.0) -> dict:
+    """Which signals led ``target`` in the window before ``at_ns``.
+
+    Returns ``{"table": [...], "precursors": [...], "window_s": ..., "n_eff": ...}``
+    where ``precursors`` is the subset that actually leads (positive lag) with a
+    correlation above ``min_abs_corr``. The full table is returned as well, so a
+    reader can see what was compared and rejected instead of only the winner.
+
+    Candidates default to every signal in the store, which is the honest default:
+    choosing the candidate list after seeing the answer is how a lead-lag search
+    becomes a story.
+    """
+    end_s = int(at_ns / 1e9)
+    start_s = end_s - int(window_s)
+
+    # Anchor to the current drive. Between drives every signal is absent, so a
+    # window straddling the start of the drive makes "the car started" the
+    # largest change in all eighteen signals - which is true, useless, and
+    # identical for everything compared.
+    drive = conn.execute(
+        "SELECT start_ns FROM drive WHERE start_ns <= ? AND end_ns >= ? "
+        "ORDER BY start_ns DESC LIMIT 1", (int(at_ns), int(at_ns))).fetchone()
+    if drive is not None:
+        start_s = max(start_s, int(drive["start_ns"] / 1e9) + 60)
+
+    if end_s - start_s < 2 * MIN_OVERLAP:
+        raise ValueError("window is too short to compare anything")
+
+    paths = candidates or [r["path"] for r in conn.execute("SELECT path FROM signal")]
+    series = {path: _fetch(conn, path, start_s, end_s) for path in paths}
+    series = {p: v for p, v in series.items() if len(v) >= 4}
+    if target not in series:
+        raise ValueError(f"target {target!r} has no samples in the window")
+
+    aligned, sample_s = align(series, start_s, end_s)
+    max_lag = max(1, int(max_lag_s / sample_s))
+    table = lead_lag_table(aligned, target, max_lag, sample_s=sample_s)
+
+    # Precedence: when each series changed, relative to the target's own change.
+    skip_s = max(60.0, 0.05 * window_s)
+    target_onset = onset(aligned[target], sample_s, min_delta=min_delta, skip_s=skip_s,
+                         settled_s=settled_s)
+    by_name = {row["signal"]: row for row in table}
+    for path, row in by_name.items():
+        index = onset(aligned[path], sample_s, min_delta=min_delta, skip_s=skip_s,
+                      settled_s=settled_s)
+        row["onset_s"] = None if index is None else start_s + index * sample_s
+        # Lead against the event the caller asked about, which is usually the
+        # warning rather than the target signal's own turn.
+        row["lead_s"] = None if index is None else end_s - row["onset_s"]
+        row["onset_lead_s"] = (None if index is None or target_onset is None
+                               else (target_onset - index) * sample_s)
+
+    # Onset detection does not inherit the correlation's sample-size problem: it
+    # asks where a series changed, not how similar two drifting lines look. So
+    # `reliable` gates the correlation coefficient only, and a smooth signal can
+    # still have a trustworthy onset.
+    leading = [row for row in table
+               if row["lead_s"] is not None and row["lead_s"] > 0]
+    leading.sort(key=lambda r: (-abs(r["correlation"]), -r["lead_s"]))
+
+    # Say when the answer is a crowd. Several signals departing together usually
+    # means one shared driver moved them all, and picking the first of them is
+    # arbitrary rather than causal.
+    ambiguity = 0
+    if len(leading) >= 3:
+        onsets = sorted(r["onset_s"] for r in leading)
+        ambiguity = sum(1 for a in onsets
+                        if sum(1 for b in onsets if abs(b - a) <= crowd_s) >= 3)
+
+    # Signals that never settle have no onset to date: a duty-cycled fault is
+    # invisible to precedence by construction. They are returned rather than
+    # dropped, because "not dated" is not the same as "not involved" - the
+    # coolant pump in the 2026-03-11 overheat is exactly this case.
+    unsettled = [row for row in table if row["onset_s"] is None]
+    unsettled.sort(key=lambda r: -abs(r["correlation"]))
+
+    return {"table": table, "precursors": leading, "unsettled": unsettled,
+            "crowded": ambiguity > 0, "crowd_size": ambiguity,
+            "target_onset_s": (None if target_onset is None
+                               else start_s + target_onset * sample_s),
+            "window_s": window_s, "target": target, "at_ns": int(at_ns)}
diff --git a/vehiclegpt/analytics/queries.py b/vehiclegpt/analytics/queries.py
new file mode 100644
index 0000000..fb603d7
--- /dev/null
+++ b/vehiclegpt/analytics/queries.py
@@ -0,0 +1,433 @@
+"""Deterministic query layer.
+
+Five questions from the case study, answered with SQL and arithmetic. No model
+is involved, which is the point: on the constrained tier this is the only way
+the 2-second target is met at all (see docs/10), and for filter/aggregate
+questions the model would add nothing but latency and the chance of getting a
+number wrong.
+
+Two rules the handlers follow:
+
+1. **Never use harness metadata as evidence.** ``event.kind`` values beginning
+   ``fault.`` record what the *simulator* injected. An answer built from them
+   would be circular - the analytics layer would be reading the answer key. The
+   precursor for the overheat question is found by looking at the coolant pump
+   signal and noticing it stopped, which is what a real vehicle would give you.
+
+2. **Report the mean speed alongside consumption.** "City is worse than
+   motorway" is only meaningful if you know the city mean speed was 24 kph; a
+   ratio without its conditions invites a wrong conclusion.
+"""
+
+from __future__ import annotations
+
+import datetime as dt
+import sqlite3
+from dataclasses import dataclass, field
+
+from vehiclegpt.analytics import changepoint, dsl
+
+EVIDENCE_KIND_PREFIX = "fault."
+
+#: Pack temperature that counts as "rising" in the precursor answer. Named rather
+#: than inlined so the sentence and the threshold cannot drift apart.
+TEMP_RISE_C = 55.0
+
+
+@dataclass
+class Answer:
+    intent: str
+    path: str
+    text: str
+    data: dict = field(default_factory=dict)
+    evidence: list[dict] = field(default_factory=list)
+    caveats: list[str] = field(default_factory=list)
+
+    def to_dict(self) -> dict:
+        return {
+            "intent": self.intent, "path": self.path, "text": self.text,
+            "data": self.data, "evidence": self.evidence, "caveats": self.caveats,
+        }
+
+
+# ---------------------------------------------------------------------------
+# helpers
+# ---------------------------------------------------------------------------
+
+def _day_ns(day: str) -> int:
+    return int(dt.datetime.fromisoformat(day).replace(
+        tzinfo=dt.UTC).timestamp() * 1e9)
+
+
+def _fmt_day(day: str) -> str:
+    d = dt.date.fromisoformat(day)
+    return d.strftime("%a %d %b")
+
+
+def _signal_id(conn: sqlite3.Connection, path: str) -> int | None:
+    row = conn.execute("SELECT id FROM signal WHERE path = ?", (path,)).fetchone()
+    return None if row is None else int(row["id"])
+
+
+def _series(conn: sqlite3.Connection, path: str, lo_ns: int,
+            hi_ns: int) -> list[tuple[int, float]]:
+    from vehiclegpt.store.db import series_ns
+
+    return series_ns(conn, path, lo_ns, hi_ns)
+
+
+def _drive_hours(conn: sqlite3.Connection, lo_ns: int, hi_ns: int) -> float:
+    row = conn.execute(
+        "SELECT COALESCE(SUM(end_ns - start_ns), 0) AS ns FROM segment "
+        "WHERE start_ns BETWEEN ? AND ?", (lo_ns, hi_ns)).fetchone()
+    return float(row["ns"]) / 3.6e12
+
+
+def _pct(new: float, old: float) -> float:
+    return (new - old) / old * 100.0 if old else float("nan")
+
+
+# ---------------------------------------------------------------------------
+# Q1: why has my range reduced?
+# ---------------------------------------------------------------------------
+
+def _history(conn: sqlite3.Connection) -> tuple[str, str]:
+    """First and last day with a daily rollup - the window the store covers."""
+    row = conn.execute("SELECT MIN(day) AS lo, MAX(day) AS hi FROM daily").fetchone()
+    if row is None or row["lo"] is None:
+        raise LookupError("the store has no daily rollups yet")
+    return row["lo"], row["hi"]
+
+
+def _window_stats(conn: sqlite3.Connection, start_day: str, end_day: str) -> dict:
+    """Distance, energy, driving hours and mean HVAC/ambient draw over a window.
+
+    The arithmetic lives here, but the aggregation is the DSL's: a single
+    compiled statement returns both windows, so the definition of "consumption
+    over a window" cannot drift between them.
+    """
+    query = dsl.build(dsl.Kind.CONSUMPTION_TREND, start_day, end_day, baseline_days=0)
+    row = dsl.run(conn, query)[0]
+    return _stats_from(row, "a")
+
+
+def _stats_from(row: dict, prefix: str) -> dict:
+    """Turn one half of a ``consumption_trend`` row into a stats dict."""
+    km = float(row[f"{prefix}_km"] or 0.0)
+    wh = float(row[f"{prefix}_wh"] or 0.0)
+    hours = float(row[f"{prefix}_drive_ns"] or 0) / 3.6e12
+    hvac_w = float(row[f"{prefix}_hvac_w"] or 0.0)
+    return {
+        "days": int(row[f"{prefix}_days"] or 0), "distance_km": km, "energy_wh": wh,
+        "wh_per_km": wh / km if km else float("nan"),
+        "hours": hours, "hvac_w": hvac_w,
+        "ambient_c": float(row[f"{prefix}_ambient_c"] or 0.0),
+        # W * h / km = Wh/km: the HVAC energy attributable to each kilometre.
+        "hvac_wh_per_km": (hvac_w * hours / km) if km else float("nan"),
+    }
+
+
+def _shift_day(day: str, delta: int) -> str:
+    return (dt.date.fromisoformat(day) + dt.timedelta(days=delta)).isoformat()
+
+
+def range_reduction(conn: sqlite3.Connection) -> Answer:
+    """Decompose the consumption increase into HVAC and the remainder.
+
+    The HVAC share is *computed* - mean draw in watts times hours driven divided
+    by kilometres - in both windows, and the difference is attributed. An
+    earlier version of this function used a hardcoded fraction, which is
+    indistinguishable from making the number up.
+    """
+    row = conn.execute(
+        "SELECT * FROM v_daily_rolling WHERE prior7_days >= 7 "
+        "ORDER BY day DESC LIMIT 1").fetchone()
+    if row is None:
+        return Answer("range_reduction", "P0",
+                      "Not enough history to compare two weeks yet.",
+                      caveats=["need at least 14 days of data"])
+
+    day = row["day"]
+    # Both windows come from a single compiled statement: the window and the
+    # baseline it is compared against cannot disagree about what "consumption
+    # over a period" means.
+    query = dsl.build(dsl.Kind.CONSUMPTION_TREND, _shift_day(day, -6), day,
+                      baseline_days=7)
+    both = dsl.run(conn, query)[0]
+    cur, prior = _stats_from(both, "a"), _stats_from(both, "b")
+
+    delta = cur["wh_per_km"] - prior["wh_per_km"]
+    hvac_delta = cur["hvac_wh_per_km"] - prior["hvac_wh_per_km"]
+    share_now = (cur["hvac_wh_per_km"] / cur["wh_per_km"] * 100.0
+                 if cur["wh_per_km"] else float("nan"))
+    share_before = (prior["hvac_wh_per_km"] / prior["wh_per_km"] * 100.0
+                    if prior["wh_per_km"] else float("nan"))
+
+    # The HVAC delta can exceed the total delta: heating is an always-positive
+    # load while recuperation varies, so the two are not a clean decomposition.
+    # Say so instead of forcing the residual to come out positive.
+    if hvac_delta > delta > 0:
+        closing = ("Heating alone would explain more than the observed increase; "
+                   "part of it is offset by lower average speeds in the cold.")
+    elif delta > 0:
+        closing = (f"The remaining {delta - hvac_delta:+.0f} Wh/km is consistent "
+                   "with higher battery and drivetrain losses at low temperature.")
+    else:
+        closing = "Consumption did not rise over this window."
+
+    text = (
+        f"Consumption over the last 7 days averaged {cur['wh_per_km']:.0f} Wh/km, "
+        f"up from {prior['wh_per_km']:.0f} Wh/km the week before "
+        f"({_pct(cur['wh_per_km'], prior['wh_per_km']):+.0f}%). "
+        f"Mean ambient temperature fell from {prior['ambient_c']:.1f} C to "
+        f"{cur['ambient_c']:.1f} C. HVAC draw rose from {prior['hvac_w']:.0f} W to "
+        f"{cur['hvac_w']:.0f} W, which is {cur['hvac_wh_per_km']:.0f} Wh/km "
+        f"({share_now:.0f}% of consumption) against "
+        f"{prior['hvac_wh_per_km']:.0f} Wh/km ({share_before:.0f}%) before. {closing}"
+    )
+    return Answer(
+        intent="range_reduction", path="P0", text=text,
+        data={"recent": cur, "baseline": prior,
+              "delta_wh_per_km": round(delta, 1),
+              "hvac_delta_wh_per_km": round(hvac_delta, 1),
+              "hvac_share_now_pct": round(share_now, 1),
+              "hvac_share_before_pct": round(share_before, 1)},
+        evidence=[dict(row)],
+        caveats=["temperature and HVAC draw move together, so the split is an "
+                 "attribution rather than a controlled decomposition"])
+
+
+# ---------------------------------------------------------------------------
+# Q2: when did efficiency drop most?
+# ---------------------------------------------------------------------------
+
+def efficiency_largest_drop(conn: sqlite3.Connection, min_km: float = 10.0) -> Answer:
+    """The single day with the largest consumption increase over the day before.
+
+    Day-over-day, not a trailing-week comparison. A trailing window peaks on the
+    last day it can see rather than on the day the change happened, so it
+    answers "when did the rolling week end" instead of "when did efficiency
+    drop". Days below ``min_km`` are excluded because a short errand is noisy.
+    """
+    lo, hi = _history(conn)
+    hits = dsl.run(conn, dsl.build(dsl.Kind.EFFICIENCY_DROP, lo, hi, min_km=min_km))
+    row = dict(hits[0]) if hits else None
+    if row is not None:
+        row["delta"] = row["delta_wh_per_km"]
+    if row is None:
+        return Answer("efficiency_largest_drop", "P0",
+                      "Not enough comparable days yet.",
+                      caveats=["need at least two days with meaningful distance"])
+
+    ctx = conn.execute(
+        "SELECT ma7_wh_per_km, prior7_wh_per_km FROM v_daily_rolling "
+        "WHERE day >= ? ORDER BY day LIMIT 1", (row["day"],)).fetchone()
+
+    text = (
+        f"Consumption jumped on {_fmt_day(row['day'])}: "
+        f"{row['wh_per_km']:.0f} Wh/km against {row['prev_wh_per_km']:.0f} Wh/km "
+        f"the day before, an increase of {row['delta']:.0f} Wh/km "
+        f"({_pct(row['wh_per_km'], row['prev_wh_per_km']):+.0f}%). "
+        f"Ambient temperature went from {row['prev_ambient_c']:.1f} C to "
+        f"{row['ambient_c']:.1f} C over the same step."
+    )
+    data = {"day": row["day"], "wh_per_km": round(row["wh_per_km"], 1),
+            "prior_wh_per_km": round(row["prev_wh_per_km"], 1),
+            "delta_wh_per_km": round(row["delta"], 1),
+            # Registered because the sentence prints it: a derived number that
+            # exists only in an f-string cannot be traced back to anything.
+            "delta_pct": round(_pct(row["wh_per_km"], row["prev_wh_per_km"]), 1),
+            "ambient_c": round(row["ambient_c"], 1),
+            "prior_ambient_c": round(row["prev_ambient_c"], 1)}
+    if ctx is not None:
+        data["trailing_week_wh_per_km"] = round(ctx["ma7_wh_per_km"], 1)
+        data["prior_week_wh_per_km"] = (
+            None if ctx["prior7_wh_per_km"] is None
+            else round(ctx["prior7_wh_per_km"], 1))
+    return Answer(
+        intent="efficiency_largest_drop", path="P0", text=text, data=data,
+        evidence=[dict(row)],
+        caveats=[f"days under {min_km:.0f} km excluded as unrepresentative"])
+
+
+# ---------------------------------------------------------------------------
+# Q3: ADAS disengagements from yesterday
+# ---------------------------------------------------------------------------
+
+def adas_events(conn: sqlite3.Connection, day: str | None = None) -> Answer:
+    if day is None:
+        day = conn.execute(
+            "SELECT date(MAX(ts_ns) / 1000000000, 'unixepoch') AS d FROM event"
+        ).fetchone()["d"]
+    rows = dsl.run(conn, dsl.build(dsl.Kind.ADAS_EVENTS, day, day))
+
+    if not rows:
+        text = f"No ADAS disengagement events recorded on {_fmt_day(day)}."
+    else:
+        times = ", ".join(r["time_utc"] for r in rows)
+        text = (f"{len(rows)} ADAS disengagement event"
+                f"{'s' if len(rows) != 1 else ''} on {_fmt_day(day)} at "
+                f"{times} UTC.")
+    return Answer(
+        intent="adas_events", path="P0", text=text,
+        data={"day": day, "count": len(rows)},
+        evidence=rows)
+
+
+# ---------------------------------------------------------------------------
+# Q4: what happened before the battery overheating warning?
+# ---------------------------------------------------------------------------
+
+MIN_STALL_S = 60.0
+
+
+def _sustained_stall(series: list[tuple[int, float]],
+                     threshold_pct: float = 0.5,
+                     min_s: float = MIN_STALL_S) -> int | None:
+    """First time a pump reading hits ~zero and *stays* there.
+
+    A coolant pump legitimately drops to zero when the car is stationary, so the
+    first >5% -> 0% transition is usually a red light. Requiring the zero to
+    persist separates a stall from a traffic stop - and unlike reading the
+    simulator's injected-fault event, it works on real vehicle data.
+    """
+    found = changepoint.sustained_below(series, threshold_pct, min_s)
+    return None if found is None else found[0]
+
+
+def before_warning(conn: sqlite3.Connection, lookback_min: int = 60) -> Answer:
+    """Reconstruct the precursor sequence from the signals, not the event log.
+
+    ``fault.*`` events are excluded on purpose: they exist only because the
+    simulator wrote them, and building an answer from them would be circular.
+    The precursor here is found by noticing the coolant pump stopped - which is
+    what a real vehicle would give you.
+    """
+    warn = conn.execute(
+        "SELECT * FROM event WHERE severity = 'warning' AND kind NOT LIKE ? "
+        "ORDER BY ts_ns DESC LIMIT 1", (EVIDENCE_KIND_PREFIX + "%",)).fetchone()
+    if warn is None:
+        warn = conn.execute(
+            "SELECT * FROM event WHERE severity = 'critical' AND kind NOT LIKE ? "
+            "ORDER BY ts_ns DESC LIMIT 1", (EVIDENCE_KIND_PREFIX + "%",)).fetchone()
+    if warn is None:
+        return Answer("before_warning", "P0",
+                      "No warning or critical events recorded.",
+                      caveats=["no warning in the retained history"])
+
+    lo = warn["ts_ns"] - lookback_min * 60 * 10**9
+    pump = _series(conn, "thermal.coolant_pump", lo, warn["ts_ns"])
+    temp = _series(conn, "battery.cell_temp_max", lo, warn["ts_ns"])
+
+    stall_ns = _sustained_stall(pump)
+    rise_ns = next((ts for ts, v in temp if v >= TEMP_RISE_C), None)
+
+    parts = []
+    if stall_ns is not None:
+        lead = (warn["ts_ns"] - stall_ns) / 6e10
+        parts.append(f"the coolant pump stopped for good at {_clock(stall_ns)}, "
+                     f"{lead:.0f} minutes earlier")
+    if rise_ns is not None:
+        parts.append(f"pack temperature passed {TEMP_RISE_C:.0f} C at "
+                     f"{_clock(rise_ns)}")
+    parts.append(f"the overheating warning was raised at {_clock(warn['ts_ns'])}")
+
+    caveats = []
+    if stall_ns is None:
+        caveats.append("no sustained pump stall in the lookback window")
+    return Answer(
+        intent="before_warning", path="P0",
+        text="Before the battery overheating warning: " + "; ".join(parts) + ".",
+        data={"warning_kind": warn["kind"],
+              "warning_time": _clock(warn["ts_ns"]),
+              "stall_time": _clock(stall_ns) if stall_ns else None,
+              "lead_minutes": (round((warn["ts_ns"] - stall_ns) / 6e10, 1)
+                               if stall_ns else None),
+              "rise_threshold_c": TEMP_RISE_C,
+              "rise_time": _clock(rise_ns) if rise_ns else None,
+              "lookback_min": lookback_min},
+        evidence=[dict(warn)],
+        caveats=caveats)
+
+
+def _clock(ts_ns: int) -> str:
+    return dt.datetime.fromtimestamp(ts_ns / 1e9, dt.UTC).strftime("%H:%M UTC")
+
+
+# ---------------------------------------------------------------------------
+# Q5: city vs highway
+# ---------------------------------------------------------------------------
+
+def city_vs_highway(conn: sqlite3.Connection) -> Answer:
+    lo, hi = _history(conn)
+    rows = {r["regime"]: r
+            for r in dsl.run(conn, dsl.build(dsl.Kind.REGIME_COMPARE, lo, hi))}
+    city, hwy = rows.get("city"), rows.get("highway")
+    if not city or not hwy:
+        return Answer("city_vs_highway", "P0",
+                      "Not enough segmented driving to compare regimes.",
+                      caveats=["need both city and motorway segments"])
+
+    ratio = hwy["wh_per_km"] / city["wh_per_km"]
+    faster = "motorway" if ratio > 1 else "city"
+    text = (
+        f"City driving averaged {city['wh_per_km']:.0f} Wh/km over "
+        f"{city['distance_km']:.1f} km at a mean {city['mean_speed_kph']:.0f} kph. "
+        f"Motorway driving averaged {hwy['wh_per_km']:.0f} Wh/km over "
+        f"{hwy['distance_km']:.1f} km at a mean {hwy['mean_speed_kph']:.0f} kph. "
+        f"{faster.capitalize()} driving is the more expensive of the two here, by "
+        f"a factor of {max(ratio, 1 / ratio):.2f}."
+    )
+    return Answer(
+        intent="city_vs_highway", path="P0", text=text,
+        data={"city": city, "highway": hwy, "highway_over_city": round(ratio, 3),
+              "spread_factor": round(max(ratio, 1 / ratio), 2)},
+        evidence=[city, hwy],
+        caveats=["regimes are classified from speed thresholds (5 / 80 kph); "
+                 "a slow motorway queue is counted as city",
+                 "energy is attributed per segment, so acceleration across a "
+                 "regime boundary counts toward the segment it started in; a "
+                 "per-second attribution gives a lower city/highway factor"])
+
+
+# ---------------------------------------------------------------------------
+# Routing
+# ---------------------------------------------------------------------------
+
+INTENTS: dict[str, tuple[tuple[str, ...], callable]] = {
+    "das_events": (("adas", "disengag"), adas_events),
+    "before_warning": (("before", "warning"), before_warning),
+    "before_warning_b": (("overheat",), before_warning),
+    "city_vs_highway": (("city", "highway"), city_vs_highway),
+    "efficiency_drop": (("efficien", "drop"), efficiency_largest_drop),
+    "efficiency_drop_b": (("largest", "drop"), efficiency_largest_drop),
+    "range_reduction": (("range", "reduc"), range_reduction),
+    "range_reduction_b": (("range", "why"), range_reduction),
+}
+
+
+def classify(question: str) -> str | None:
+    """Rule-based intent routing. No model, so it is free and deterministic.
+
+    This is the part of the system an LLM would normally do. It is a keyword
+    matcher instead because intent classification over five known query shapes
+    does not need a language model, and because on the constrained tier every
+    millisecond spent here is taken from a budget that is already blown.
+    """
+    q = " ".join(question.lower().split())
+    for intent, (keywords, _) in INTENTS.items():
+        if all(k in q for k in keywords):
+            return intent.rstrip("_b")
+    return None
+
+
+def answer(conn: sqlite3.Connection, question: str) -> Answer:
+    intent = classify(question)
+    if intent is None:
+        return Answer(
+            "unknown", "escalate",
+            "I could not map that to a known query. Escalating to the language "
+            "model would cost several seconds on constrained hardware.",
+            caveats=["no deterministic handler for this question"])
+    handler = next(fn for name, (_, fn) in INTENTS.items() if name.rstrip("_b") == intent)
+    return handler(conn)
diff --git a/vehiclegpt/analytics/retrieval.py b/vehiclegpt/analytics/retrieval.py
new file mode 100644
index 0000000..22fab3c
--- /dev/null
+++ b/vehiclegpt/analytics/retrieval.py
@@ -0,0 +1,134 @@
+"""Card storage and lexical retrieval over it.
+
+Retrieval searches episode *cards*, not samples or events. That is the design
+decision the whole layer exists for: on a device with 2 GB of memory you cannot
+embed a million samples, but a few hundred cards fit in an index and in cache.
+
+**What is implemented here is BM25 only.** The roadmap pairs FTS5 with a dense
+vector index and fuses them with reciprocal rank fusion; the dense half needs
+`bge-small-en-v1.5`, and HuggingFace is unreachable from the build sandbox, so
+it is not implemented rather than faked. :func:`reciprocal_rank_fusion` is
+written and tested against synthetic rankings so that adding the dense side later
+is a plug-in rather than a redesign - but no number in this repository is
+measured on a dense index that does not exist.
+
+**The query is data, not syntax.** FTS5 has its own query language: `NEAR`,
+`AND`, `*`, `:`, and quoted phrases. Passing user text straight into `MATCH`
+lets that language through, so a question containing `NEAR(` becomes a syntax
+error at best and a different query than the user asked at worst. Every token is
+therefore quoted, which makes it a literal - the same principle as the DSL's
+"the SQL is a function of the kind alone".
+"""
+
+from __future__ import annotations
+
+import json
+import re
+import sqlite3
+
+from vehiclegpt.analytics.episodes import Episode, distill
+
+#: Runs of word characters and apostrophes; everything else separates tokens.
+_TOKEN = re.compile(r"[\w']+", re.UNICODE)
+
+#: Function words that carry no retrieval signal.
+#:
+#: This list is not decoration. With three cards, BM25's inverse document
+#: frequency has almost nothing to work with, so a query like "when did the
+#: coolant pump fail" matched a consumption card purely on "the" and "when" -
+#: a confident-looking result with nothing behind it. A stopword list is a blunt
+#: instrument, but it is the right one at this scale; IDF does the same job once
+#: the corpus is large, and the two compose.
+STOPWORDS = frozenset((
+    "a", "an", "and", "are", "as", "at",
+    "be", "been", "before", "but", "by", "did",
+    "do", "does", "for", "from", "had", "has",
+    "have", "how", "i", "if", "in", "into",
+    "is", "it", "its", "me", "my", "of",
+    "on", "or", "our", "over", "so", "than",
+    "that", "the", "their", "them", "then", "there",
+    "these", "they", "this", "to", "was", "we",
+    "were", "what", "when", "where", "which", "who",
+    "why", "will", "with", "would", "you", "your",
+))
+
+
+def fts_query(text: str) -> str:
+    """Turn free text into a safe FTS5 MATCH expression.
+
+    Each token becomes a quoted literal joined with OR, so a deployment can
+    retrieve anything containing *any* of the words rather than requiring all of
+    them. Quoting is what stops operator syntax in the input from being
+    interpreted.
+    """
+    tokens = [t for t in _TOKEN.findall(text)
+              if (len(t) > 1 or t.isdigit()) and t.lower() not in STOPWORDS]
+    if not tokens:
+        return ""
+    quoted = []
+    for token in tokens:
+        escaped = token.replace('"', '""')
+        quoted.append(f'"{escaped}"')
+    return " OR ".join(quoted)
+
+
+def build_cards(conn: sqlite3.Connection) -> int:
+    """Distil episodes into the `card` table and rebuild the FTS index.
+
+    Cards are derived data, so this is idempotent: rebuilding produces the same
+    rows, and the FTS index is rebuilt from the content table rather than
+    patched, so it cannot drift out of sync with the cards it indexes.
+    """
+    episodes: list[Episode] = distill(conn)
+    conn.execute("DELETE FROM card")
+    conn.executemany(
+        "INSERT INTO card (kind, start_ns, end_ns, day, severity, title, body, "
+        "signals, evidence) VALUES (?,?,?,?,?,?,?,?,?)",
+        [e.to_row() for e in episodes])
+    conn.execute("INSERT INTO card_fts(card_fts) VALUES('rebuild')")
+    conn.commit()
+    return len(episodes)
+
+
+def search(conn: sqlite3.Connection, text: str, limit: int = 8,
+           kind: str | None = None) -> list[dict]:
+    """BM25 search over cards. Empty result for empty or unmatched text."""
+    match = fts_query(text)
+    if not match:
+        return []
+    sql = ("SELECT c.id, c.kind, c.day, c.severity, c.title, c.body, c.signals, "
+           "       c.evidence, bm25(card_fts) AS rank "
+           "FROM card_fts JOIN card c ON c.id = card_fts.rowid "
+           "WHERE card_fts MATCH ?")
+    params: list = [match]
+    if kind:
+        sql += " AND c.kind = ?"
+        params.append(kind)
+    sql += " ORDER BY rank LIMIT ?"       # bm25() is negative-better; ascending is best first
+    params.append(limit)
+    out = []
+    for row in conn.execute(sql, params):
+        record = dict(row)
+        record["evidence"] = json.loads(record["evidence"])
+        out.append(record)
+    return out
+
+
+def reciprocal_rank_fusion(*rankings: list, k: int = 60, limit: int = 8) -> list:
+    """Fuse ranked id lists: ``score(d) = sum(1 / (k + rank))``.
+
+    Implemented and tested now so the dense side can be added without changing
+    anything downstream. ``k=60`` is the value from the original Cormack et al.
+    paper; it damps the influence of very high ranks, which is what makes RRF
+    work when the two retrievers disagree.
+    """
+    scores: dict = {}
+    for ranking in rankings:
+        seen: set = set()
+        for position, item in enumerate(ranking):
+            key = item if isinstance(item, (int, str)) else item[0]
+            if key in seen:
+                continue
+            seen.add(key)
+            scores[key] = scores.get(key, 0.0) + 1.0 / (k + position + 1)
+    return sorted(scores, key=lambda key: (-scores[key], str(key)))[:limit]
diff --git a/vehiclegpt/analytics/views.sql b/vehiclegpt/analytics/views.sql
new file mode 100644
index 0000000..f3e408c
--- /dev/null
+++ b/vehiclegpt/analytics/views.sql
@@ -0,0 +1,95 @@
+-- Analytics views: the deterministic layer.
+--
+-- These answer questions with SQL, not with a language model. That is a
+-- deliberate architectural choice, not a shortcut: on a constrained tier the
+-- model cannot meet the latency target (docs/10), and a filter or an aggregate
+-- does not need one. The numbers here are exact, reproducible and auditable,
+-- and the model's job becomes explaining them rather than computing them.
+--
+-- Every view is derived. Nothing is stored twice; rebuild by dropping the views.
+
+DROP VIEW IF EXISTS v_daily_rolling;
+DROP VIEW IF EXISTS v_regime_energy;
+DROP VIEW IF EXISTS v_adas_disengagements;
+DROP VIEW IF EXISTS v_event_sequence;
+DROP VIEW IF EXISTS v_warning_episodes;
+
+-- Distance-weighted consumption over a trailing 7-day window, and over the
+-- 7 days before that. Weighting by distance rather than averaging daily Wh/km
+-- stops a 7.9 km weekend errand from counting as much as a 40 km commute.
+--
+-- Days with almost no driving (< 2 km) are excluded outright: a cold-start
+-- crawl can read 900 Wh/km and would otherwise dominate the average.
+CREATE VIEW v_daily_rolling AS
+SELECT
+    day,
+    distance_km,
+    energy_wh,
+    wh_per_km,
+    ambient_c,
+    hvac_w,
+    SUM(energy_wh)   OVER w7      / NULLIF(SUM(distance_km) OVER w7, 0)      AS ma7_wh_per_km,
+    SUM(energy_wh)   OVER prior7  / NULLIF(SUM(distance_km) OVER prior7, 0)  AS prior7_wh_per_km,
+    AVG(ambient_c)   OVER w7                                                  AS ma7_ambient_c,
+    AVG(hvac_w)      OVER w7                                                  AS ma7_hvac_w,
+    COUNT(*)         OVER prior7                                              AS prior7_days
+FROM daily
+WHERE distance_km > 2
+WINDOW
+    w7     AS (ORDER BY day ROWS BETWEEN 6 PRECEDING AND CURRENT ROW),
+    prior7 AS (ORDER BY day ROWS BETWEEN 13 PRECEDING AND 7 PRECEDING);
+
+-- Energy per km by speed regime, over an arbitrary window the caller filters.
+-- Consumption is SUM(Wh)/SUM(km), never AVG(Wh/km): averaging a ratio weights a
+-- 30-second stint the same as a 15-minute one.
+CREATE VIEW v_regime_energy AS
+SELECT
+    regime,
+    COUNT(*)                        AS segments,
+    SUM(distance_km)                AS distance_km,
+    SUM(energy_wh)                  AS energy_wh,
+    SUM(energy_wh) / NULLIF(SUM(distance_km), 0) AS wh_per_km,
+    SUM(distance_km) / NULLIF(SUM(energy_wh), 0) * 1000 AS km_per_kwh,
+    SUM(distance_km * mean_speed_kph) / NULLIF(SUM(distance_km), 0) AS mean_speed_kph,
+    MIN(start_ns)                   AS first_ns,
+    MAX(end_ns)                     AS last_ns
+FROM segment
+WHERE regime <> 'idle'
+GROUP BY regime;
+
+-- ADAS disengagement events. Injected faults are excluded: the question asks
+-- what the vehicle did, and a row saying "we made this happen" is test harness
+-- leakage, not evidence.
+CREATE VIEW v_adas_disengagements AS
+SELECT
+    e.id,
+    e.ts_ns,
+    date(e.ts_ns / 1000000000, 'unixepoch') AS day,
+    time(e.ts_ns / 1000000000, 'unixepoch') AS time_utc,
+    e.severity,
+    e.message
+FROM event e
+WHERE e.kind = 'adas.disengagement'
+ORDER BY e.ts_ns;
+
+-- Every warning/critical event paired with what came before it.
+-- `lead_s` is how far back the predecessor event sits, so the ordering is
+-- explicit rather than implied by row order.
+CREATE VIEW v_event_sequence AS
+SELECT
+    w.id           AS warning_id,
+    w.ts_ns        AS warning_ns,
+    w.kind         AS warning_kind,
+    w.severity     AS warning_severity,
+    p.id           AS precursor_id,
+    p.ts_ns        AS precursor_ns,
+    p.kind         AS precursor_kind,
+    p.severity     AS precursor_severity,
+    p.message      AS precursor_message,
+    (w.ts_ns - p.ts_ns) / 1000000000.0 AS lead_s
+FROM event w
+JOIN event p
+  ON p.ts_ns < w.ts_ns
+ AND p.ts_ns >= w.ts_ns - 3600 * 1000000000   -- one hour of lookback
+WHERE w.severity IN ('warning', 'critical')
+ORDER BY w.ts_ns, p.ts_ns;
