--- /dev/null
+++ b/vehiclegpt/store/db.py
@@ -0,0 +1,338 @@
+"""Local SQLite store.
+
+Design constraints, from docs/06 §7:
+
+* **System of record, not an analytics engine.** SQLite handles the unbatched
+  small writes and tiny lookups a vehicle produces; a columnar engine would be
+  ~56x too slow at single-row insert, which is the access pattern that actually
+  dominates. See docs/03 for the comparison.
+* **Decimate on write.** The 10 Hz signal stream is stored at 1 Hz. The raw ring
+  stays in RAM (L0) and is deliberately not persisted: it is large, short-lived,
+  and worthless without context that the segments already capture.
+* **Derived tables are rebuilt, never patched.** ``segment`` and ``daily`` are
+  recomputed from ``sample`` on demand, so a schema or logic change cannot leave
+  half-stale aggregates behind.
+"""
+
+from __future__ import annotations
+
+import sqlite3
+from collections.abc import Iterable, Iterator, Sequence
+from contextlib import contextmanager
+from dataclasses import dataclass
+from pathlib import Path
+
+SCHEMA_PATH = Path(__file__).with_name("schema.sql")
+VIEWS_PATH = (Path(__file__).resolve().parents[1]
+              / "analytics" / "views.sql")
+
+DAY_NS = 86_400 * 10**9
+
+
+@dataclass(frozen=True)
+class SampleRow:
+    """One sample at the API boundary.
+
+    ``ts_ns`` is nanoseconds for precision at the caller, but storage truncates
+    to whole seconds - the table is 1 Hz by design (see decimate.py).
+    """
+    ts_ns: int
+    path: str
+    value: float
+    quality: int = 0
+
+
+@dataclass(frozen=True)
+class EventRow:
+    ts_ns: int
+    kind: str
+    severity: str
+    message: str
+
+
+def connect(path: str | Path, *, create: bool = True) -> sqlite3.Connection:
+    """Open (and optionally initialise) the store."""
+    path = Path(path)
+    if path.exists() is False and not create:
+        raise FileNotFoundError(path)
+    conn = sqlite3.connect(str(path))
+    conn.row_factory = sqlite3.Row
+    conn.execute("PRAGMA foreign_keys = ON")
+    if create:
+        conn.executescript(SCHEMA_PATH.read_text(encoding="utf-8"))
+    return conn
+
+
+@contextmanager
+def store(path: str | Path) -> Iterator[sqlite3.Connection]:
+    conn = connect(path)
+    try:
+        yield conn
+        conn.commit()
+    finally:
+        conn.close()
+
+
+# ---------------------------------------------------------------------------
+# Writing
+# ---------------------------------------------------------------------------
+
+def ensure_signals(conn: sqlite3.Connection,
+                   signals: Sequence[tuple[str, str, str]]) -> dict[str, int]:
+    """Insert signal dimension rows, returning ``path -> id``."""
+    conn.executemany(
+        "INSERT OR IGNORE INTO signal(path, unit, tier) VALUES (?, ?, ?)",
+        [(p, u, t) for p, u, t in signals],
+    )
+    return {row["path"]: row["id"] for row in conn.execute("SELECT id, path FROM signal")}
+
+
+def write_samples(conn: sqlite3.Connection, rows: Iterable[SampleRow],
+                  signal_ids: dict[str, int]) -> int:
+    """Insert decimated samples. Unknown paths are skipped, not invented."""
+    payload = [
+        (r.ts_ns // 10**9, signal_ids[r.path], r.value, r.quality)
+        for r in rows if r.path in signal_ids
+    ]
+    conn.executemany(
+        "INSERT OR REPLACE INTO sample(ts_s, signal_id, value, quality) "
+        "VALUES (?, ?, ?, ?)",
+        payload,
+    )
+    return len(payload)
+
+
+def write_events(conn: sqlite3.Connection, rows: Iterable[EventRow]) -> int:
+    payload = [(r.ts_ns, r.kind, r.severity, r.message) for r in rows]
+    conn.executemany(
+        "INSERT INTO event(ts_ns, kind, severity, message) VALUES (?, ?, ?, ?)",
+        payload,
+    )
+    return len(payload)
+
+
+# ---------------------------------------------------------------------------
+# Building derived tables
+# ---------------------------------------------------------------------------
+
+SPEED_PATH = "vehicle.speed"
+CURRENT_PATH = "battery.pack_current"
+VOLTAGE_PATH = "battery.pack_voltage"
+AMBIENT_PATH = "thermal.ambient"
+HVAC_PATH = "hvac.power"
+SOC_PATH = "battery.soc"
+
+REGIME_IDLE_BELOW_KPH = 5.0
+REGIME_HIGHWAY_AT_LEAST_KPH = 80.0
+MIN_SEGMENT_S = 30.0
+DRIVE_BREAK_NS = 10 * 60 * 10**9   # 10 minutes of silence starts a new drive
+
+
+def signal_id(conn: sqlite3.Connection, path: str) -> int | None:
+    row = conn.execute("SELECT id FROM signal WHERE path = ?", (path,)).fetchone()
+    return None if row is None else int(row["id"])
+
+
+def _series(conn: sqlite3.Connection, path: str) -> list[tuple[int, float]]:
+    """Full series for a path, as (nanoseconds, value) pairs."""
+    sid = signal_id(conn, path)
+    if sid is None:
+        return []
+    return [(int(r["ts_s"]) * 10**9, float(r["value"])) for r in conn.execute(
+        "SELECT ts_s, value FROM sample WHERE signal_id = ? ORDER BY ts_s", (sid,))]
+
+
+def series_ns(conn: sqlite3.Connection, path: str,
+              lo_ns: int | None = None,
+              hi_ns: int | None = None) -> list[tuple[int, float]]:
+    """Windowed series, in nanoseconds. The single reader for sample data."""
+    sid = signal_id(conn, path)
+    if sid is None:
+        return []
+    lo = 0 if lo_ns is None else lo_ns // 10**9
+    hi = 2**62 if hi_ns is None else hi_ns // 10**9
+    return [(int(r["ts_s"]) * 10**9, float(r["value"])) for r in conn.execute(
+        "SELECT ts_s, value FROM sample WHERE signal_id = ? AND ts_s BETWEEN ? AND ? "
+        "ORDER BY ts_s", (sid, lo, hi))]
+
+
+def classify_regime(speed_kph: float) -> str:
+    """Speed regime from the signal itself, not from scenario metadata.
+
+    The thresholds are crude on purpose. What matters is that the classification
+    is reproducible from stored data and would work identically on a real
+    vehicle - where nobody hands you a label saying "this was motorway driving".
+    """
+    if speed_kph < REGIME_IDLE_BELOW_KPH:
+        return "idle"
+    if speed_kph >= REGIME_HIGHWAY_AT_LEAST_KPH:
+        return "highway"
+    return "city"
+
+
+def _contiguous_blocks(speed: list[tuple[int, float]]) -> list[list[int]]:
+    """Split the timeline into drives at silences longer than DRIVE_BREAK_NS.
+
+    This must happen BEFORE regime segmentation. Doing it afterwards lets a
+    segment span the overnight gap, and integrating distance across nine hours
+    of parked time at the last known speed produces a 415 km "commute" - which
+    is exactly what the first version of this function did.
+    """
+    if not speed:
+        return []
+    blocks: list[list[int]] = [[0]]
+    for i in range(1, len(speed)):
+        if speed[i][0] - speed[i - 1][0] > DRIVE_BREAK_NS:
+            blocks.append([i])
+        else:
+            blocks[-1].append(i)
+    return blocks
+
+
+def _runs(speed: list[tuple[int, float]], idx: list[int]) -> list[list]:
+    """Runs of one speed regime within a drive, merging blips."""
+    runs: list[list] = []
+    first = classify_regime(speed[idx[0]][1])
+    lo = 0
+    for k in range(1, len(idx)):
+        regime = classify_regime(speed[idx[k]][1])
+        if regime != first:
+            runs.append([first, lo, k])
+            lo = k
+            first = regime
+    runs.append([first, lo, len(idx) - 1])
+
+    merged: list[list] = []
+    for regime, a, b in runs:
+        duration = (speed[idx[b]][0] - speed[idx[a]][0]) / 1e9
+        if merged and duration < MIN_SEGMENT_S:
+            # A single sample across a threshold is a sensor blip, not a stint.
+            merged[-1][2] = b
+        else:
+            merged.append([regime, a, b])
+    return merged
+
+
+def build_segments(conn: sqlite3.Connection) -> int:
+    """Segment the timeline by speed regime and integrate energy and distance.
+
+    Energy is ``V x I`` integrated over time - the physical definition - not the
+    ``energy.per_km`` convenience signal, so the figure does not depend on the
+    vehicle's own estimator being correct.
+    """
+    speed = _series(conn, SPEED_PATH)
+    conn.execute("DELETE FROM segment")
+    conn.execute("DELETE FROM drive")
+    if len(speed) < 2:
+        return 0
+
+    current = dict(_series(conn, CURRENT_PATH))
+    voltage = dict(_series(conn, VOLTAGE_PATH))
+
+    cur = conn.cursor()
+    n_segments = 0
+    for block in _contiguous_blocks(speed):
+        if len(block) < 2:
+            continue
+        rows = []
+        for regime, a, b in _runs(speed, block):
+            dist_km = energy_wh = 0.0
+            for k in range(a, b):
+                ts0, ts1 = speed[block[k]][0], speed[block[k + 1]][0]
+                dt_s = (ts1 - ts0) / 1e9
+                if dt_s <= 0 or dt_s > 2.0:
+                    # 1 Hz data; anything else is a gap, and integrating across
+                    # it would invent distance and energy that never happened.
+                    continue
+                v_kph = 0.5 * (speed[block[k]][1] + speed[block[k + 1]][1])
+                dist_km += v_kph * dt_s / 3600.0
+                i_a, v_v = current.get(ts0), voltage.get(ts0)
+                if i_a is not None and v_v is not None:
+                    energy_wh += v_v * i_a * dt_s / 3600.0
+
+            seg_start, seg_end = speed[block[a]][0], speed[block[b]][0]
+            span_s = (seg_end - seg_start) / 1e9
+            mean_kph = dist_km / (span_s / 3600.0) if span_s > 0 else 0.0
+            rows.append((seg_start, seg_end, regime, round(dist_km, 4),
+                         round(energy_wh, 3), round(mean_kph, 2)))
+
+        if not rows:
+            continue
+        cur.execute(
+            "INSERT INTO drive(start_ns, end_ns, distance_km, energy_wh) VALUES (?, ?, ?, ?)",
+            (rows[0][0], rows[-1][1], round(sum(r[3] for r in rows), 4),
+             round(sum(r[4] for r in rows), 3)))
+        drive_id = cur.lastrowid
+        cur.executemany(
+            "INSERT INTO segment(drive_id, start_ns, end_ns, regime, distance_km, "
+            "energy_wh, mean_speed_kph) VALUES (?, ?, ?, ?, ?, ?, ?)",
+            [(drive_id, *r) for r in rows])
+        n_segments += len(rows)
+    return n_segments
+
+
+def build_daily(conn: sqlite3.Connection) -> int:
+    """One row per UTC day: distance, energy, consumption, ambient, HVAC, SOC.
+
+    Consumption is deliberately computed from integrated Wh and km, not averaged
+    from per-sample Wh/km values - averaging a ratio weights every second
+    equally, including the seconds when the car was stationary.
+    """
+    conn.execute("DELETE FROM daily")
+    days = [r["day"] for r in conn.execute(
+        "SELECT DISTINCT date(start_ns / 1000000000, 'unixepoch') AS day "
+        "FROM segment ORDER BY day")]
+
+    for day in days:
+        agg = conn.execute(
+            "SELECT COALESCE(SUM(distance_km), 0) AS km, "
+            "       COALESCE(SUM(energy_wh), 0) AS wh "
+            "FROM segment WHERE date(start_ns / 1000000000, 'unixepoch') = ?",
+            (day,)).fetchone()
+        km, wh = float(agg["km"]), float(agg["wh"])
+        ambient = _day_mean(conn, AMBIENT_PATH, day)
+        hvac = _day_mean(conn, HVAC_PATH, day)
+        soc = _day_range(conn, SOC_PATH, day)
+        conn.execute(
+            "INSERT INTO daily(day, distance_km, energy_wh, wh_per_km, ambient_c, "
+            "hvac_w, soc_start, soc_end) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
+            (day, round(km, 3), round(wh, 2),
+             round(wh / km, 2) if km > 0 else None,
+             ambient, hvac, soc[0], soc[1]))
+    return len(days)
+
+
+def _day_mean(conn: sqlite3.Connection, path: str, day: str) -> float | None:
+    row = conn.execute(
+        "SELECT AVG(s.value) AS v FROM sample s JOIN signal g ON g.id = s.signal_id "
+        "WHERE g.path = ? AND date(s.ts_s, 'unixepoch') = ?",
+        (path, day)).fetchone()
+    return None if row["v"] is None else round(float(row["v"]), 2)
+
+
+def _day_range(conn: sqlite3.Connection, path: str, day: str) -> tuple[float | None, float | None]:
+    sid = signal_id(conn, path)
+    if sid is None:
+        return (None, None)
+    rows = [float(r["value"]) for r in conn.execute(
+        "SELECT value FROM sample WHERE signal_id = ? "
+        "AND date(ts_s, 'unixepoch') = ? ORDER BY ts_s", (sid, day))]
+    return (round(rows[0], 2), round(rows[-1], 2)) if rows else (None, None)
+
+
+def create_views(conn: sqlite3.Connection) -> None:
+    """(Re)create the analytics views. Needs a writable connection."""
+    conn.executescript(VIEWS_PATH.read_text(encoding="utf-8"))
+
+
+def rebuild(conn: sqlite3.Connection) -> dict[str, int]:
+    """Rebuild every derived table from ``sample`` and ``event``."""
+    n_seg = build_segments(conn)
+    n_daily = build_daily(conn)
+    create_views(conn)
+    # Cards depend on the views and on the daily rollup, so they come last.
+    from vehiclegpt.analytics.retrieval import build_cards
+
+    n_cards = build_cards(conn)
+    conn.execute("INSERT OR REPLACE INTO meta(key, value) VALUES ('rebuilt_at', datetime('now'))")
+    return {"segments": n_seg, "days": n_daily, "cards": n_cards}
diff --git a/vehiclegpt/store/decimate.py b/vehiclegpt/store/decimate.py
new file mode 100644
index 0000000..b146a50
--- /dev/null
+++ b/vehiclegpt/store/decimate.py
@@ -0,0 +1,200 @@
+"""1 Hz decimation, owned by the store.
+
+Decimation used to live in the build script as ``range(0, n, 10)``. That is
+wrong in two ways and neither announces itself:
+
+1. **It loses pulses.** A one-tick ADAS disengagement or an overheat flag that
+   is set for 0.3 s falls between samples and vanishes. The question "show me
+   all disengagements" then silently under-reports, and the answer looks
+   perfectly healthy.
+2. **It loses peaks and troughs.** Point sampling a temperature series reports
+   whatever happened to land on the sample instant, which is not the maximum.
+
+So decimation is policy-driven, per signal, and the policies are chosen so that
+no discrete event can be dropped:
+
+``LAST``
+    One value per second, the last one seen. For continuous measurements.
+``ON_CHANGE``
+    Emit only when the value moves by more than the signal's deadband (from
+    ``signals.yaml``), plus the first sample and the final sample. For slow
+    signals this is a large storage win and loses nothing a reader cares about.
+``ANY``
+    Emit a sample whenever the value changes at all, and additionally emit the
+    final value of every second in which any change occurred. Used for flags,
+    where a single-tick pulse is the event.
+
+The rule underneath all three: **the first sample and the last sample are always
+kept**, and no transition is ever lost.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from enum import StrEnum
+
+from vehiclegpt.schema.registry import SignalSpec, Tier
+
+
+class Policy(StrEnum):
+    LAST = "last"
+    ON_CHANGE = "on_change"
+    ANY = "any"
+
+
+def policy_for(spec: SignalSpec) -> Policy:
+    """Choose a decimation policy from the registry.
+
+    Flags are detected by their declared range rather than by a name list, so a
+    new flag added to ``signals.yaml`` is handled without touching this file.
+    """
+    if spec.minimum == 0.0 and spec.maximum == 1.0:
+        return Policy.ANY
+    if spec.tier is Tier.SLOW:
+        return Policy.ON_CHANGE
+    return Policy.LAST
+
+
+@dataclass(frozen=True)
+class DecimatedSample:
+    ts_s: int
+    value: float
+
+
+#: A flat stretch keeps one repeat sample this often, so its duration can be
+#: reconstructed. Must stay well below MIN_STALL_S (60 s) or a stall of exactly
+#: that length becomes unprovable.
+KEYFRAME_S = 60.0
+
+
+def decimate(
+    ts_ns: list[int],
+    values: list[float],
+    spec: SignalSpec,
+    policy: Policy | None = None,
+    target_hz: float = 1.0,
+) -> list[DecimatedSample]:
+    """Reduce a series to ``target_hz`` according to ``policy``.
+
+    ``ts_ns`` and ``values`` must be the same length and in time order.
+
+    Output timestamps are whole seconds, which is also the storage key - so the
+    reduction has to happen here, not be left to the primary key. An earlier
+    version bucketed by ``1e9 / input_rate`` and let ``INSERT OR REPLACE``
+    collapse the duplicates, which looked correct in the row counts while
+    silently discarding every intra-second transition.
+    """
+    if len(ts_ns) != len(values):
+        raise ValueError(
+            f"{spec.path}: {len(ts_ns)} timestamps for {len(values)} values")
+    if not values:
+        return []
+
+    policy = policy or policy_for(spec)
+    if policy is Policy.LAST:
+        return _last_per_bucket(ts_ns, values, target_hz)
+    if policy is Policy.ANY:
+        return _flag_changes(ts_ns, values, target_hz)
+    return _on_change(ts_ns, values, spec.deadband, target_hz)
+
+
+def _bucket(ts_ns: int, target_hz: float) -> int:
+    """Index of the output bucket containing ``ts_ns``."""
+    period_ns = max(1, int(1e9 / max(1e-9, target_hz)))
+    return ts_ns // period_ns
+
+
+def _bucket_ts(bucket: int, target_hz: float) -> int:
+    period_ns = max(1, int(1e9 / max(1e-9, target_hz)))
+    return (bucket * period_ns) // 10**9
+
+
+def _last_per_bucket(ts_ns: list[int], values: list[float],
+                     target_hz: float) -> list[DecimatedSample]:
+    """One sample per bucket, carrying the last value seen in it."""
+    out: list[DecimatedSample] = []
+    last_bucket = None
+    for ts, v in zip(ts_ns, values, strict=True):
+        b = _bucket(ts, target_hz)
+        if b != last_bucket:
+            out.append(DecimatedSample(_bucket_ts(b, target_hz), v))
+            last_bucket = b
+        else:
+            out[-1] = DecimatedSample(_bucket_ts(b, target_hz), v)
+    return out
+
+
+def _flag_changes(ts_ns: list[int], values: list[float],
+                  target_hz: float) -> list[DecimatedSample]:
+    """Transitions only, with intra-second pulses preserved.
+
+    Two steps, and both matter:
+
+    1. Collapse to one value per bucket using the **maximum**, so a flag that
+       goes 0 -> 1 -> 0 inside a single second is recorded as 1 rather than 0.
+       Taking the last value - the obvious choice - destroys exactly the events
+       this layer exists to report.
+    2. Drop every bucket whose value equals the previous kept value, so a flag
+       that never fires costs two rows (first and last) instead of one per
+       second.
+
+    A reader reconstructs the flag at time *t* as the last row at or before *t*.
+    """
+    per_bucket: list[DecimatedSample] = []
+    last_bucket = None
+    for ts, v in zip(ts_ns, values, strict=True):
+        b = _bucket(ts, target_hz)
+        if b != last_bucket:
+            per_bucket.append(DecimatedSample(_bucket_ts(b, target_hz), v))
+            last_bucket = b
+        elif v > per_bucket[-1].value:
+            per_bucket[-1] = DecimatedSample(per_bucket[-1].ts_s, v)
+
+    out: list[DecimatedSample] = [per_bucket[0]]
+    for sample in per_bucket[1:]:
+        if sample.value != out[-1].value:
+            out.append(sample)
+    final = DecimatedSample(ts_ns[-1] // 10**9, values[-1])
+    if out[-1].ts_s != final.ts_s:
+        out.append(final)
+    return out
+
+
+def _on_change(ts_ns: list[int], values: list[float], deadband: float,
+               target_hz: float,
+               keyframe_s: float = KEYFRAME_S) -> list[DecimatedSample]:
+    """Keep the first sample, then values that move beyond the deadband.
+
+    A plateau also gets a repeat sample every ``keyframe_s`` seconds. Without
+    that, a long flat stretch is represented by its two endpoints and nobody can
+    tell *how long* it lasted: a 15-minute coolant-pump stall collapsed to two
+    rows, and the stall detector - which needs a third reading still at zero
+    after 60 s - silently reported that no stall had happened. The keyframe
+    bounds the gap, so duration stays recoverable from the stored series.
+
+    The final sample is always kept so a reader can tell how the series ended
+    even if it ended mid-plateau.
+    """
+    kept = [DecimatedSample(ts_ns[0] // 10**9, values[0])]
+    last_raw_ns = ts_ns[0]
+    keyframe_ns = int(keyframe_s * 10**9)
+    for ts, v in zip(ts_ns[1:], values[1:], strict=True):
+        if abs(v - kept[-1].value) > deadband or ts - last_raw_ns >= keyframe_ns:
+            kept.append(DecimatedSample(ts // 10**9, v))
+            last_raw_ns = ts
+    if kept[-1].ts_s != ts_ns[-1] // 10**9:
+        kept.append(DecimatedSample(ts_ns[-1] // 10**9, values[-1]))
+
+    # Two changes inside one second would collide on the storage key; keep the
+    # later one, which is what a last-value-wins reader expects.
+    out: list[DecimatedSample] = []
+    for sample in kept:
+        if out and sample.ts_s == out[-1].ts_s:
+            out[-1] = sample
+        else:
+            out.append(sample)
+    return out
+
+
+def compression_ratio(raw_count: int, kept_count: int) -> float:
+    return raw_count / kept_count if kept_count else float("inf")
diff --git a/vehiclegpt/store/footprint.py b/vehiclegpt/store/footprint.py
new file mode 100644
index 0000000..f136ca4
--- /dev/null
+++ b/vehiclegpt/store/footprint.py
@@ -0,0 +1,227 @@
+"""Storage footprint: measured, then projected.
+
+Doc 06 §7 projects 103 MB for 28 days from an assumed **1.2 bytes per value**
+(int16 + delta + zstd). This module measures what the store actually costs and
+reports the difference rather than letting the projection stand.
+
+The distinction that matters, and which an earlier version of this analysis
+missed: doc 06's model assumes the hot tier is sampled **continuously, 24/7,**
+for 15 signals. The store as built records **driving time only** - roughly half
+an hour a day in the simulated program. Those are not the same workload, so
+comparing their totals directly would flatter the implementation by a factor of
+about 46.
+
+So every projection here states its sampling assumption explicitly, and both are
+reported: what the store costs for what it actually records, and what it would
+cost if it sampled the way the model assumes.
+"""
+
+from __future__ import annotations
+
+import sqlite3
+from dataclasses import dataclass, field
+from pathlib import Path
+
+DEFAULT_BUDGET_MB = 103.17        # docs/06 §7, [D]
+MODEL_BYTES_PER_VALUE = 1.2       # docs/06 §7 assumption
+SECONDS_PER_DAY = 86_400
+
+
+@dataclass
+class Footprint:
+    db_path: str
+    db_bytes: int
+    samples: int
+    signals: int
+    sampled_seconds: int          # distinct seconds containing data
+    drive_hours: float
+    days_covered: int
+    objects: dict[str, int] = field(default_factory=dict)
+
+    @property
+    def bytes_per_sample(self) -> float:
+        return self.db_bytes / self.samples if self.samples else 0.0
+
+    @property
+    def samples_per_drive_hour(self) -> float:
+        return self.samples / self.drive_hours if self.drive_hours else 0.0
+
+    @property
+    def drive_hours_per_day(self) -> float:
+        return self.drive_hours / self.days_covered if self.days_covered else 0.0
+
+    @property
+    def bytes_per_sample_row_only(self) -> float:
+        """Bytes attributable to the `sample` B-tree alone."""
+        return self.objects.get("sample", 0) / self.samples if self.samples else 0.0
+
+
+def measure(db_path: str | Path, conn: sqlite3.Connection | None = None) -> Footprint:
+    """Measure an existing store. Read-only and cheap."""
+    db_path = Path(db_path)
+    if conn is None and not db_path.exists():
+        raise FileNotFoundError(f"no store at {db_path}")
+    own = conn is None
+    conn = conn or sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
+    conn.row_factory = sqlite3.Row
+    try:
+        samples = conn.execute("SELECT COUNT(*) AS n FROM sample").fetchone()["n"]
+        signals = conn.execute(
+            "SELECT COUNT(DISTINCT signal_id) AS n FROM sample").fetchone()["n"]
+        span = conn.execute(
+            "SELECT MIN(ts_s) AS lo, MAX(ts_s) AS hi, "
+            "       COUNT(DISTINCT ts_s) AS secs FROM sample").fetchone()
+        day_row = conn.execute(
+            "SELECT COUNT(DISTINCT date(ts_s, 'unixepoch')) AS d FROM sample"
+        ).fetchone()
+        try:
+            drive_ns = conn.execute(
+                "SELECT COALESCE(SUM(end_ns - start_ns), 0) AS ns FROM segment"
+            ).fetchone()["ns"]
+        except sqlite3.OperationalError:
+            drive_ns = 0        # not yet segmented; project_driving reports unavailable
+
+        objects: dict[str, int] = {}
+        try:
+            for row in conn.execute(
+                    "SELECT name, SUM(pgsize) AS b FROM dbstat GROUP BY name"):
+                objects[row["name"]] = int(row["b"])
+        except sqlite3.OperationalError:
+            objects = {"(dbstat unavailable)": 0}
+    finally:
+        if own:
+            conn.close()
+
+    return Footprint(
+        db_path=str(db_path),
+        db_bytes=db_path.stat().st_size,
+        samples=int(samples),
+        signals=int(signals),
+        sampled_seconds=int(span["secs"] or 0),
+        drive_hours=float(drive_ns) / 3.6e12,
+        days_covered=int(day_row["d"] or 0),
+        objects=objects,
+    )
+
+
+def project_driving(fp: Footprint, days: int = 28) -> dict:
+    """Extrapolate from observed driving density, keeping the same duty cycle.
+
+    This is the honest projection for a vehicle that is driven the way the
+    program drives: it assumes the same hours-per-day and the same bytes per
+    sample. It says nothing about a car parked with the ignition on.
+    """
+    if fp.days_covered == 0:
+        return {"available": False, "reason": "no data"}
+    samples = fp.samples / fp.days_covered * days
+    return {
+        "available": True,
+        "assumption": "same driving hours per day as observed",
+        "days": days,
+        "duty_cycle_hours_per_day": round(fp.drive_hours_per_day, 2),
+        "samples": int(samples),
+        "bytes": int(samples * fp.bytes_per_sample),
+        "mb": round(samples * fp.bytes_per_sample / 1e6, 2),
+    }
+
+
+def project_continuous(fp: Footprint, hot_signals: int = 15,
+                       days: int = 28) -> dict:
+    """What the hot tier costs at 1 Hz, 24/7 - the workload doc 06 models."""
+    samples = hot_signals * days * SECONDS_PER_DAY
+    return {
+        "available": True,
+        "assumption": "1 Hz continuously, 24/7, for the whole horizon",
+        "days": days,
+        "hot_signals": hot_signals,
+        "samples": samples,
+        "bytes": int(samples * fp.bytes_per_sample),
+        "mb": round(samples * fp.bytes_per_sample / 1e6, 2),
+    }
+
+
+def required_bytes_per_sample(budget_mb: float = DEFAULT_BUDGET_MB,
+                              hot_signals: int = 15, days: int = 28) -> float:
+    """Density the store would need to hit the budget at 1 Hz, 24/7."""
+    samples = hot_signals * days * SECONDS_PER_DAY
+    return budget_mb * 1e6 / samples
+
+
+def assess(fp: Footprint, budget_mb: float = DEFAULT_BUDGET_MB,
+           hot_signals: int = 15, days: int = 28) -> dict:
+    driving = project_driving(fp, days)
+    continuous = project_continuous(fp, hot_signals, days)
+    required = required_bytes_per_sample(budget_mb, hot_signals, days)
+
+    return {
+        "budget_mb": budget_mb,
+        "measured_bytes_per_sample": round(fp.bytes_per_sample, 2),
+        "model_bytes_per_value": MODEL_BYTES_PER_VALUE,
+        "overhead_factor_vs_model": round(fp.bytes_per_sample / MODEL_BYTES_PER_VALUE, 1),
+        "required_bytes_per_sample_for_budget": round(required, 2),
+        "driving_projection": driving,
+        "continuous_projection": continuous,
+        "driving_within_budget": driving.get("available") and driving["mb"] <= budget_mb,
+        "continuous_within_budget": continuous["mb"] <= budget_mb,
+        "duty_cycle_to_fit_continuous_budget": round(
+            budget_mb / continuous["mb"] * 24.0, 2) if continuous["mb"] else None,
+    }
+
+
+def report(fp: Footprint, assessment: dict) -> str:
+    W = 76
+    lines = [
+        "=" * W,
+        "Storage footprint".center(W),
+        "=" * W,
+        "",
+        f"store            {fp.db_path}",
+        f"size             {fp.db_bytes / 1e6:.2f} MB",
+        f"samples          {fp.samples:,} across {fp.signals} signals",
+        f"days covered     {fp.days_covered}   driving {fp.drive_hours:.2f} h "
+        f"({fp.drive_hours_per_day:.2f} h/day)",
+        f"bytes per sample {fp.bytes_per_sample:.1f}  "
+        f"(sample B-tree alone: {fp.bytes_per_sample_row_only:.1f})",
+        "",
+        "-- where the bytes are " + "-" * (W - 23),
+    ]
+    for name, size in sorted(fp.objects.items(), key=lambda kv: -kv[1])[:6]:
+        share = size / fp.db_bytes * 100 if fp.db_bytes else 0
+        lines.append(f"   {name:26s} {size / 1e6:8.2f} MB  {share:5.1f}%")
+
+    lines += [
+        "",
+        "-- against the budget " + "-" * (W - 22),
+        f"   budget                      {assessment['budget_mb']:8.2f} MB",
+        f"   model assumed               {assessment['model_bytes_per_value']:8.2f} B/value",
+        f"   measured                    {assessment['measured_bytes_per_sample']:8.2f} B/sample"
+        f"   ({assessment['overhead_factor_vs_model']:.0f}x the model)",
+        f"   needed for the budget       "
+        f"{assessment['required_bytes_per_sample_for_budget']:8.2f} B/sample at 1 Hz 24/7",
+        "",
+        "   28-day projection, driving duty cycle",
+        f"     {assessment['driving_projection'].get('duty_cycle_hours_per_day')} h/day  ->  "
+        f"{assessment['driving_projection'].get('mb')} MB   "
+        f"{'WITHIN' if assessment['driving_within_budget'] else 'OVER'} budget",
+        "",
+        "   28-day projection, 1 Hz 24/7 for 15 signals (what the model assumes)",
+        f"     ->  {assessment['continuous_projection']['mb']} MB   "
+        f"{'WITHIN' if assessment['continuous_within_budget'] else 'OVER'} budget",
+    ]
+    if not assessment["continuous_within_budget"]:
+        lines += [
+            "",
+            f"   To fit {assessment['budget_mb']} MB at 1 Hz 24/7 the store would need",
+            f"   {assessment['required_bytes_per_sample_for_budget']} B/sample. It uses "
+            f"{assessment['measured_bytes_per_sample']}. The gap is the",
+            "   compression doc 06 assumed (int16 + delta + zstd) and which is not",
+            "   implemented. Quantising the value alone recovers about 15%, because",
+            "   SQLite row overhead dominates, not the value width - and on-change",
+            "   keyframes do not help here, because the expensive signals are the",
+            "   hot continuous ones that change every second by design.",
+            "",
+            "   The 103 MB figure therefore holds for driving-time sampling, not for",
+            "   a continuously-powered vehicle. Either the hot tier moves to",
+            "   a columnar or compressed layout, or the claim gets restated.",
+        ]
+    return "\n".join(lines)
diff --git a/vehiclegpt/store/schema.sql b/vehiclegpt/store/schema.sql
new file mode 100644
index 0000000..86c64fa
--- /dev/null
+++ b/vehiclegpt/store/schema.sql
@@ -0,0 +1,121 @@
+-- VehicleGPT local store.
+--
+-- Retention follows docs/06 §7: L0 (raw, in RAM) is not persisted; L1 hot is
+-- decimated to 1 Hz here; rollups and segments are derived and rebuilt rather
+-- than incrementally mutated, so the whole database is reproducible from the
+-- source data.
+
+PRAGMA journal_mode = WAL;
+PRAGMA synchronous = NORMAL;
+PRAGMA foreign_keys = ON;
+
+-- Signal dimension. Canonical paths from vehiclegpt/schema/signals.yaml.
+CREATE TABLE IF NOT EXISTS signal (
+    id      INTEGER PRIMARY KEY,
+    path    TEXT NOT NULL UNIQUE,
+    unit    TEXT NOT NULL,
+    tier    TEXT NOT NULL
+);
+
+-- L1 hot samples, decimated to 1 Hz by vehiclegpt/store/decimate.py.
+--
+-- Storage choices, each measured rather than assumed (docs/06 §7):
+--   * WITHOUT ROWID with PRIMARY KEY (signal_id, ts_s) makes the table its own
+--     index, removing a rowid pointer and a duplicate B-tree. 65.2 -> 24.2 B/row.
+--   * ts_s, not ts_ns: a nanosecond epoch needs a 9-byte varint, a seconds epoch
+--     needs 5. 24.2 -> 19.3 B/row.
+--   * The old standalone index on (ts_ns) was 30% of the database and was never
+--     used: every query filters by signal first. Dropped.
+-- Together: 65.2 -> 19.3 bytes per sample, a 3.4x reduction with no loss.
+CREATE TABLE IF NOT EXISTS sample (
+    ts_s      INTEGER NOT NULL,            -- seconds since the Unix epoch
+    signal_id INTEGER NOT NULL REFERENCES signal(id),
+    value     REAL    NOT NULL,
+    quality   INTEGER NOT NULL DEFAULT 0,  -- 0 = ok, 1 = out of bounds
+    PRIMARY KEY (signal_id, ts_s)
+) WITHOUT ROWID;
+
+-- Discrete events. These are what "show me all X from yesterday" queries hit.
+CREATE TABLE IF NOT EXISTS event (
+    id       INTEGER PRIMARY KEY,
+    ts_ns    INTEGER NOT NULL,
+    kind     TEXT    NOT NULL,
+    severity TEXT    NOT NULL,             -- info | warning | critical
+    message  TEXT    NOT NULL
+);
+
+CREATE INDEX IF NOT EXISTS ix_event_kind_ts ON event(kind, ts_ns);
+CREATE INDEX IF NOT EXISTS ix_event_ts      ON event(ts_ns);
+
+-- A drive is one contiguous powered period. Sessions are derived, not supplied.
+CREATE TABLE IF NOT EXISTS drive (
+    id         INTEGER PRIMARY KEY,
+    start_ns   INTEGER NOT NULL,
+    end_ns     INTEGER NOT NULL,
+    distance_km REAL   NOT NULL,
+    energy_wh  REAL    NOT NULL
+);
+
+CREATE INDEX IF NOT EXISTS ix_drive_start ON drive(start_ns);
+
+-- A segment is a stretch of a drive inside one speed regime. This is what makes
+-- "city vs highway" answerable from data rather than from the simulator's
+-- knowledge of which mode it was in.
+CREATE TABLE IF NOT EXISTS segment (
+    id          INTEGER PRIMARY KEY,
+    drive_id    INTEGER NOT NULL REFERENCES drive(id),
+    start_ns    INTEGER NOT NULL,
+    end_ns      INTEGER NOT NULL,
+    regime      TEXT    NOT NULL,          -- idle | city | highway
+    distance_km REAL    NOT NULL,
+    energy_wh   REAL    NOT NULL,
+    mean_speed_kph REAL NOT NULL
+);
+
+CREATE INDEX IF NOT EXISTS ix_segment_regime ON segment(regime);
+
+-- Daily rollup, rebuilt from `sample` and `segment`.
+CREATE TABLE IF NOT EXISTS daily (
+    day        TEXT PRIMARY KEY,           -- YYYY-MM-DD, UTC
+    distance_km REAL,
+    energy_wh   REAL,
+    wh_per_km   REAL,
+    ambient_c   REAL,
+    hvac_w      REAL,
+    soc_start   REAL,
+    soc_end     REAL
+);
+
+-- Bookkeeping so a rebuild cannot silently use stale derived rows.
+CREATE TABLE IF NOT EXISTS meta (
+    key   TEXT PRIMARY KEY,
+    value TEXT NOT NULL
+);
+
+-- Episode cards: the searchable unit. Derived from `event` and `daily`, rebuilt
+-- by the same pass that builds segments and rollups. See docs/11 §11.8.
+CREATE TABLE IF NOT EXISTS card (
+    id        INTEGER PRIMARY KEY,
+    kind      TEXT    NOT NULL,          -- incident | trend
+    start_ns  INTEGER NOT NULL,
+    end_ns    INTEGER NOT NULL,
+    day       TEXT    NOT NULL,
+    severity  TEXT    NOT NULL,
+    title     TEXT    NOT NULL,
+    body      TEXT    NOT NULL,
+    signals   TEXT    NOT NULL,          -- comma-separated paths and event kinds
+    evidence  TEXT    NOT NULL           -- JSON provenance pointers
+);
+
+CREATE INDEX IF NOT EXISTS ix_card_start ON card(start_ns);
+CREATE INDEX IF NOT EXISTS ix_card_kind  ON card(kind);
+
+-- External-content FTS5: the index stores no copy of the text, so it costs only
+-- the inverted index. `porter` stemming lets "disengage" match "disengaged".
+CREATE VIRTUAL TABLE IF NOT EXISTS card_fts USING fts5(
+    title,
+    body,
+    content='card',
+    content_rowid='id',
+    tokenize='porter unicode61'
+);
