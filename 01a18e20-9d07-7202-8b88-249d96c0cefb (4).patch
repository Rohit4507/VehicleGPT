new file mode 100644
index 0000000..27c66ec
--- /dev/null
+++ b/tools/paths.py
@@ -0,0 +1,123 @@
+"""
+Canonical definition of the VehicleGPT query paths.
+
+This module is the SINGLE SOURCE OF TRUTH for P0/P1/P2/P3. Everything else —
+the feasibility model, the architecture docs, the latency tables, the roadmap
+targets — must agree with the numbers here.
+
+Why this file exists: an earlier draft defined P1 as "140 in / 28 out" in one
+document and "100 in / 10 out" in another, which silently changed a headline
+latency figure by 15%. Prose drifts; code does not. `tools/check_docs.py`
+enforces that the markdown matches this module, and runs in CI.
+
+If you change a number here, you must also change:
+  - docs/04-architecture.md  §7 table
+  - docs/06-hardware-feasibility.md  §5, §6.3, §11
+  - README.md  "three findings" and constraints table
+`check_docs.py` will tell you exactly which lines are stale.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+# Tokens of system prompt + few-shot header that are prefill-cached once at
+# startup and reused for every query. llama.cpp supports this via slot reuse /
+# --prompt-cache. Only the per-query tail is re-prefilled.
+CACHED_PREFIX_TOKENS: int = 90
+
+# The brief's headline constraint.
+TARGET_LATENCY_MS: int = 2000
+
+
+@dataclass(frozen=True)
+class PathSpec:
+    """One way a user query can be answered, with its full cost model."""
+
+    key: str
+    name: str
+    prompt_tokens: int
+    output_tokens: int
+    pipeline_ms: float          # everything that is not LLM: parse, SQL, assemble
+    needs_llm: bool = True
+
+    @property
+    def uncached_prefill_tokens(self) -> int:
+        """Tokens actually re-prefilled per query, after prefix caching."""
+        if not self.needs_llm:
+            return 0
+        return max(0, self.prompt_tokens - CACHED_PREFIX_TOKENS)
+
+    @property
+    def spec(self) -> str:
+        """Short machine-checkable form, e.g. '140 in / 28 out'."""
+        if not self.needs_llm:
+            return "0 in / 0 out"
+        return f"{self.prompt_tokens} in / {self.output_tokens} out"
+
+    @property
+    def table_cell(self) -> str:
+        """Form used inside the latency table, e.g. '140 / 28'."""
+        if not self.needs_llm:
+            return "0 / 0"
+        return f"{self.prompt_tokens} / {self.output_tokens}"
+
+
+PATHS: tuple[PathSpec, ...] = (
+    PathSpec(
+        key="P0",
+        name="Deterministic: classifier -> DSL -> SQL -> template",
+        prompt_tokens=0,
+        output_tokens=0,
+        pipeline_ms=110,
+        needs_llm=False,
+    ),
+    PathSpec(
+        key="P1",
+        name="SLM intent-only (GBNF-constrained JSON) + template answer",
+        prompt_tokens=140,
+        output_tokens=28,
+        pipeline_ms=130,
+    ),
+    PathSpec(
+        key="P2",
+        name="SLM short narration over a pre-computed evidence pack",
+        prompt_tokens=260,
+        output_tokens=70,
+        pipeline_ms=130,
+    ),
+    PathSpec(
+        key="P3",
+        name="SLM long explanation / multi-hop (deep-explain mode)",
+        prompt_tokens=420,
+        output_tokens=160,
+        pipeline_ms=150,
+    ),
+)
+
+BY_KEY: dict[str, PathSpec] = {p.key: p for p in PATHS}
+
+
+def spec_table() -> str:
+    """Markdown for the normative spec table. Used to generate docs."""
+    rows = [
+        "| Path | What it does | Prompt in | Output out | Cached prefix | "
+        "Re-prefilled | Pipeline | LLM? |",
+        "|---|---|---|---|---|---|---|---|",
+    ]
+    for p in PATHS:
+        rows.append(
+            f"| **{p.key}** | {p.name} | {p.prompt_tokens} | {p.output_tokens} "
+            f"| {CACHED_PREFIX_TOKENS if p.needs_llm else 0} "
+            f"| {p.uncached_prefill_tokens} | {p.pipeline_ms:.0f} ms "
+            f"| {'yes' if p.needs_llm else '**no**'} |"
+        )
+    return "\n".join(rows)
+
+
+if __name__ == "__main__":
+    print(spec_table())
+    print()
+    for p in PATHS:
+        print(f"{p.key}: {p.spec}   re-prefill {p.uncached_prefill_tokens} tok"
+              f"   pipeline {p.pipeline_ms:.0f} ms")
diff --git a/tools/phase0/ask.py b/tools/phase0/ask.py
new file mode 100644
index 0000000..8451360
--- /dev/null
+++ b/tools/phase0/ask.py
@@ -0,0 +1,147 @@
+#!/usr/bin/env python3
+"""Ask the deterministic layer a question.
+
+    python3 tools/phase0/ask.py --db /tmp/vehiclegpt.db \\
+        "What happened before the battery overheating warning?"
+
+    python3 tools/phase0/ask.py --db /tmp/vehiclegpt.db --all
+    python3 tools/phase0/ask.py --db /tmp/vehiclegpt.db --json "..."
+
+    python3 tools/phase0/ask.py --db /tmp/vehiclegpt.db --dsl '{"kind":\
+"regime_compare","start_day":"2026-03-02","end_day":"2026-03-15"}'
+
+The second form is what a language model is allowed to emit: a small JSON object,
+never SQL. Both paths run through the same compiler.
+
+No model is involved. Every answer comes from SQL over the store, so the same
+question on the same data gives the same answer every time, and the numbers can
+be checked by hand.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import sqlite3
+import sys
+import time
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[2]
+if str(REPO) not in sys.path:
+    sys.path.insert(0, str(REPO))
+
+from vehiclegpt.analytics import dsl, queries  # noqa: E402
+
+BRIEF_QUESTIONS = [
+    "Why has my driving range reduced over the last two weeks?",
+    "When did fuel efficiency show the largest drop?",
+    "Show all ADAS disengagement events from yesterday.",
+    "What happened before the battery overheating warning?",
+    "Compare energy consumption between city and highway driving.",
+]
+
+
+def open_store(path: Path) -> sqlite3.Connection:
+    if not path.exists():
+        raise SystemExit(f"no store at {path}; run tools/phase0/build_store.py first")
+    conn = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
+    conn.row_factory = sqlite3.Row
+    have = {r["name"] for r in conn.execute(
+        "SELECT name FROM sqlite_master WHERE type='view'")}
+    if "v_daily_rolling" not in have:
+        raise SystemExit(
+            f"{path} has no analytics views; rebuild it with "
+            "tools/phase0/build_store.py")
+    return conn
+
+
+def run_dsl(conn: sqlite3.Connection, text: str, as_json: bool) -> int:
+    """Validate, compile and execute a DSL object, showing all three stages.
+
+    Printing the compiled SQL is the point rather than a debug leftover: it is
+    the evidence that the query text did not change, whatever the input was.
+    """
+    try:
+        query = dsl.from_json(text)
+    except dsl.DslError as exc:
+        print(f"invalid query: {exc}", file=sys.stderr)
+        return 2
+
+    t0 = time.perf_counter()
+    compiled = dsl.compile_query(query)
+    rows = dsl.run(conn, query)
+    elapsed_ms = (time.perf_counter() - t0) * 1000
+
+    if as_json:
+        print(json.dumps({"query": query.to_dict(), "sql": compiled.sql,
+                          "params": compiled.params, "rows": rows,
+                          "latency_ms": round(elapsed_ms, 2)}, indent=2, default=str))
+        return 0
+
+    print(f"\nkind   {query.kind}")
+    print(f"window {query.start_day} .. {query.end_day}")
+    if query.params:
+        print(f"params {query.params}")
+    print("\nsql (unchanged by any value; everything below is bound):")
+    for line in compiled.sql.splitlines():
+        print(f"   {line}")
+    print(f"\nbound {len(compiled.params)} params, {len(rows)} rows, "
+          f"{elapsed_ms:.1f} ms")
+    for row in rows[:20]:
+        shown = {k: (round(v, 3) if isinstance(v, float) else v) for k, v in row.items()}
+        print(f"   {shown}")
+    return 0
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("question", nargs="*")
+    ap.add_argument("--db", type=Path, default=Path("/tmp/vehiclegpt.db"))
+    ap.add_argument("--all", action="store_true", help="ask every brief question")
+    ap.add_argument("--json", action="store_true")
+    ap.add_argument("--evidence", action="store_true", help="dump supporting rows")
+    ap.add_argument("--dsl", metavar="JSON",
+                    help="run a query-DSL object instead of a natural-language question")
+    args = ap.parse_args()
+
+    conn = open_store(args.db)
+
+    if args.dsl:
+        return run_dsl(conn, args.dsl, args.json)
+
+    questions = BRIEF_QUESTIONS if (args.all or not args.question) else [" ".join(args.question)]
+
+    out = []
+    for q in questions:
+        t0 = time.perf_counter()
+        answer = queries.answer(conn, q)
+        elapsed_ms = (time.perf_counter() - t0) * 1000
+        record = answer.to_dict() | {"latency_ms": round(elapsed_ms, 2), "question": q}
+        out.append(record)
+
+        if not args.json:
+            print(f"\nQ: {q}")
+            print(f"   intent {answer.intent} | path {answer.path} | "
+                  f"{elapsed_ms:.1f} ms")
+            print(f"\n   {answer.text}")
+            if answer.caveats:
+                for c in answer.caveats:
+                    print(f"   note: {c}")
+            if args.evidence and answer.evidence:
+                print("   evidence:")
+                for row in answer.evidence[:8]:
+                    print(f"     {dict(row)}")
+
+    if args.json:
+        print(json.dumps(out, indent=2))
+    else:
+        slowest = max(r["latency_ms"] for r in out)
+        print(f"\n{len(out)} questions answered deterministically; "
+              f"slowest {slowest:.1f} ms (target 2000 ms, no model used)")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
