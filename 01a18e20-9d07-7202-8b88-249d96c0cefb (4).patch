--- /dev/null
+++ b/sim/emitter.py
@@ -0,0 +1,137 @@
+"""Put simulated truth onto a real CAN bus.
+
+Encodes canonical signal values into DBC messages with ``cantools`` and sends the
+resulting frames over a ``python-can`` bus, at the per-signal rates declared in
+the registry. Ingest then decodes them back with the same DBC.
+
+This is the piece that makes the CAN demo honest: between ``emit`` and ``decode``
+the data is genuinely packed into 8-byte frames at real bit offsets, serialised
+through a bus, and unpacked again. Nothing shortcuts the wire format.
+"""
+
+from __future__ import annotations
+
+import time
+from collections.abc import Iterator
+
+import can
+import cantools
+
+from sim.generator import RATE_HZ, Simulation
+from vehiclegpt.schema.registry import DBC_DIR, Registry
+from vehiclegpt.schema.registry import registry as default_registry
+
+# Message periods, in simulation ticks. Mirrors the rates in the DBCs.
+DEFAULT_MESSAGE_PERIOD_TICKS = 1   # 10 Hz at RATE_HZ
+
+
+class Encoder:
+    """Builds DBC frames from a ``Simulation``'s truth matrix."""
+
+    def __init__(self, sim: Simulation, reg: Registry | None = None) -> None:
+        self.sim = sim
+        self.reg = reg or default_registry()
+        self._dbs = {
+            name: cantools.database.load_file(DBC_DIR / name)
+            for name in self.reg.dbc_files()
+        }
+        # canonical path -> (dbc_name, message_name, dbc_signal_name)
+        self._routes: dict[str, tuple[str, str, str]] = {}
+        for spec in self.reg.signals.values():
+            if spec.sources and spec.path in sim.truth:
+                src = spec.sources[0]
+                self._routes[spec.path] = (src.dbc, src.message, src.signal)
+
+        # group by message so each frame is encoded once
+        self._by_message: dict[tuple[str, str], list[str]] = {}
+        for path, (dbc, msg, _sig) in self._routes.items():
+            self._by_message.setdefault((dbc, msg), []).append(path)
+
+        # cantools requires a COMPLETE payload: a partial dict raises KeyError
+        # on any signal you omitted. Precompute a benign default for every
+        # signal in every message we emit, so we only have to supply the ones
+        # we actually model.
+        self._defaults: dict[tuple[str, str], dict[str, float]] = {}
+        for dbc_name, msg_name in self._by_message:
+            message = self._dbs[dbc_name].get_message_by_name(msg_name)
+            self._defaults[(dbc_name, msg_name)] = {
+                sig.name: _default_value(sig) for sig in message.signals
+            }
+
+    def message_schedule(self) -> list[tuple[str, str]]:
+        return sorted(self._by_message)
+
+    def encode_tick(self, i: int) -> list[can.Message]:
+        """Encode every message for simulation tick ``i``."""
+        frames: list[can.Message] = []
+        for (dbc_name, msg_name), paths in self._by_message.items():
+            db = self._dbs[dbc_name]
+            message = db.get_message_by_name(msg_name)
+            payload: dict[str, float] = dict(
+                self._defaults[(dbc_name, msg_name)])
+            for path in paths:
+                _dbc, _msg, sig_name = self._routes[path]
+                spec = self.reg[path]
+                payload[sig_name] = _clamp(
+                    float(self.sim.truth[path][i]), spec.minimum, spec.maximum)
+            try:
+                data = message.encode(payload, scaling=True, strict=False)
+            except Exception:  # noqa: BLE001 - a single bad frame must not abort
+                continue
+            frames.append(can.Message(
+                arbitration_id=message.frame_id,
+                data=data,
+                is_extended_id=message.is_extended_frame,
+                timestamp=self.sim.t_s[i],
+            ))
+        return frames
+
+
+def _clamp(v: float, lo: float, hi: float) -> float:
+    return lo if v < lo else hi if v > hi else v
+
+
+def _default_value(sig) -> float:
+    """A neutral physical value for a signal we do not model.
+
+    Zero, or the nearest in-range value if zero is out of range. Used to fill
+    messages that share a frame with a signal we do care about.
+    """
+    if sig.minimum is not None and sig.minimum > 0.0:
+        return float(sig.minimum)
+    if sig.maximum is not None and sig.maximum < 0.0:
+        return float(sig.maximum)
+    return 0.0
+
+
+def replay(sim: Simulation, bus: can.BusABC, reg: Registry | None = None,
+           wall_clock: bool = False, limit_ticks: int | None = None) -> int:
+    """Push a whole simulation onto ``bus``. Returns frames sent.
+
+    ``wall_clock=False`` sends as fast as possible (use in tests);
+    ``wall_clock=True`` sleeps to real time (use for a live demo).
+    """
+    enc = Encoder(sim, reg)
+    n = sim.n if limit_ticks is None else min(sim.n, limit_ticks)
+    sent = 0
+    tick_period = 1.0 / RATE_HZ
+    t0 = time.monotonic()
+    for i in range(n):
+        for frame in enc.encode_tick(i):
+            bus.send(frame)
+            sent += 1
+        if wall_clock:
+            target = t0 + (i + 1) * tick_period
+            delay = target - time.monotonic()
+            if delay > 0:
+                time.sleep(delay)
+    return sent
+
+
+def iter_frames(sim: Simulation, reg: Registry | None = None,
+                limit_ticks: int | None = None) -> Iterator[can.Message]:
+    """Encode without a bus - useful for golden-file tests."""
+    enc = Encoder(sim, reg)
+    n = sim.n if limit_ticks is None else min(sim.n, limit_ticks)
+    for i in range(n):
+        yield from enc.encode_tick(i)
diff --git a/sim/generator.py b/sim/generator.py
new file mode 100644
index 0000000..5c76df9
--- /dev/null
+++ b/sim/generator.py
@@ -0,0 +1,360 @@
+"""Physics-lite vehicle simulation.
+
+Produces the ``truth`` signal matrix that the CAN emitter puts on the bus and the
+ingest path decodes back. Deliberately *not* a vehicle dynamics package: it is a
+lumped-parameter model good enough that the analytics layer has real structure to
+find (a range trend, a city/highway efficiency split, a thermal excursion), and
+simple enough to read in one sitting.
+
+Model summary
+-------------
+Longitudinal : first-order speed tracking toward a mode-dependent target, with
+               stops in CITY. Acceleration is the numerical derivative.
+Energy       : Wh/km = rolling + aero(v^2) + aux(v) + HVAC(|ambient-setpoint|).
+               The aero term makes highway efficiency worse; the aux term makes
+               *very* low speed worse. That U-shape is what makes the
+               city-vs-highway comparison a real question rather than a constant.
+Pack thermal : single-node lumped thermal model.
+               C dT/dt = Q_joule(I^2 R) + Q_ambient - Q_coolant(pump, dT)
+               A stuck pump removes the coolant term and the pack runs away -
+               which is exactly the fault sequence Q4 asks about.
+SOC          : coulomb counting from pack current, with a finite pack.
+
+Everything is seeded. Same scenario + same seed => bit-identical output.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+
+from sim.scenario import FaultKind, Mode, Scenario
+
+RATE_HZ = 10.0
+DT = 1.0 / RATE_HZ
+
+
+# --- vehicle parameters (a mid-size BEV; all values are model assumptions) ---
+MASS_KG = 1900.0
+PACK_CAPACITY_KWH = 75.0
+PACK_NOMINAL_V = 390.0
+PACK_RESISTANCE_OHM = 0.055
+PACK_THERMAL_CAPACITY_J_PER_K = 400_000.0  # ~400 kg pack x ~1000 J/kg/K, lumped
+HEAT_TRANSFER_AMBIENT_W_PER_K = 12.0
+COOLANT_GAIN_W_PER_K = 95.0
+COOLANT_MAX_DT_C = 12.0
+PUMP_BASELINE_PCT = 18.0   # circulation while the vehicle is on
+
+# Road-load model: F = 0.5*rho*Cd*A*v^2 + Crr*m*g, then P = F*v.
+AERO_DRAG_COEFF_N_PER_MPS2 = 0.37   # 0.5 * 1.2 kg/m3 * 0.28 Cd * 2.2 m2
+ROLLING_RESISTANCE_COEFF = 0.010
+DRIVETRAIN_EFFICIENCY = 0.90
+AUX_BASE_W = 350.0                  # compute, lighting, electronics
+MAX_HVAC_W = 8000.0
+MAX_REGEN_W = 80000.0               # ~80 kW recuperation; matches VCU_regenPower_W range
+REGEN_W_PER_MS2 = 30_000.0          # ~30 kW per m/s^2 of deceleration
+
+SPEED_TARGETS = {Mode.IDLE: 0.0, Mode.CITY: 32.0, Mode.HIGHWAY: 110.0}
+
+OVERHEAT_WARN_C = 60.0
+OVERHEAT_CRITICAL_C = 75.0
+
+
+@dataclass(frozen=True)
+class Event:
+    """A ground-truth event. The analytics layer must rediscover these."""
+
+    ts_s: float
+    kind: str
+    description: str
+    severity: str = "info"
+
+
+@dataclass
+class Simulation:
+    scenario: Scenario
+    t_s: np.ndarray                 # (N,) seconds since start
+    truth: dict[str, np.ndarray]    # canonical path -> (N,) values
+    events: list[Event]
+    modes: np.ndarray               # (N,) Mode enum values, ground truth
+
+    @property
+    def n(self) -> int:
+        return self.t_s.shape[0]
+
+
+def _hold_last_moving(values: np.ndarray, speed: np.ndarray,
+                      moving_threshold: float = 5.0) -> np.ndarray:
+    """Replace stationary samples with the most recent moving sample.
+
+    Leading stationary samples (before the vehicle first moves) take the first
+    moving value, so a drive that starts parked does not report a 1300 Wh/km
+    consumption figure.
+    """
+    moving = speed > moving_threshold
+    if not moving.any():
+        return values.copy()
+
+    out = values.copy()
+    last = int(np.flatnonzero(moving)[0])
+    first_moving_value = out[last]
+    for i in range(out.shape[0]):
+        if moving[i]:
+            last = i
+        else:
+            out[i] = out[last] if i > last else first_moving_value
+    return out
+
+
+def _trailing_mean(values: np.ndarray, window: int) -> np.ndarray:
+    """Causal moving average - no look-ahead, like a real trip computer."""
+    window = max(1, min(window, values.shape[0]))
+    csum = np.cumsum(values)
+    out = csum / np.arange(1, values.shape[0] + 1)
+    out[window:] = (csum[window:] - csum[:-window]) / window
+    return out
+
+
+def _extra_heat(faults, t: float) -> float:
+    """Additional heat injected at time t by active faults (W)."""
+    heat = 0.0
+    for f in faults:
+        if f.kind is not FaultKind.BATTERY_OVERHEAT:
+            continue
+        if f.start_s <= t < f.start_s + f.duration_s:
+            # ramps in over the first 20% of the fault window
+            span = max(f.duration_s * 0.2, 1e-6)
+            frac = min(1.0, (t - f.start_s) / span)
+            heat += f.params.get("watts", 9000.0) * frac
+    return heat
+
+
+def _pump_available(faults, t: float) -> bool:
+    for f in faults:
+        if f.kind is not FaultKind.COOLANT_PUMP_FAILURE:
+            continue
+        if f.start_s <= t < f.start_s + f.duration_s:
+            return False
+    return True
+
+
+def _adas_state(faults, t: float) -> int:
+    """1 = engaged, 0 = disengaged. Disengagements are explicitly injected."""
+    base = 1
+    for f in faults:
+        if f.kind is not FaultKind.ADAS_DISENGAGEMENT:
+            continue
+        if f.start_s <= t < f.start_s + f.duration_s:
+            return 0
+    return base
+
+
+def generate(scenario: Scenario, rng_seed_offset: int = 0) -> Simulation:
+    rng = np.random.default_rng(scenario.seed + rng_seed_offset)
+
+    n = int(round(scenario.duration_s * RATE_HZ))
+    if n < 2:
+        raise ValueError("scenario too short; need at least 0.2 s")
+    t = np.arange(n) / RATE_HZ
+
+    # ---- driving mode timeline -------------------------------------------
+    mode_series = np.full(n, Mode.IDLE.value, dtype=object)
+    for start, end, mode in scenario.segment_bounds():
+        lo, hi = int(start * RATE_HZ), min(int(end * RATE_HZ), n)
+        mode_series[lo:hi] = mode.value
+
+    # ---- speed: first-order tracking toward the mode target --------------
+    target = np.array([SPEED_TARGETS[Mode(m)] for m in mode_series])
+    # CITY has periodic stops, which is what makes it city-like.
+    stop_mask = np.zeros(n, dtype=bool)
+    if np.any(mode_series == Mode.CITY.value):
+        phase = (t % 55.0)
+        stop_mask = (mode_series == Mode.CITY.value) & (phase > 42.0)
+        target = np.where(stop_mask, 0.0, target)
+
+    speed_true = np.zeros(n)
+    tau = 3.5  # s, drivetrain lag
+    for i in range(1, n):
+        brake_boost = 2.2 if stop_mask[i] else 1.0
+        speed_true[i] = (speed_true[i - 1]
+                         + (target[i] - speed_true[i - 1]) * DT / (tau / brake_boost))
+    speed_true = np.clip(speed_true, 0.0, 220.0)
+
+    # The model runs on the true speed; the *sensor* sees noise. Deriving
+    # acceleration from the noisy value would manufacture spurious regen
+    # events, which is exactly the bug this split fixes.
+    accel = np.clip(np.gradient(speed_true, DT), -12.0, 12.0)
+    speed = np.clip(speed_true + rng.normal(0.0, 0.12, n), 0.0, 220.0)
+
+    # ---- pedals ----------------------------------------------------------
+    accel_pedal = np.clip(np.maximum(accel, 0.0) * 9.0, 0.0, 100.0)
+    # The bus carries brake *application*, not travel (see signals.yaml).
+    brake_active = (accel < -1.0).astype(float)
+
+    # ---- energy: road-load model ----------------------------------------
+    speed_mps = speed_true / 3.6
+    aero_force_n = AERO_DRAG_COEFF_N_PER_MPS2 * speed_mps**2
+    rolling_force_n = ROLLING_RESISTANCE_COEFF * MASS_KG * 9.81
+    traction_w = (aero_force_n + rolling_force_n) * speed_mps
+
+    hvac_demand = np.abs(scenario.ambient_c - scenario.hvac_setpoint_c)
+    hvac_power = np.clip(180.0 + 210.0 * hvac_demand, 0.0, MAX_HVAC_W)
+    hvac_power = np.where(speed_true > 1.0, hvac_power, hvac_power * 0.55)
+
+    aux_w = hvac_power + AUX_BASE_W
+    electrical_w = traction_w / DRIVETRAIN_EFFICIENCY + aux_w
+
+    # Extra draw to accelerate; recuperation only under genuine braking.
+    transient_w = (MASS_KG * np.maximum(accel, 0.0)
+                   * np.maximum(speed_mps, 0.5)) / DRIVETRAIN_EFFICIENCY
+    recuperated_w = np.where(
+        brake_active > 0,
+        np.clip(REGEN_W_PER_MS2 * np.maximum(-accel, 0.0), 0.0, MAX_REGEN_W),
+        0.0,
+    )
+
+    pack_w = electrical_w + np.clip(transient_w, 0.0, 220_000.0) - recuperated_w
+    pack_w = np.where(speed_true < 0.5, aux_w, pack_w)   # parked: only aux
+    pack_w = np.clip(pack_w, -MAX_REGEN_W, 400_000.0)
+
+    # Instantaneous consumption, as a VCU would report it. Dividing aux draw by
+    # a near-zero speed when parked produces absurd Wh/km, so hold the last
+    # moving value across stops instead of inventing a spike.
+    energy_per_km = electrical_w / np.maximum(speed_true, 5.0)
+    energy_per_km = _hold_last_moving(energy_per_km, speed_true)
+    energy_per_km = _trailing_mean(energy_per_km, int(30 * RATE_HZ))
+    energy_per_km += rng.normal(0.0, 1.2, n)
+    energy_per_km = np.clip(energy_per_km, 0.0, 1999.0)
+
+    regen_w = np.clip(recuperated_w, 0.0, MAX_REGEN_W)
+
+    # ---- pack: voltage, current, SOC (coulomb counting) ------------------
+    current = pack_w / PACK_NOMINAL_V
+    current = np.clip(current, -500.0, 500.0)
+    pack_voltage = PACK_NOMINAL_V - current * PACK_RESISTANCE_OHM
+
+    soc = np.zeros(n)
+    soc[0] = scenario.initial_soc
+    coulomb_per_tick = current / 3600.0 / RATE_HZ  # Ah per tick
+    pack_ah = PACK_CAPACITY_KWH * 1000.0 / PACK_NOMINAL_V
+    for i in range(1, n):
+        soc[i] = soc[i - 1] - 100.0 * coulomb_per_tick[i - 1] / pack_ah
+    soc = np.clip(soc, 0.0, 100.0)
+
+    # ---- pack thermal ----------------------------------------------------
+    temp = np.zeros(n)
+    temp[0] = max(scenario.ambient_c + 4.0, 18.0)
+    coolant_in = np.zeros(n)
+    coolant_in[0] = scenario.ambient_c
+    pump_pct = np.zeros(n)
+    coolant_dt = np.zeros(n)
+
+    for i in range(1, n):
+        t_s = t[i]
+        pump_ok = _pump_available(scenario.faults, t_s)
+        q_joule = (current[i - 1] ** 2) * PACK_RESISTANCE_OHM
+        q_extra = _extra_heat(scenario.faults, t_s)
+        q_amb = HEAT_TRANSFER_AMBIENT_W_PER_K * (scenario.ambient_c - temp[i - 1])
+
+        # Baseline circulation whenever the vehicle is live, rising with pack
+        # temperature. A failed pump drops this to zero, which is a clean,
+        # observable predecessor to the thermal excursion - the signature the
+        # analytics layer is supposed to find for Q4.
+        thermal_demand = float(np.clip((temp[i - 1] - 28.0) / 30.0 * 100.0, 0.0, 100.0))
+        live = 1.0 if speed[i - 1] > 1.0 else 0.0
+        duty = 0.0 if not pump_ok else max(PUMP_BASELINE_PCT * live, thermal_demand)
+        pump_pct[i] = duty
+
+        coolant_in[i] = scenario.ambient_c + 0.55 * max(temp[i - 1] - scenario.ambient_c, 0.0)
+        coolant_dt[i] = float(np.clip(
+            (temp[i - 1] - coolant_in[i]) * 0.4, 0.0, COOLANT_MAX_DT_C))
+        q_cool = COOLANT_GAIN_W_PER_K * (duty / 100.0) * coolant_dt[i]
+
+        dT = (q_joule + q_extra + q_amb + 0.0 - q_cool) * DT / PACK_THERMAL_CAPACITY_J_PER_K
+        temp[i] = temp[i - 1] + dT
+
+    temp += rng.normal(0.0, 0.02, n)
+    cell_temp_max = np.clip(temp, -40.0, 124.0)
+    cell_temp_min = np.clip(temp - (1.2 + 0.8 * np.abs(current) / 200.0), -40.0, 124.0)
+    overheat = (cell_temp_max >= OVERHEAT_WARN_C).astype(float)
+
+    # ---- derivative signals ---------------------------------------------
+    range_km = np.clip(soc / 100.0 * PACK_CAPACITY_KWH * 1000.0
+                       / np.maximum(energy_per_km, 60.0), 0.0, 1000.0)
+
+    adas = np.array([_adas_state(scenario.faults, x) for x in t], dtype=float)
+
+    # sensor drift: a plausible slow bias, the classic "why is my range wrong"
+    for f in scenario.faults_of(FaultKind.SENSOR_DRIFT):
+        lo, hi = int(f.start_s * RATE_HZ), min(int((f.start_s + f.duration_s) * RATE_HZ), n)
+        drift = f.params.get("per_second", 0.02) * (t[lo:hi] - f.start_s)
+        if f.params.get("target", 1.0) > 0:
+            energy_per_km[lo:hi] = energy_per_km[lo:hi] + drift
+
+    truth = {
+        "vehicle.speed": speed,
+        "vehicle.accel_long": accel,
+        "chassis.steer_angle": np.clip(rng.normal(0.0, 3.0, n), -540, 540),
+        "chassis.brake_active": brake_active,
+        "powertrain.accel_pedal": accel_pedal,
+        "powertrain.motor_torque": np.clip(MASS_KG * accel * 0.12, -500, 500),
+        "powertrain.motor_rpm": np.clip(speed * 88.0, 0, 20000),
+        "powertrain.gear": np.full(n, 4.0),
+        "adas.state": adas,
+        "adas.ldw_active": np.zeros(n),
+        "adas.aeb_active": np.zeros(n),
+        "thermal.ambient": np.full(n, scenario.ambient_c),
+        "battery.soc": soc,
+        "battery.pack_voltage": np.clip(pack_voltage, 0, 800),
+        "battery.pack_current": current,
+        "battery.cell_temp_max": cell_temp_max,
+        "battery.cell_temp_min": cell_temp_min,
+        "battery.cell_imbalance": np.clip(8.0 + rng.normal(0, 1.5, n), 0, 16383),
+        "battery.overheat_warning": overheat,
+        "thermal.coolant_inlet": np.clip(coolant_in, -40, 125),
+        "thermal.coolant_pump": pump_pct,
+        "energy.per_km": energy_per_km,
+        "energy.range_estimate": range_km,
+        "energy.regen_power": regen_w,
+        "hvac.power": hvac_power,
+        "hvac.setpoint": np.full(n, scenario.hvac_setpoint_c),
+    }
+
+    return Simulation(
+        scenario=scenario, t_s=t, truth=truth,
+        events=_ground_truth_events(scenario, cell_temp_max, adas, t),
+        modes=mode_series,
+    )
+
+
+def _ground_truth_events(scenario, cell_temp_max, adas, t) -> list[Event]:
+    """Events the analytics layer is expected to rediscover."""
+    events: list[Event] = []
+
+    warn_idx = np.flatnonzero(cell_temp_max >= OVERHEAT_WARN_C)
+    if warn_idx.size:
+        events.append(Event(
+            ts_s=float(t[warn_idx[0]]), kind="battery.overheat_warning",
+            description=f"pack reached the {OVERHEAT_WARN_C:.0f} C warning threshold",
+            severity="warning"))
+
+    crit_idx = np.flatnonzero(cell_temp_max >= OVERHEAT_CRITICAL_C)
+    if crit_idx.size:
+        events.append(Event(
+            ts_s=float(t[crit_idx[0]]), kind="battery.overheat_critical",
+            description=f"pack exceeded {OVERHEAT_CRITICAL_C:.0f} C", severity="critical"))
+
+    # ADAS engagement falling edge == disengagement
+    drops = np.flatnonzero((adas[:-1] > 0) & (adas[1:] == 0))
+    for i in drops:
+        events.append(Event(
+            ts_s=float(t[i + 1]), kind="adas.disengagement",
+            description="ADAS disengaged", severity="info"))
+
+    for f in scenario.faults:
+        events.append(Event(
+            ts_s=f.start_s, kind=f"fault.{f.kind.value}",
+            description=f"{f.kind.value} injected", severity="info"))
+
+    return sorted(events, key=lambda e: e.ts_s)
diff --git a/sim/program.py b/sim/program.py
new file mode 100644
index 0000000..cf6cf4c
--- /dev/null
+++ b/sim/program.py
@@ -0,0 +1,123 @@
+"""Multi-day driving program.
+
+A single scenario is ~30 minutes; the questions in the brief span *weeks*
+("why has my range reduced over the last two weeks", "show all ADAS
+disengagements from yesterday"). So the simulator composes a program of day-long
+drives on a fixed calendar, and the store keeps them as real timestamps.
+
+The calendar is explicit rather than "now minus N days" so that every query
+result is reproducible and every date in the demo is stable.
+
+What the program is built to contain
+------------------------------------
+* A **cold snap** between day 9 and day 10 (12 C -> -4 C). This is the honest
+  explanation for the range reduction, and it gives Q2 a single unambiguous
+  largest drop to find.
+* A **coolant pump failure and thermal excursion** on day 9, so Q4 has a real
+  precursor sequence in the data.
+* **ADAS disengagements on the final day**, so "from yesterday" returns
+  something without the query layer needing special cases.
+
+None of these are hard-coded into the answers: the analytics layer has to
+rediscover them from `/sample` and `/event` like any other data.
+"""
+
+from __future__ import annotations
+
+import datetime as dt
+from collections.abc import Iterator
+from dataclasses import dataclass
+
+from sim.generator import Simulation, generate
+from sim.scenario import Fault, FaultKind, Mode, Scenario, Segment
+
+# Day 0 of the program. Chosen to be a Monday so week-over-week grouping is
+# meaningful without ISO-week gymnastics.
+PROGRAM_START = dt.datetime(2026, 3, 2, tzinfo=dt.UTC)   # Monday
+PROGRAM_DAYS = 14
+
+# Ambient by day index. A 16 C step between day 9 and day 10 is the cold snap.
+AMBIENT_BY_DAY = [18, 17, 16, 18, 15, 16, 14, 15, 13, 12, -4, -5, -6, -6]
+
+COLD_SNAP_DAY = 10
+OVERHEAT_DAY = 9
+ADAS_DAY = PROGRAM_DAYS - 1          # "yesterday" relative to PROGRAM_END
+
+# Drives start at 08:00 and 17:30 local, which keeps a clean day boundary.
+MORNING_DRIVE_HOUR = 8
+EVENING_DRIVE_HOUR = 17
+
+
+@dataclass(frozen=True)
+class DayDrive:
+    day_index: int
+    label: str
+    start_epoch_s: float
+    scenario: Scenario
+
+
+def _drive_times(day: dt.datetime) -> list[tuple[str, dt.datetime]]:
+    out = [("morning", day.replace(hour=MORNING_DRIVE_HOUR, minute=0))]
+    if day.weekday() < 5:
+        out.append(("evening", day.replace(hour=EVENING_DRIVE_HOUR, minute=30)))
+    return out
+
+
+def _segments_for(day: dt.datetime, label: str, day_index: int) -> list[Segment]:
+    weekend = day.weekday() >= 5
+    if weekend:
+        return [Segment(Mode.CITY, 600), Segment(Mode.CITY, 600)]
+    if label == "morning":
+        return [Segment(Mode.CITY, 300), Segment(Mode.HIGHWAY, 600), Segment(Mode.CITY, 180)]
+    if day_index == OVERHEAT_DAY:
+        # A longer motorway stint, so the thermal excursion has time to develop
+        # inside the drive instead of being cut off by the car being switched off.
+        return [Segment(Mode.CITY, 300), Segment(Mode.HIGHWAY, 900), Segment(Mode.CITY, 420)]
+    return [Segment(Mode.CITY, 420), Segment(Mode.HIGHWAY, 480), Segment(Mode.CITY, 120)]
+
+
+def _faults_for(day_index: int, label: str) -> list[Fault]:
+    faults: list[Fault] = []
+    if day_index == OVERHEAT_DAY and label == "evening":
+        # The heat source must stay active for the whole drive, or the pack
+        # plateaus below the warning threshold and the scenario has no warning
+        # for the analytics layer to explain.
+        faults.append(Fault(FaultKind.COOLANT_PUMP_FAILURE, start_s=300, duration_s=1300))
+        faults.append(Fault(FaultKind.BATTERY_OVERHEAT, start_s=120, duration_s=1600,
+                            params={"watts": 18000}))
+    if day_index == ADAS_DAY and label == "morning":
+        for start in (200.0, 430.0, 610.0):
+            faults.append(Fault(FaultKind.ADAS_DISENGAGEMENT, start_s=start, duration_s=4))
+    if day_index == ADAS_DAY and label == "evening":
+        faults.append(Fault(FaultKind.ADAS_DISENGAGEMENT, start_s=280, duration_s=4))
+    return faults
+
+
+def program_days(days: int = PROGRAM_DAYS) -> Iterator[DayDrive]:
+    """Yield every drive in the program, in chronological order."""
+    for day_index in range(days):
+        day = PROGRAM_START + dt.timedelta(days=day_index)
+        ambient = AMBIENT_BY_DAY[day_index % len(AMBIENT_BY_DAY)]
+        for label, when in _drive_times(day):
+            start_epoch_s = when.timestamp()
+            scenario = Scenario(
+                name=f"day{day_index:02d}-{label}",
+                seed=1000 + day_index * 7 + (0 if label == "morning" else 3),
+                ambient_c=float(ambient),
+                initial_soc=float(80 - (day_index % 5) * 4),
+                hvac_setpoint_c=22.0,
+                segments=tuple(_segments_for(day, label, day_index)),
+                faults=tuple(_faults_for(day_index, label)),
+            )
+            yield DayDrive(day_index=day_index, label=label,
+                           start_epoch_s=start_epoch_s, scenario=scenario)
+
+
+def program_end_epoch_s(days: int = PROGRAM_DAYS) -> float:
+    """Start of the day after the last program day - i.e. "now" for the demo."""
+    return (PROGRAM_START + dt.timedelta(days=days)).timestamp()
+
+
+def generate_program(days: int = PROGRAM_DAYS) -> Iterator[tuple[DayDrive, Simulation]]:
+    for drive in program_days(days):
+        yield drive, generate(drive.scenario)
diff --git a/sim/scenario.py b/sim/scenario.py
new file mode 100644
index 0000000..1b72fab
--- /dev/null
+++ b/sim/scenario.py
@@ -0,0 +1,144 @@
+"""Scenario DSL.
+
+"Why did the battery overheat?" is not answerable from any public dataset, and no
+CARLA scenario contains it either - you would still be scripting it. So we script
+it properly: a small, typed, seeded, version-controlled description of a drive
+and the faults injected into it.
+
+That buys three things a heavyweight simulator does not:
+
+1. **Determinism.** Same seed, same bytes. A demo that works twice.
+2. **Ground truth.** We know the answer to "what happened before the warning?"
+   because we put it there. Evaluation becomes possible at all.
+3. **Diffability.** Scenarios live in YAML and show up in code review.
+
+The base vehicle dynamics are modelled from first principles (see
+``sim/generator.py``), not recorded. That limitation is stated in
+``vehiclegpt/dbc/README.md`` and in the submission.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from enum import StrEnum
+from pathlib import Path
+
+import yaml
+
+
+class Mode(StrEnum):
+    """Driving regime. Drives the speed profile and the energy model."""
+
+    IDLE = "idle"
+    CITY = "city"
+    HIGHWAY = "highway"
+
+
+class FaultKind(StrEnum):
+    BATTERY_OVERHEAT = "battery_overheat"
+    ADAS_DISENGAGEMENT = "adas_disengagement"
+    COOLANT_PUMP_FAILURE = "coolant_pump_failure"
+    SENSOR_DRIFT = "sensor_drift"
+
+
+@dataclass(frozen=True)
+class Segment:
+    mode: Mode
+    duration_s: float
+
+    def __post_init__(self) -> None:
+        if self.duration_s <= 0:
+            raise ValueError(f"segment duration must be > 0, got {self.duration_s}")
+
+
+@dataclass(frozen=True)
+class Fault:
+    kind: FaultKind
+    start_s: float
+    duration_s: float
+    # Free-form tuning knobs, validated per-kind in the generator.
+    params: dict[str, float] = field(default_factory=dict)
+
+    def __post_init__(self) -> None:
+        if self.start_s < 0:
+            raise ValueError("fault start_s must be >= 0")
+        if self.duration_s <= 0:
+            raise ValueError("fault duration_s must be > 0")
+
+
+@dataclass(frozen=True)
+class Scenario:
+    name: str
+    seed: int
+    ambient_c: float
+    initial_soc: float
+    segments: tuple[Segment, ...]
+    faults: tuple[Fault, ...] = ()
+    hvac_setpoint_c: float = 22.0
+
+    def __post_init__(self) -> None:
+        if not self.segments:
+            raise ValueError("scenario needs at least one segment")
+        if not 0 <= self.initial_soc <= 100:
+            raise ValueError("initial_soc must be within [0, 100]")
+
+    @property
+    def duration_s(self) -> float:
+        return sum(s.duration_s for s in self.segments)
+
+    def segment_bounds(self) -> list[tuple[float, float, Mode]]:
+        """(start_s, end_s, mode) for each segment, in order."""
+        out, cursor = [], 0.0
+        for seg in self.segments:
+            out.append((cursor, cursor + seg.duration_s, seg.mode))
+            cursor += seg.duration_s
+        return out
+
+    def faults_of(self, kind: FaultKind) -> list[Fault]:
+        return [f for f in self.faults if f.kind is kind]
+
+
+# ---------------------------------------------------------------------------
+# YAML round-trip, so scenarios are data rather than code
+# ---------------------------------------------------------------------------
+
+def scenario_from_dict(d: dict) -> Scenario:
+    return Scenario(
+        name=d["name"],
+        seed=int(d["seed"]),
+        ambient_c=float(d["ambient_c"]),
+        initial_soc=float(d["initial_soc"]),
+        hvac_setpoint_c=float(d.get("hvac_setpoint_c", 22.0)),
+        segments=tuple(
+            Segment(mode=Mode(s["mode"]), duration_s=float(s["duration_s"]))
+            for s in d["segments"]
+        ),
+        faults=tuple(
+            Fault(
+                kind=FaultKind(f["kind"]),
+                start_s=float(f["start_s"]),
+                duration_s=float(f["duration_s"]),
+                params=dict(f.get("params", {})),
+            )
+            for f in d.get("faults", [])
+        ),
+    )
+
+
+def load_scenario(path: str | Path) -> Scenario:
+    return scenario_from_dict(yaml.safe_load(Path(path).read_text(encoding="utf-8")))
+
+
+def scenario_to_dict(s: Scenario) -> dict:
+    return {
+        "name": s.name,
+        "seed": s.seed,
+        "ambient_c": s.ambient_c,
+        "initial_soc": s.initial_soc,
+        "hvac_setpoint_c": s.hvac_setpoint_c,
+        "segments": [{"mode": x.mode.value, "duration_s": x.duration_s}
+                     for x in s.segments],
+        "faults": [{"kind": f.kind.value, "start_s": f.start_s,
+                    "duration_s": f.duration_s, "params": f.params}
+                   for f in s.faults],
+    }
